new Promise((resolve, reject) => {
    const idleDuration = {{.IdleDuration}};
    const timeout = {{.Timeout}};
    const startTime = Date.now();

    if (!window.__pikoNetworkIdle) {
        const state = { pending: 0, lastRequestTime: Date.now() };
        const originalFetch = window.fetch;
        window.__pikoNetworkIdle = state;
        window.fetch = async function(...args) {
            state.pending++;
            state.lastRequestTime = Date.now();
            try {
                return await originalFetch.apply(this, args);
            } finally {
                state.pending--;
                state.lastRequestTime = Date.now();
            }
        };
    }
    const state = window.__pikoNetworkIdle;

    const check = () => {
        const timeSinceLastRequest = Date.now() - state.lastRequestTime;
        if (state.pending === 0 && timeSinceLastRequest >= idleDuration) {
            resolve(true);
            return;
        }
        if (Date.now() - startTime >= timeout) {
            reject(new Error('timeout waiting for network idle'));
            return;
        }
        setTimeout(check, Math.min(100, idleDuration || 100));
    };

    check();
})
