(() => {
    const host = document.querySelector({{jsStr .Host}});
    if (!host || !host.shadowRoot) return { found: false, clickable: false };
    const el = host.shadowRoot.querySelector({{jsStr .Shadow}});
    if (!el) return { found: false, clickable: false };
    const rect = el.getBoundingClientRect();
    const x = rect.x + rect.width / 2;
    const y = rect.y + rect.height / 2;
    let hit = document.elementFromPoint(x, y);
    let guard = 0;
    while (hit && hit !== el && hit.shadowRoot && guard < 64) {
        const inner = hit.shadowRoot.elementFromPoint(x, y);
        if (!inner || inner === hit) break;
        hit = inner;
        guard++;
    }
    return {
        x: x,
        y: y,
        found: true,
        clickable: (hit === el || el.contains(hit))
    };
})()
