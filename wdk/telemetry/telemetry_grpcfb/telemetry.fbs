namespace telemetryfb;

table KV {
  key:string;
  value:string;
}

table AnalyticsEvent {
  kind:string;
  timestamp_ms:long;
  hostname:string;
  url:string;
  path:string;
  matched_pattern:string;
  method:string;
  status_code:int;
  duration_ms:long;
  referrer:string;
  user_agent:string;
  client_ip:string;
  locale:string;
  user_id:string;
  action_name:string;
  event_name:string;
  revenue_amount:string;
  revenue_currency:string;
  properties:[KV];
}

table WatchdogEvent {
  event_type:string;
  priority:int;
  message:string;
  timestamp_ms:long;
  fields:[KV];
}

table LogLine {
  timestamp_ms:long;
  level:string;
  logger:string;
  message:string;
  trace_id:string;
  span_id:string;
  fields:[KV];
}

table Span {
  trace_id:string;
  span_id:string;
  parent_id:string;
  service:string;
  operation:string;
  kind:string;
  start_ms:long;
  duration_us:long;
  status:string;
  attributes:[KV];
}

table MetricPoint {
  name:string;
  kind:string;
  timestamp_ms:long;
  value:double;
  unit:string;
  labels:[KV];
}

table ErrorEvent {
  fingerprint:string;
  type:string;
  value:string;
  culprit:string;
  level:string;
  timestamp_ms:long;
  release:string;
  environment:string;
  user_id:string;
  handled:bool;
  stack_json:string;
  breadcrumbs_json:string;
  context:[KV];
}

table ProfileMeta {
  profile_type:string;
  timestamp_ms:long;
  reason:string;
  size_bytes:long;
  content_encoding:string;
  blob_ref:string;
  fields:[KV];
  blob:[ubyte];
}

table WorkerEvent {
  event_id:string;
  run_id:string;
  parent_id:string;
  category:string;
  queue:string;
  worker:string;
  status:string;
  attempt:int;
  ts_ms:long;
  duration_ms:long;
  error:string;
  attrs:[KV];
}

table QueryStat {
  connection:string;
  statement:string;
  operation:string;
  status:string;
  error:string;
  ts_ms:long;
  duration_ms:long;
  rows:long;
  calls:long;
  attrs:[KV];
}

table EmailEvent {
  message_id:string;
  provider:string;
  template:string;
  recipient:string;
  subject:string;
  event:string;
  status:string;
  error:string;
  ts_ms:long;
  attrs:[KV];
}

table TelemetryBatch {
  site_id:string (id: 0);
  api_key:string (id: 1);
  source:string (id: 2);
  sent_at_ms:long (id: 3);
  seq:long (id: 4);
  analytics:[AnalyticsEvent] (id: 5);
  watchdog:[WatchdogEvent] (id: 6);
  logs:[LogLine] (id: 7);
  spans:[Span] (id: 8);
  metrics:[MetricPoint] (id: 9);
  errors:[ErrorEvent] (id: 10);
  profiles:[ProfileMeta] (id: 11);
  workers:[WorkerEvent] (id: 12);
  query_stats:[QueryStat] (id: 13);
  email_events:[EmailEvent] (id: 14);
  instance_id:string (id: 15);
  hostname:string (id: 16);
  service_name:string (id: 17);
  service_version:string (id: 18);
  environment:string (id: 19);
  region:string (id: 20);
  started_at_ms:long (id: 21);
  pid:int (id: 22);
}

table IngestAck {
  ok:bool;
  frames:long;
  events:long;
  message:string;
}

root_type TelemetryBatch;
