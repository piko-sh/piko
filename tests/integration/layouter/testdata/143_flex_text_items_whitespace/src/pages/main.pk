<style>
.row { display: flex; gap: 8px; width: 500px; font-size: 14px; }
.link { display: inline-flex; align-items: center; gap: 4px; }
.icon { display: inline-block; width: 12px; height: 12px; background: #333; }
.chip { display: inline-flex; padding: 2px 6px; border: 1px solid #999; }
.after { width: 100px; height: 20px; }
</style>

<template>
  <div data-layout-id="row" class="row">
    <a data-layout-id="link" class="link">
      <span data-layout-id="icon" class="icon"></span>
      {{ state.Email }}
    </a>
    <span data-layout-id="chip-a" class="chip">
      {{ state.ChipA }}
    </span>
    <span data-layout-id="chip-b" class="chip">
      {{ state.ChipB }}
    </span>
  </div>
  <div data-layout-id="after" class="after"></div>
</template>

<script type="application/x-go">
package main

import "piko.sh/piko"

type Response struct {
    Email string
    ChipA string
    ChipB string
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    return Response{
        Email: "someone@example.com",
        ChipA: "Go",
        ChipB: "Data Platforms (Kafka, Spark)",
    }, piko.Metadata{Title: "Flex Text Items Whitespace Test"}, nil
}
</script>
