<template name="computed-keys-component">
    <div>
        <p class="literal">{{ literalKeys() }}</p>
        <p class="methods">{{ methodKeys() }}</p>
        <p class="proto">{{ protoKey() }}</p>
        <p class="patterns">{{ patternValues() }}</p>
        <p class="state">{{ stateKey() }}</p>
        <p class="rest">{{ restKeys() }}</p>
    </div>
</template>

<script lang="ts">
    const state = {
        key: "fromState"
    };

    function literalKeys(): string {
        const id = 'abc';
        const n = 7;
        return [
            Object.keys({ [id]: true }),
            Object.keys({ [n]: 1 }),
            Object.keys({ ['pre_' + id]: 1 }),
        ].join('|');
    }

    function methodKeys(): string {
        const id = 'abc';
        const withMethod = { [id]() { return 1; } };
        const withGetter = { get [id]() { return 1; } };
        return Object.keys(withMethod) + '|' + Object.keys(withGetter);
    }

    function protoKey(): string {
        const o: any = { ['__proto__']: { inherited: 'yes' } };
        return Object.keys(o).join(',') + '|' + (o.inherited === undefined ? 'own' : 'inherited');
    }

    function patternValues(): string {
        const id = 'abc';
        const suffix = 'bc';
        const src = { abc: 'value-of-abc', id: 'value-of-id', w: 'value-of-w' };
        const { [id]: i } = src;
        const { ['a' + suffix]: w } = src;
        let x = '';
        ({ [id]: x } = src);
        const { 0: first } = ['zero'] as any;
        return [i, w, x, first].join('|');
    }

    function restKeys(): string {
        const { a, ...others } = { a: 1, b: 2, c: 3 } as any;
        let tail: any;
        ({ a: tail, ...tail } = { a: 1, d: 4 } as any);
        return a + '|' + Object.keys(others).join(',') + '|' + Object.keys(tail).join(',');
    }

    function stateKey(): string {
        return Object.keys({ [state.key]: 1 }).join(',');
    }
</script>
