<template name="import-boundary-component">
    <div>
        <p class="first">{{ firstText() }}</p>
        <p class="second">{{ secondText() }}</p>
        <p class="third">{{ thirdText() }}</p>
    </div>
</template>

<script lang="ts">
    // The second import's keyword starts exactly 203 bytes before its module path,
    // which once straddled the hoister's 200-byte search window.
    import { alpha, beta } from '@/lib/first';
    import { one, fourteen, pad as p___________________________________________________________________________________________________________________________________________________________________ } from '@/lib/second';
    import { importedName } from '@/lib/third';

    function firstText(): string {
        return alpha + '-' + beta;
    }

    function secondText(): string {
        return one + '-' + fourteen + '-' + p___________________________________________________________________________________________________________________________________________________________________;
    }

    function thirdText(): string {
        return importedName;
    }
</script>
