<template name="rest-holes-component">
    <div>
        <p class="array-rest">{{ arrayRest() }}</p>
        <p class="holes">{{ holes() }}</p>
        <p class="rest-params">{{ restParams() }}</p>
        <p class="object-rest-param">{{ objectRestParam() }}</p>
        <p class="spread">{{ spread() }}</p>
        <p class="template-escape">{{ templateEscape() }}</p>
        <p class="enum">{{ enumMember() }}</p>
        <p class="pattern">{{ pattern() }}</p>
    </div>
</template>

<script lang="ts">
    const digits = /\d+/;

    const state = {
        label: "rest"
    };

    enum Size { Small, Large }

    function arrayRest(): string {
        const [first, ...others] = [1, 2, 3];
        const [[head, ...tail]] = [[4, 5, 6]];
        return first + ':' + others.join(',') + '|' + head + ':' + tail.join(',');
    }

    function holes(): string {
        const [, second, , fourth] = [1, 2, 3, 4];
        const [, ...afterFirst] = [7, 8, 9];
        return second + ',' + fourth + '|' + afterFirst.join(',');
    }

    function restParams(): string {
        function count(...values: number[]): number {
            return values.length;
        }
        const sum = (first: number, ...more: number[]) => more.reduce((total, value) => total + value, first);
        return count(1, 2, 3) + '|' + sum(1, 2, 3);
    }

    function objectRestParam(): string {
        const describe = ({ a, ...others }: any) => a + ':' + Object.keys(others).join(',');
        return describe({ a: 1, b: 2, c: 3 });
    }

    function spread(): string {
        const middle = [2, 3];
        const all = [1, ...middle, 4];
        return all.join(',') + '|' + Math.max(...all);
    }

    function templateEscape(): string {
        const name = 'x';
        return `${name}\`${name}\${name}`;
    }

    function enumMember(): string {
        return String(Size.Large);
    }

    function pattern(): string {
        return String(digits.test(state.label + '42'));
    }
</script>
