<template>
  <piko:partial is="layout">
    <h1>Other Page</h1>
    <button type="button" id="other-button" p-ref="countButton">Count</button>
    <p>Clicks on this visit: <span id="other-clicks">0</span></p>
    <p>Connected in this document: <span id="other-connected">0</span></p>
  </piko:partial>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Other Page",
    }, nil
}
</script>

<script lang="ts">
let clicks = 0;

function connections(): Record<string, number> {
    const host = window as unknown as { __connections?: Record<string, number> };
    host.__connections ??= {};
    return host.__connections;
}

function onCountClick(): void {
    clicks++;
    const output = document.getElementById('other-clicks');
    if (output) {
        output.textContent = String(clicks);
    }
}

pk.onConnected(() => {
    const counts = connections();
    counts['other'] = (counts['other'] ?? 0) + 1;
    const output = document.getElementById('other-connected');
    if (output) {
        output.textContent = String(counts['other']);
    }
    const button = pk.refs.countButton;
    button?.addEventListener('click', onCountClick);
    pk.onCleanup(() => {
        button?.removeEventListener('click', onCountClick);
    });
});
</script>
