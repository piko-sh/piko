<template>
  <piko:partial is="layout">
    <h1>Third Page</h1>
    <p>Third connected: <span id="third-connected" p-ref="thirdConnected">0</span></p>
  </piko:partial>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Third Page",
    }, nil
}
</script>

<script lang="ts">
const host = window as unknown as { __lifecycle?: { thirdConnected?: number; thirdDisconnected?: number } };
host.__lifecycle ??= {};
const lifecycleCounters = host.__lifecycle;

pk.onConnected(() => {
    lifecycleCounters.thirdConnected = (lifecycleCounters.thirdConnected ?? 0) + 1;
    const output = pk.refs.thirdConnected;
    if (output) {
        output.textContent = String(lifecycleCounters.thirdConnected);
    }
});

pk.onDisconnected(() => {
    lifecycleCounters.thirdDisconnected = (lifecycleCounters.thirdDisconnected ?? 0) + 1;
});
</script>
