<template>
  <piko:partial is="layout">
    <h1>Other Page</h1>
    <p>Other connected: <span id="other-connected">0</span></p>
    <p>Main disconnected so far: <span id="seen-main-disconnected">0</span></p>
  </piko:partial>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Other Page",
    }, nil
}
</script>

<script lang="ts">
interface LifecycleCounters {
    mainDisconnected: number;
    otherConnected: number;
    otherDisconnected: number;
}

function counters(): LifecycleCounters {
    const host = window as unknown as { __lifecycle?: Partial<LifecycleCounters> };
    host.__lifecycle ??= {};
    const lifecycle = host.__lifecycle;
    lifecycle.mainDisconnected ??= 0;
    lifecycle.otherConnected ??= 0;
    lifecycle.otherDisconnected ??= 0;
    return lifecycle as LifecycleCounters;
}

pk.onConnected(() => {
    const lifecycleCounters = counters();
    lifecycleCounters.otherConnected++;
    const connected = document.getElementById('other-connected');
    if (connected) {
        connected.textContent = String(lifecycleCounters.otherConnected);
    }
    const seen = document.getElementById('seen-main-disconnected');
    if (seen) {
        seen.textContent = String(lifecycleCounters.mainDisconnected);
    }
});

pk.onDisconnected(() => {
    counters().otherDisconnected++;
});
</script>
