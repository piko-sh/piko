<template>
  <div>
    <div style="width: 555px; padding: 20px 20px 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #1f2937;">
      <h2 style="font-size: 13px; font-weight: 600; color: #b91c1c; margin-bottom: 6px;">F · direct p-html in the PDF template (no partial)</h2>
      <p p-html="state.DirectRich"></p>
    </div>
    <piko:partial is="contentBlock"></piko:partial>
  </div>
</template>

<script type="application/x-go">
package main

import (
	"piko.sh/piko"

	contentBlock "testmodule/partials/content-block.pk"
)

type Response struct {
	DirectRich string
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
	return Response{
		DirectRich: `Direct <b>bold</b> p-html in the PDF template itself — no partial involved.`,
	}, piko.Metadata{Title: "Template directive matrix"}, nil
}
</script>
