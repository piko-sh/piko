fmt := import("fmt")
os := import("os")
times := import("times")

INPUT_COUNT := 100000
PIPELINE_LCG_MASK := 0xFFFFFFFF
PIPELINE_SEED := 0xCAFEBABE
FOLD_ROTATE_SHIFT := 5

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

make_multiply := func(factor) {
	return func(value) {
		return (value * factor) & PIPELINE_LCG_MASK
	}
}

make_divisor_filter := func(divisor) {
	return func(value) {
		return value % divisor != 0
	}
}

make_add := func(offset) {
	return func(value) {
		return (value + offset) & PIPELINE_LCG_MASK
	}
}

make_threshold_filter := func(threshold) {
	return func(value) {
		return value > threshold
	}
}

make_fold := func(shift) {
	return func(acc, value) {
		rotated := ((value << shift) | (value >> (32 - shift))) & PIPELINE_LCG_MASK
		return (acc ^ rotated) & PIPELINE_LCG_MASK
	}
}

apply_map := func(input, fn) {
	output := []
	for i := 0; i < len(input); i++ {
		output = append(output, fn(input[i]))
	}
	return output
}

apply_filter := func(input, predicate) {
	output := []
	for i := 0; i < len(input); i++ {
		current := input[i]
		if predicate(current) {
			output = append(output, current)
		}
	}
	return output
}

apply_reduce := func(input, initial, fn) {
	accumulator := initial
	for i := 0; i < len(input); i++ {
		accumulator = fn(accumulator, input[i])
	}
	return accumulator
}

do_closures_pipeline := func() {
	state := PIPELINE_SEED
	input := []
	for index := 0; index < INPUT_COUNT; index++ {
		state = (state * 1664525 + 1013904223) & PIPELINE_LCG_MASK
		input = append(input, state)
	}

	multiplier := make_multiply(3)
	divisor_filter := make_divisor_filter(7)
	adder := make_add(1234)
	threshold_filter := make_threshold_filter(1000)
	folder := make_fold(FOLD_ROTATE_SHIFT)

	stage1 := apply_map(input, multiplier)
	stage2 := apply_filter(stage1, divisor_filter)
	stage3 := apply_map(stage2, adder)
	stage4 := apply_filter(stage3, threshold_filter)
	result := apply_reduce(stage4, 0, folder)
	return int_to_decimal(result)
}

run := func() {
	return do_closures_pipeline()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_closures_pipeline()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
