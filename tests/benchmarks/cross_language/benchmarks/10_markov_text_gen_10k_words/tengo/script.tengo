fmt := import("fmt")
os := import("os")
times := import("times")

TRAINING_TOKENS := 50000
OUTPUT_TOKENS := 10000
RESULT_MASK := 0xFFFFFFFF
LCG_MASK := 0xFFFFFFFF
VOCABULARY_MASK := 0x3F

VOCABULARY := [
	"the", "of", "and", "to", "in", "a", "is", "it", "you", "that",
	"he", "was", "for", "on", "are", "with", "as", "I", "his", "they",
	"be", "at", "one", "have", "this", "from", "or", "had", "by", "hot",
	"word", "but", "what", "some", "we", "can", "out", "other", "were", "all",
	"there", "when", "up", "use", "your", "how", "said", "an", "each", "she",
	"which", "do", "their", "time", "if", "will", "way", "about", "many", "then",
	"them", "write", "would", "like"]

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

generate_corpus := func(token_count) {
	state := 31415927
	output := []
	for token_index := 0; token_index < token_count; token_index++ {
		state = (state * 1664525 + 1013904223) & LCG_MASK
		output = append(output, VOCABULARY[state & VOCABULARY_MASK])
	}
	return output
}

build_bigram_table := func(corpus) {
	transitions := {}
	for token_index := 0; token_index < len(corpus) - 1; token_index++ {
		previous := corpus[token_index]
		next := corpus[token_index + 1]
		existing := transitions[previous]
		if is_undefined(existing) {
			transitions[previous] = [next]
		} else {
			transitions[previous] = append(existing, next)
		}
	}
	return transitions
}

do_markov := func() {
	corpus := generate_corpus(TRAINING_TOKENS)
	transitions := build_bigram_table(corpus)
	state := 42100100
	fold_hash := 0
	previous := corpus[0]
	for output_index := 0; output_index < OUTPUT_TOKENS; output_index++ {
		next_candidates := transitions[previous]
		next_token := ""
		if is_undefined(next_candidates) || len(next_candidates) == 0 {
			next_token = corpus[0]
		} else {
			state = (state * 1664525 + 1013904223) & LCG_MASK
			next_token = next_candidates[state % len(next_candidates)]
		}
		for string_index := 0; string_index < len(next_token); string_index++ {
			fold_hash = ((fold_hash * 31) + int(next_token[string_index])) & RESULT_MASK
		}
		previous = next_token
	}
	return int_to_decimal(fold_hash)
}

run := func() {
	return do_markov()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_markov()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
