fmt := import("fmt")
os := import("os")
times := import("times")

GRID_SIZE := 200
GENERATION_COUNT := 1000
LCG_MASK := 0xFFFFFFFF

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

advance_generation := func(current, next_grid) {
	for row_index := 0; row_index < GRID_SIZE; row_index++ {
		row_up := row_index - 1
		if row_up < 0 {
			row_up = GRID_SIZE - 1
		}
		row_down := row_index + 1
		if row_down >= GRID_SIZE {
			row_down = 0
		}
		row_offset := row_index * GRID_SIZE
		row_up_offset := row_up * GRID_SIZE
		row_down_offset := row_down * GRID_SIZE
		for column_index := 0; column_index < GRID_SIZE; column_index++ {
			column_left := column_index - 1
			if column_left < 0 {
				column_left = GRID_SIZE - 1
			}
			column_right := column_index + 1
			if column_right >= GRID_SIZE {
				column_right = 0
			}
			neighbours := current[row_up_offset + column_left] +
				current[row_up_offset + column_index] +
				current[row_up_offset + column_right] +
				current[row_offset + column_left] +
				current[row_offset + column_right] +
				current[row_down_offset + column_left] +
				current[row_down_offset + column_index] +
				current[row_down_offset + column_right]
			alive := current[row_offset + column_index] == 1
			if alive {
				if neighbours == 2 || neighbours == 3 {
					next_grid[row_offset + column_index] = 1
				} else {
					next_grid[row_offset + column_index] = 0
				}
			} else {
				if neighbours == 3 {
					next_grid[row_offset + column_index] = 1
				} else {
					next_grid[row_offset + column_index] = 0
				}
			}
		}
	}
}

do_life := func() {
	total_cells := GRID_SIZE * GRID_SIZE
	current := []
	next_grid := []
	for i := 0; i < total_cells; i++ {
		current = append(current, 0)
		next_grid = append(next_grid, 0)
	}
	state := 20260511
	for cell_index := 0; cell_index < total_cells; cell_index++ {
		state = (state * 1664525 + 1013904223) & LCG_MASK
		if (state >> 30) & 0x3 == 0 {
			current[cell_index] = 1
		}
	}
	for generation_index := 0; generation_index < GENERATION_COUNT; generation_index++ {
		advance_generation(current, next_grid)
		tmp := current
		current = next_grid
		next_grid = tmp
	}
	live_count := 0
	for cell_value in current {
		live_count += cell_value
	}
	return int_to_decimal(live_count)
}

run := func() {
	return do_life()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_life()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
