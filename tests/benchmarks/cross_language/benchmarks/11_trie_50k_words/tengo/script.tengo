fmt := import("fmt")
os := import("os")
times := import("times")

DICTIONARY_WORD_COUNT := 50000
QUERY_COUNT := 50000
MIN_LENGTH := 4
LENGTH_RANGE_MASK := 0xF
ALPHABET := "abcdefghijklmnop"
ALPHABET_MASK := 0xF
LCG_MASK := 0xFFFFFFFF
RESULT_MASK := 0xFFFFFFFF

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

generate_word := func(state) {
	state = (state * 1664525 + 1013904223) & LCG_MASK
	length := MIN_LENGTH + (state & LENGTH_RANGE_MASK)
	output := ""
	for char_index := 0; char_index < length; char_index++ {
		state = (state * 1664525 + 1013904223) & LCG_MASK
		output += string(ALPHABET[state & ALPHABET_MASK])
	}
	return [output, state]
}

do_trie := func() {
	node_children := []
	node_terminal := []
	allocate_node := func() {
		slot := len(node_terminal)
		for i := 0; i < 16; i++ {
			node_children = append(node_children, -1)
		}
		node_terminal = append(node_terminal, false)
		return slot
	}
	root := allocate_node()

	alphabet_zero := ALPHABET[0]

	trie_insert := func(word) {
		node := root
		for char_index := 0; char_index < len(word); char_index++ {
			slot := int(word[char_index]) - int(alphabet_zero)
			child_index := node * 16 + slot
			child := node_children[child_index]
			if child == -1 {
				child = allocate_node()
				node_children[child_index] = child
			}
			node = child
		}
		node_terminal[node] = true
	}

	trie_longest_prefix_length := func(query) {
		node := root
		longest_terminal := 0
		for char_index := 0; char_index < len(query); char_index++ {
			slot := int(query[char_index]) - int(alphabet_zero)
			next := node_children[node * 16 + slot]
			if next == -1 {
				break
			}
			node = next
			if node_terminal[node] {
				longest_terminal = char_index + 1
			}
		}
		return longest_terminal
	}

	state := 98765432
	for word_index := 0; word_index < DICTIONARY_WORD_COUNT; word_index++ {
		r := generate_word(state)
		state = r[1]
		trie_insert(r[0])
	}
	query_state := 13579
	running_sum := 0
	for query_index := 0; query_index < QUERY_COUNT; query_index++ {
		r := generate_word(query_state)
		query_state = r[1]
		running_sum = (running_sum + trie_longest_prefix_length(r[0])) & RESULT_MASK
	}
	return int_to_decimal(running_sum)
}

run := func() {
	return do_trie()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_trie()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
