fmt := import("fmt")
os := import("os")
times := import("times")

PUZZLE_COUNT := 100
CELLS_TO_REMOVE := 40
RESULT_MASK := 0xFFFFFFFF
LCG_MASK := 0xFFFFFFFF

SEED_GRID := [
	5, 3, 4, 6, 7, 8, 9, 1, 2,
	6, 7, 2, 1, 9, 5, 3, 4, 8,
	1, 9, 8, 3, 4, 2, 5, 6, 7,
	8, 5, 9, 7, 6, 1, 4, 2, 3,
	4, 2, 6, 8, 5, 3, 7, 9, 1,
	7, 1, 3, 9, 2, 4, 8, 5, 6,
	9, 6, 1, 5, 3, 7, 2, 8, 4,
	2, 8, 7, 4, 1, 9, 6, 3, 5,
	3, 4, 5, 2, 8, 6, 1, 7, 9]

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

is_valid_placement := func(board, row_index, column_index, candidate) {
	for index := 0; index < 9; index++ {
		if board[row_index * 9 + index] == candidate {
			return false
		}
		if board[index * 9 + column_index] == candidate {
			return false
		}
	}
	box_row := (row_index / 3) * 3
	box_column := (column_index / 3) * 3
	for offset_row := 0; offset_row < 3; offset_row++ {
		for offset_column := 0; offset_column < 3; offset_column++ {
			if board[(box_row + offset_row) * 9 + (box_column + offset_column)] == candidate {
				return false
			}
		}
	}
	return true
}

solve_sudoku := undefined
solve_sudoku = func(board, position) {
	for position < 81 && board[position] != 0 {
		position++
	}
	if position == 81 {
		return true
	}
	row_index := position / 9
	column_index := position % 9
	for candidate := 1; candidate <= 9; candidate++ {
		if is_valid_placement(board, row_index, column_index, candidate) {
			board[position] = candidate
			if solve_sudoku(board, position + 1) {
				return true
			}
		}
	}
	board[position] = 0
	return false
}

generate_puzzle := func(board, state) {
	for row_index := 0; row_index < 9; row_index++ {
		for column_index := 0; column_index < 9; column_index++ {
			board[row_index * 9 + column_index] = SEED_GRID[row_index * 9 + column_index]
		}
	}
	for removal_index := 0; removal_index < CELLS_TO_REMOVE; removal_index++ {
		state = (state * 1664525 + 1013904223) & LCG_MASK
		position := state % 81
		board[position] = 0
	}
	return state
}

do_sudoku := func() {
	state := 76543210
	fold_hash := 0
	board := []
	for i := 0; i < 81; i++ {
		board = append(board, 0)
	}
	for puzzle_index := 0; puzzle_index < PUZZLE_COUNT; puzzle_index++ {
		state = generate_puzzle(board, state)
		solve_sudoku(board, 0)
		for cell_index := 0; cell_index < 81; cell_index++ {
			fold_hash = ((fold_hash * 31) + board[cell_index]) & RESULT_MASK
		}
	}
	return int_to_decimal(fold_hash)
}

run := func() {
	return do_sudoku()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_sudoku()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
