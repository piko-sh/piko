fmt := import("fmt")
os := import("os")
times := import("times")

IMAGE_WIDTH := 200
IMAGE_HEIGHT := 200
MAX_ITERATIONS := 80
VIEW_REAL_MIN := -2.0
VIEW_REAL_MAX := 1.0
VIEW_IMAG_MIN := -1.5
VIEW_IMAG_MAX := 1.5
ESCAPE_THRESHOLD_SQUARED := 4.0

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

do_mandelbrot_render := func() {
	real_step := (VIEW_REAL_MAX - VIEW_REAL_MIN) / float(IMAGE_WIDTH)
	imag_step := (VIEW_IMAG_MAX - VIEW_IMAG_MIN) / float(IMAGE_HEIGHT)
	total_iterations := 0
	for pixel_y := 0; pixel_y < IMAGE_HEIGHT; pixel_y++ {
		c_im := VIEW_IMAG_MIN + float(pixel_y) * imag_step
		for pixel_x := 0; pixel_x < IMAGE_WIDTH; pixel_x++ {
			c_re := VIEW_REAL_MIN + float(pixel_x) * real_step
			z_re := 0.0
			z_im := 0.0
			iterations := 0
			for iterations < MAX_ITERATIONS {
				z_re_squared := z_re * z_re
				z_im_squared := z_im * z_im
				if z_re_squared + z_im_squared > ESCAPE_THRESHOLD_SQUARED {
					break
				}
				z_im = 2.0 * z_re * z_im + c_im
				z_re = z_re_squared - z_im_squared + c_re
				iterations++
			}
			total_iterations += iterations
		}
	}
	return int_to_decimal(total_iterations)
}

run := func() {
	return do_mandelbrot_render()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_mandelbrot_render()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
