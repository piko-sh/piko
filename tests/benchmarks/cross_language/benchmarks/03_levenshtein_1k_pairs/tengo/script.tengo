fmt := import("fmt")
os := import("os")
times := import("times")

PAIR_COUNT := 1000
ALPHABET := "abcdefghijklmnopqrstuvwxyz012345"
ALPHABET_MASK := 0x1F
MIN_LENGTH := 8
LENGTH_RANGE_MASK := 0x1F
LCG_MASK := 0xFFFFFFFF

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

generate_string := func(state) {
	state = (state * 1664525 + 1013904223) & LCG_MASK
	length := MIN_LENGTH + (state & LENGTH_RANGE_MASK)
	output := ""
	for position := 0; position < length; position++ {
		state = (state * 1664525 + 1013904223) & LCG_MASK
		output += ALPHABET[state & ALPHABET_MASK]
	}
	return [output, state]
}

edit_distance := func(left, right, dp_row, dp_next) {
	left_length := len(left)
	right_length := len(right)
	for column_index := 0; column_index <= right_length; column_index++ {
		dp_row[column_index] = column_index
	}
	for row_index := 1; row_index <= left_length; row_index++ {
		dp_next[0] = row_index
		left_character := left[row_index - 1]
		for column_index := 1; column_index <= right_length; column_index++ {
			substitution_cost := 1
			if left_character == right[column_index - 1] {
				substitution_cost = 0
			}
			deletion := dp_row[column_index] + 1
			insertion := dp_next[column_index - 1] + 1
			substitution := dp_row[column_index - 1] + substitution_cost
			candidate := deletion
			if insertion < candidate {
				candidate = insertion
			}
			if substitution < candidate {
				candidate = substitution
			}
			dp_next[column_index] = candidate
		}
		for swap_index := 0; swap_index <= right_length; swap_index++ {
			dp_row[swap_index] = dp_next[swap_index]
		}
	}
	return dp_row[right_length]
}

do_levenshtein := func() {
	lcg_state := 2718281828
	total_distance := 0
	dp_row := []
	dp_next := []
	for i := 0; i < 41; i++ {
		dp_row = append(dp_row, 0)
		dp_next = append(dp_next, 0)
	}
	for pair_index := 0; pair_index < PAIR_COUNT; pair_index++ {
		r := generate_string(lcg_state)
		left_string := r[0]
		lcg_state = r[1]
		r2 := generate_string(lcg_state)
		right_string := r2[0]
		lcg_state = r2[1]
		total_distance += edit_distance(left_string, right_string, dp_row, dp_next)
	}
	return int_to_decimal(total_distance)
}

run := func() {
	return do_levenshtein()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_levenshtein()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
