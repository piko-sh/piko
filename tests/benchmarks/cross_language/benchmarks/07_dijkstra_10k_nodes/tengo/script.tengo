// Tengo translation of bench 07 dijkstra_10k_nodes. Mirrors
// ../go/piko_source.go. The heap is two parallel arrays (node ids and
// distances) with hand-rolled bubble-up / sink-down.

fmt := import("fmt")
os := import("os")
times := import("times")

NODE_COUNT := 10000
AVERAGE_DEGREE := 6
MAX_EDGE_WEIGHT := 1000
RESULT_MASK := 0xFFFFFFFF
LCG_MASK := 0xFFFFFFFF
UNREACHABLE := 1 << 30

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

generate_graph := func() {
	edge_targets := []
	edge_weights := []
	edge_heads := []
	for i := 0; i <= NODE_COUNT; i++ {
		edge_heads = append(edge_heads, 0)
	}
	state := 11223344
	for node_index := 0; node_index < NODE_COUNT; node_index++ {
		edge_heads[node_index] = len(edge_targets)
		state = (state * 1664525 + 1013904223) & LCG_MASK
		outgoing_degree := (state % (AVERAGE_DEGREE * 2)) + 1
		for edge_index := 0; edge_index < outgoing_degree; edge_index++ {
			state = (state * 1664525 + 1013904223) & LCG_MASK
			target := state % NODE_COUNT
			state = (state * 1664525 + 1013904223) & LCG_MASK
			weight := (state % MAX_EDGE_WEIGHT) + 1
			edge_targets = append(edge_targets, target)
			edge_weights = append(edge_weights, weight)
		}
	}
	edge_heads[NODE_COUNT] = len(edge_targets)
	return [edge_heads, edge_targets, edge_weights]
}

run_dijkstra := func(edge_heads, edge_targets, edge_weights) {
	distances := []
	for node_index := 0; node_index < NODE_COUNT; node_index++ {
		distances = append(distances, UNREACHABLE)
	}
	distances[0] = 0
	heap := [0]
	heap_distances := [0]

	sift_up := func(position) {
		for position > 0 {
			parent := (position - 1) / 2
			if heap_distances[parent] <= heap_distances[position] {
				break
			}
			tmp_node := heap[parent]
			heap[parent] = heap[position]
			heap[position] = tmp_node
			tmp_dist := heap_distances[parent]
			heap_distances[parent] = heap_distances[position]
			heap_distances[position] = tmp_dist
			position = parent
		}
	}

	sift_down := func(position) {
		length := len(heap)
		for {
			left_child := 2 * position + 1
			right_child := 2 * position + 2
			smallest := position
			if left_child < length && heap_distances[left_child] < heap_distances[smallest] {
				smallest = left_child
			}
			if right_child < length && heap_distances[right_child] < heap_distances[smallest] {
				smallest = right_child
			}
			if smallest == position {
				break
			}
			tmp_node := heap[position]
			heap[position] = heap[smallest]
			heap[smallest] = tmp_node
			tmp_dist := heap_distances[position]
			heap_distances[position] = heap_distances[smallest]
			heap_distances[smallest] = tmp_dist
			position = smallest
		}
	}

	heap_push := func(node, distance) {
		heap = append(heap, node)
		heap_distances = append(heap_distances, distance)
		sift_up(len(heap) - 1)
	}

	heap_pop_front := func() {
		last_index := len(heap) - 1
		heap[0] = heap[last_index]
		heap_distances[0] = heap_distances[last_index]
		heap = heap[:last_index]
		heap_distances = heap_distances[:last_index]
		if len(heap) > 0 {
			sift_down(0)
		}
	}

	for len(heap) > 0 {
		current_node := heap[0]
		current_distance := heap_distances[0]
		heap_pop_front()
		if current_distance > distances[current_node] {
			continue
		}
		edge_range_start := edge_heads[current_node]
		edge_range_end := edge_heads[current_node + 1]
		for edge_index := edge_range_start; edge_index < edge_range_end; edge_index++ {
			neighbour := edge_targets[edge_index]
			candidate := current_distance + edge_weights[edge_index]
			if candidate < distances[neighbour] {
				distances[neighbour] = candidate
				heap_push(neighbour, candidate)
			}
		}
	}
	return distances
}

do_dijkstra := func() {
	graph := generate_graph()
	edge_heads := graph[0]
	edge_targets := graph[1]
	edge_weights := graph[2]
	distances := run_dijkstra(edge_heads, edge_targets, edge_weights)
	running_sum := 0
	for distance in distances {
		if distance < UNREACHABLE {
			running_sum = (running_sum + distance) & RESULT_MASK
		}
	}
	return int_to_decimal(running_sum)
}

run := func() {
	return do_dijkstra()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_dijkstra()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
