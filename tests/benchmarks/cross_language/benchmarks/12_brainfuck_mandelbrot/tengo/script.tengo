fmt := import("fmt")
os := import("os")
times := import("times")

BRAINFUCK_PROGRAM := "" +
	"++++++++++++>++++++++>" +
	"<<[" +
	">[->+>+<<]" +
	">>[-<<+>>]" +
	"<<<-]" +
	"++++++++[>++++++++<-]>." +
	"<++++++++++[->+++<]>++++."

MEMORY_SIZE := 30000
RESULT_MASK := 0xFFFFFFFF

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

build_jump_table := func(source) {
	table := []
	for i := 0; i < len(source); i++ {
		table = append(table, 0)
	}
	stack := []
	for index := 0; index < len(source); index++ {
		character := source[index]
		if character == '[' {
			stack = append(stack, index)
		} else if character == ']' {
			open_index := stack[len(stack) - 1]
			stack = stack[:len(stack) - 1]
			table[open_index] = index
			table[index] = open_index
		}
	}
	return table
}

do_brainfuck := func() {
	memory := []
	for i := 0; i < MEMORY_SIZE; i++ {
		memory = append(memory, 0)
	}
	pointer := 0
	jump_table := build_jump_table(BRAINFUCK_PROGRAM)
	instruction_index := 0
	fold_hash := 0
	program_length := len(BRAINFUCK_PROGRAM)
	for instruction_index < program_length {
		instruction := BRAINFUCK_PROGRAM[instruction_index]
		if instruction == '>' {
			pointer++
		} else if instruction == '<' {
			pointer--
		} else if instruction == '+' {
			memory[pointer] = (memory[pointer] + 1) & 0xFF
		} else if instruction == '-' {
			memory[pointer] = (memory[pointer] - 1) & 0xFF
		} else if instruction == '.' {
			fold_hash = ((fold_hash * 31) + memory[pointer]) & RESULT_MASK
		} else if instruction == ',' {
			memory[pointer] = 0
		} else if instruction == '[' {
			if memory[pointer] == 0 {
				instruction_index = jump_table[instruction_index]
			}
		} else if instruction == ']' {
			if memory[pointer] != 0 {
				instruction_index = jump_table[instruction_index]
			}
		}
		instruction_index++
	}
	return int_to_decimal(fold_hash)
}

run := func() {
	return do_brainfuck()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_brainfuck()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
