fmt := import("fmt")
os := import("os")
times := import("times")

GENERIC_LCG_MASK := 0xFFFFFFFF
SLICES_PER_TYPE := 500
SLICE_SIZE := 100
GENERIC_SEED := 0xCAFEBABE

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

generic_sum := func(xs) {
	accumulator := 0
	for i := 0; i < len(xs); i++ {
		accumulator = accumulator + xs[i]
	}
	return accumulator
}

generic_max := func(xs) {
	if len(xs) == 0 {
		return 0
	}
	maximum := xs[0]
	for i := 1; i < len(xs); i++ {
		if xs[i] > maximum {
			maximum = xs[i]
		}
	}
	return maximum
}

generic_min := func(xs) {
	if len(xs) == 0 {
		return 0
	}
	minimum := xs[0]
	for i := 1; i < len(xs); i++ {
		if xs[i] < minimum {
			minimum = xs[i]
		}
	}
	return minimum
}

do_generic_pipeline := func() {
	state := GENERIC_SEED
	accumulator := 0

	for slice_index := 0; slice_index < SLICES_PER_TYPE; slice_index++ {
		slice := []
		for element_index := 0; element_index < SLICE_SIZE; element_index++ {
			state = (state * 1664525 + 1013904223) & GENERIC_LCG_MASK
			slice = append(slice, state)
		}
		sum_value := generic_sum(slice) & GENERIC_LCG_MASK
		max_value := generic_max(slice) & GENERIC_LCG_MASK
		min_value := generic_min(slice) & GENERIC_LCG_MASK
		accumulator = (accumulator ^ sum_value ^ max_value ^ min_value) & GENERIC_LCG_MASK
	}

	for slice_index := 0; slice_index < SLICES_PER_TYPE; slice_index++ {
		slice := []
		for element_index := 0; element_index < SLICE_SIZE; element_index++ {
			state = (state * 1664525 + 1013904223) & GENERIC_LCG_MASK
			slice = append(slice, state)
		}
		sum_value := generic_sum(slice)
		max_value := generic_max(slice)
		min_value := generic_min(slice)
		fold_sum := sum_value & GENERIC_LCG_MASK
		fold_max := max_value & GENERIC_LCG_MASK
		fold_min := min_value & GENERIC_LCG_MASK
		accumulator = (accumulator ^ fold_sum ^ fold_max ^ fold_min) & GENERIC_LCG_MASK
	}

	return int_to_decimal(accumulator)
}

run := func() {
	return do_generic_pipeline()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_generic_pipeline()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
