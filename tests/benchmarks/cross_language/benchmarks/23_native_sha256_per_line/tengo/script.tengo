fmt := import("fmt")
os := import("os")
times := import("times")

DIGEST_BYTES := 32

load_corpus := func() {
	candidates := ["testdata/corpus.txt", "benchmarks/23_native_sha256_per_line/testdata/corpus.txt", "tests/benchmarks/cross_language/benchmarks/23_native_sha256_per_line/testdata/corpus.txt"]
	for i := 0; i < len(candidates); i++ {
		data := os.read_file(candidates[i])
		if !is_error(data) {
			return data
		}
	}
	return error("corpus not found at any candidate path")
}

bytes_to_hex := func(input) {
	hex_chars := "0123456789abcdef"
	out := ""
	for i := 0; i < len(input); i++ {
		v := input[i]
		out += hex_chars[(v >> 4) & 0x0F]
		out += hex_chars[v & 0x0F]
	}
	return out
}

make_accumulator := func() {
	out := []
	for i := 0; i < DIGEST_BYTES; i++ {
		out = append(out, 0)
	}
	return out
}

do_line_hashing := func(corpus) {
	accumulator := make_accumulator()
	line_start := 0
	length := len(corpus)
	newline := 0x0A
	for index := 0; index < length; index++ {
		if corpus[index] != newline {
			continue
		}
		digest := sha256_sum(corpus[line_start:index])
		for di := 0; di < DIGEST_BYTES; di++ {
			accumulator[di] = accumulator[di] ^ digest[di]
		}
		line_start = index + 1
	}
	if line_start < length {
		digest := sha256_sum(corpus[line_start:])
		for di := 0; di < DIGEST_BYTES; di++ {
			accumulator[di] = accumulator[di] ^ digest[di]
		}
	}
	return bytes_to_hex(accumulator)
}

run := func() {
	corpus := load_corpus()
	return do_line_hashing(corpus)
}

run_inner := func(k) {
	corpus := load_corpus()
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_line_hashing(corpus)
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
