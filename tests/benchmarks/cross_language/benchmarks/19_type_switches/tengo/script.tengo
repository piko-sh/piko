fmt := import("fmt")
os := import("os")
times := import("times")

TYPE_SWITCH_MASK := 0xFFFFFFFF
VALUE_STREAM_LENGTH := 100000
TYPE_SWITCH_SEED := 0xC0FFEE
FNV_OFFSET_BASIS_32 := 0x811C9DC5
FNV_PRIME_32 := 0x01000193

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

fnv1a32 := func(key) {
	hash := FNV_OFFSET_BASIS_32
	for index := 0; index < len(key); index++ {
		hash = hash ^ int(key[index])
		hash = (hash * FNV_PRIME_32) & TYPE_SWITCH_MASK
	}
	return hash
}

dispatch_by_type := func(v) {
	kind := v["kind"]
	if kind == "int" {
		return (v["v"] + 1234) & TYPE_SWITCH_MASK
	}
	if kind == "string" {
		return fnv1a32(v["v"])
	}
	if kind == "bytes" {
		sum := 0
		bytes_val := v["v"]
		for index := 0; index < len(bytes_val); index++ {
			sum = (sum + bytes_val[index]) & TYPE_SWITCH_MASK
		}
		return sum
	}
	if kind == "bool" {
		if v["v"] {
			return 1
		}
		return 0
	}
	if kind == "float" {
		return int(v["v"]) & TYPE_SWITCH_MASK
	}
	return 0
}

build_value_stream := func() {
	state := TYPE_SWITCH_SEED
	values := []
	shared_string := "abcdefghij"
	shared_bytes := bytes("\x01\x02\x03\x04\x05\x06\x07\x08")
	for index := 0; index < VALUE_STREAM_LENGTH; index++ {
		state = (state * 1664525 + 1013904223) & TYPE_SWITCH_MASK
		kind := state & 0x7
		if kind == 0 || kind == 1 || kind == 2 {
			values = append(values, {kind: "int", v: state})
		} else if kind == 3 {
			values = append(values, {kind: "string", v: shared_string})
		} else if kind == 4 {
			values = append(values, {kind: "bytes", v: shared_bytes})
		} else if kind == 5 {
			values = append(values, {kind: "bool", v: (state & 1) == 1})
		} else if kind == 6 {
			values = append(values, {kind: "float", v: float(state)})
		} else {
			values = append(values, {kind: "int", v: state})
		}
	}
	return values
}

walk_and_dispatch := func(values) {
	accumulator := 0
	for index := 0; index < len(values); index++ {
		accumulator = (accumulator ^ dispatch_by_type(values[index])) & TYPE_SWITCH_MASK
	}
	return int_to_decimal(accumulator)
}

do_type_switches := func() {
	values := build_value_stream()
	return walk_and_dispatch(values)
}

run := func() {
	return do_type_switches()
}

run_inner := func(k) {
	values := build_value_stream()
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = walk_and_dispatch(values)
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
