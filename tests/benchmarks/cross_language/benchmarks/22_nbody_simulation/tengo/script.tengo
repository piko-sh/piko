fmt := import("fmt")
os := import("os")
math := import("math")
times := import("times")

NUM_STEPS := 50000
TIME_STEP := 0.01
PI := 3.141592653589793
DAYS_PER_YEAR := 365.24
SOLAR_MASS := 4 * PI * PI
ENERGY_SCALE := 1.0e9

initial_state := func() {
	x := [0.0, 4.84143144246472090e+00, 8.34336671824457987e+00, 1.28943695621391310e+01, 1.53796971148509165e+01]
	y := [0.0, -1.16032004402742839e+00, 4.12479856412430479e+00, -1.51111514016986312e+01, -2.59193146099879641e+01]
	z := [0.0, -1.03622044471123109e-01, -4.03523417114321381e-01, -2.23307578892655734e-01, 1.79258772950371181e-01]
	vx := [0.0,
		1.66007664274403694e-03 * DAYS_PER_YEAR,
		-2.76742510726862411e-03 * DAYS_PER_YEAR,
		2.96460137564761618e-03 * DAYS_PER_YEAR,
		2.68067772490389322e-03 * DAYS_PER_YEAR]
	vy := [0.0,
		7.69901118419740425e-03 * DAYS_PER_YEAR,
		4.99852801234917238e-03 * DAYS_PER_YEAR,
		2.37847173959480950e-03 * DAYS_PER_YEAR,
		1.62824170038242295e-03 * DAYS_PER_YEAR]
	vz := [0.0,
		-6.90460016972063023e-05 * DAYS_PER_YEAR,
		2.30417297573763929e-05 * DAYS_PER_YEAR,
		-2.96589568540237556e-05 * DAYS_PER_YEAR,
		-9.51592254519715870e-05 * DAYS_PER_YEAR]
	mass := [SOLAR_MASS,
		9.54791938424326609e-04 * SOLAR_MASS,
		2.85885980666130812e-04 * SOLAR_MASS,
		4.36624404335156298e-05 * SOLAR_MASS,
		5.15138902046611451e-05 * SOLAR_MASS]
	return {x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, mass: mass}
}

offset_momentum := func(state) {
	px := 0.0
	py := 0.0
	pz := 0.0
	n := len(state.x)
	for i := 0; i < n; i++ {
		px += state.vx[i] * state.mass[i]
		py += state.vy[i] * state.mass[i]
		pz += state.vz[i] * state.mass[i]
	}
	state.vx[0] = -px / SOLAR_MASS
	state.vy[0] = -py / SOLAR_MASS
	state.vz[0] = -pz / SOLAR_MASS
}

advance := func(state, dt) {
	n := len(state.x)
	for i := 0; i < n; i++ {
		for j := i + 1; j < n; j++ {
			dx := state.x[i] - state.x[j]
			dy := state.y[i] - state.y[j]
			dz := state.z[i] - state.z[j]
			distance_squared := dx * dx + dy * dy + dz * dz
			distance := math.sqrt(distance_squared)
			magnitude := dt / (distance_squared * distance)
			i_mass_mag := state.mass[i] * magnitude
			j_mass_mag := state.mass[j] * magnitude
			state.vx[i] -= dx * j_mass_mag
			state.vy[i] -= dy * j_mass_mag
			state.vz[i] -= dz * j_mass_mag
			state.vx[j] += dx * i_mass_mag
			state.vy[j] += dy * i_mass_mag
			state.vz[j] += dz * i_mass_mag
		}
	}
	for i := 0; i < n; i++ {
		state.x[i] += dt * state.vx[i]
		state.y[i] += dt * state.vy[i]
		state.z[i] += dt * state.vz[i]
	}
}

compute_energy := func(state) {
	energy := 0.0
	n := len(state.x)
	for i := 0; i < n; i++ {
		vx := state.vx[i]
		vy := state.vy[i]
		vz := state.vz[i]
		energy += 0.5 * state.mass[i] * (vx * vx + vy * vy + vz * vz)
		for j := i + 1; j < n; j++ {
			dx := state.x[i] - state.x[j]
			dy := state.y[i] - state.y[j]
			dz := state.z[i] - state.z[j]
			distance := math.sqrt(dx * dx + dy * dy + dz * dz)
			energy -= state.mass[i] * state.mass[j] / distance
		}
	}
	return energy
}

round_to_nearest := func(value) {
	if value >= 0 {
		return math.floor(value + 0.5)
	}
	return -math.floor(-value + 0.5)
}

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

do_simulate := func() {
	state := initial_state()
	offset_momentum(state)
	energy_before := compute_energy(state)
	for step := 0; step < NUM_STEPS; step++ {
		advance(state, TIME_STEP)
	}
	energy_after := compute_energy(state)
	before_scaled := int(round_to_nearest(energy_before * ENERGY_SCALE))
	after_scaled := int(round_to_nearest(energy_after * ENERGY_SCALE))
	return int_to_decimal(before_scaled) + "," + int_to_decimal(after_scaled)
}

run := func() {
	return do_simulate()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_simulate()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
