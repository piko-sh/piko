// Tengo translation of bench 05 expression_eval_10k. Mirrors
// ../go/piko_source.go. The recursive parser holds state via an
// evaluator map ({tokens, position}) so the helpers can advance the
// position by mutating the shared map.

fmt := import("fmt")
os := import("os")
times := import("times")

EXPRESSION_COUNT := 10000
RESULT_MASK := 0xFFFFFFFF
LCG_MASK := 0xFFFFFFFF

TOKEN_INTEGER := 0
TOKEN_PLUS := 1
TOKEN_MINUS := 2
TOKEN_MULTIPLY := 3
TOKEN_PAREN_LEFT := 4
TOKEN_PAREN_RIGHT := 5

int_to_decimal := func(value) {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := ""
	for i := len(digits) - 1; i >= 0; i-- {
		out += digits[i]
	}
	if negative {
		return "-" + out
	}
	return out
}

int_to_decimal_chars := func(value) {
	if value == 0 {
		return ['0']
	}
	digits := []
	for value > 0 {
		digits = append(digits, char(int('0') + value % 10))
		value = value / 10
	}
	out := []
	for i := len(digits) - 1; i >= 0; i-- {
		out = append(out, digits[i])
	}
	return out
}

generate_term := undefined
generate_term = func(output, state, depth_budget) {
	state = (state * 1664525 + 1013904223) & LCG_MASK
	if depth_budget <= 0 || (state & 0x3) == 0 {
		value := state & 0xFF
		for c in int_to_decimal_chars(value) {
			output[0] = output[0] + string(c)
		}
		return state
	}
	output[0] = output[0] + "("
	state = generate_term(output, state, depth_budget - 1)
	state = (state * 1664525 + 1013904223) & LCG_MASK
	operator_char := "+"
	op := state & 0x3
	if op == 1 {
		operator_char = "-"
	} else if op == 2 {
		operator_char = "*"
	} else if op == 3 {
		operator_char = "+"
	}
	output[0] = output[0] + operator_char
	state = generate_term(output, state, depth_budget - 1)
	output[0] = output[0] + ")"
	return state
}

generate_expression := func(state) {
	output := [""]
	state = (state * 1664525 + 1013904223) & LCG_MASK
	depth_budget := (state & 0x7) + 4
	state = generate_term(output, state, depth_budget)
	return [output[0], state]
}

tokenise := func(source) {
	tokens := []
	position := 0
	source_length := len(source)
	for position < source_length {
		current := source[position]
		if current >= '0' && current <= '9' {
			value := 0
			for position < source_length && source[position] >= '0' && source[position] <= '9' {
				value = value * 10 + (int(source[position]) - int('0'))
				position++
			}
			tokens = append(tokens, {kind: TOKEN_INTEGER, value: value})
		} else if current == '+' {
			tokens = append(tokens, {kind: TOKEN_PLUS, value: 0})
			position++
		} else if current == '-' {
			tokens = append(tokens, {kind: TOKEN_MINUS, value: 0})
			position++
		} else if current == '*' {
			tokens = append(tokens, {kind: TOKEN_MULTIPLY, value: 0})
			position++
		} else if current == '(' {
			tokens = append(tokens, {kind: TOKEN_PAREN_LEFT, value: 0})
			position++
		} else if current == ')' {
			tokens = append(tokens, {kind: TOKEN_PAREN_RIGHT, value: 0})
			position++
		} else {
			position++
		}
	}
	return tokens
}

precedence_for := func(kind) {
	if kind == TOKEN_MULTIPLY {
		return 20
	}
	if kind == TOKEN_PLUS || kind == TOKEN_MINUS {
		return 10
	}
	return 0
}

parse_expression := undefined
parse_atom := undefined

parse_expression = func(parser, minimum_precedence) {
	left_value := parse_atom(parser)
	for parser.position < len(parser.tokens) {
		operator_token := parser.tokens[parser.position]
		operator_precedence := precedence_for(operator_token.kind)
		if operator_precedence == 0 || operator_precedence < minimum_precedence {
			break
		}
		parser.position++
		right_value := parse_expression(parser, operator_precedence + 1)
		if operator_token.kind == TOKEN_PLUS {
			left_value = left_value + right_value
		} else if operator_token.kind == TOKEN_MINUS {
			left_value = left_value - right_value
		} else if operator_token.kind == TOKEN_MULTIPLY {
			left_value = left_value * right_value
		}
	}
	return left_value
}

parse_atom = func(parser) {
	if parser.position >= len(parser.tokens) {
		return 0
	}
	current := parser.tokens[parser.position]
	if current.kind == TOKEN_INTEGER {
		parser.position++
		return current.value
	}
	if current.kind == TOKEN_PAREN_LEFT {
		parser.position++
		value := parse_expression(parser, 0)
		if parser.position < len(parser.tokens) && parser.tokens[parser.position].kind == TOKEN_PAREN_RIGHT {
			parser.position++
		}
		return value
	}
	return 0
}

do_expression_eval := func() {
	state := 99887766
	running_sum := 0
	for expression_index := 0; expression_index < EXPRESSION_COUNT; expression_index++ {
		r := generate_expression(state)
		source := r[0]
		state = r[1]
		tokens := tokenise(source)
		parser := {tokens: tokens, position: 0}
		value := parse_expression(parser, 0)
		running_sum = (running_sum + (value & RESULT_MASK)) & RESULT_MASK
	}
	return int_to_decimal(running_sum)
}

run := func() {
	return do_expression_eval()
}

run_inner := func(k) {
	start_nanos := times.time_unix_nano(times.now())
	last := ""
	for index := 0; index < k; index++ {
		last = do_expression_eval()
	}
	elapsed_nanos := times.time_unix_nano(times.now()) - start_nanos
	return [last, elapsed_nanos]
}

args := os.args()
mode := "endtoend"
k := 0
for i := 0; i < len(args); i++ {
	if args[i] == "--mode" && i+1 < len(args) {
		mode = args[i+1]
	}
	if args[i] == "--k" && i+1 < len(args) {
		k = int(args[i+1])
	}
}

if mode == "inner" {
	result := run_inner(k)
	fmt.println(result[0])
	stderr := os.create("/dev/stderr")
	stderr.write_string(fmt.sprintf("INNER_ELAPSED_NS=%d\n", result[1]))
	stderr.close()
} else {
	fmt.println(run())
}
