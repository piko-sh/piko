namespace registry_schema_gen;

table KeyValueFB {
    key: string;
    value: string;
}

enum VariantProducerFB : byte {
    Unknown = 0,
    Build = 1,
    Runtime = 2,
}

enum VariantKindFB : byte {
    Unknown = 0,
    Source = 1,
    Derived = 2,
}

table VariantTransformFB {
    parent_variant_id: string;
    parent_content_hash: string;
    capability_name: string;
    capability_version: uint32;
    params: [KeyValueFB];
}

table VariantChunkFB {
    chunk_id: string;
    storage_key: string;
    storage_backend_id: string;
    size_bytes: int64;
    content_hash: string;
    sequence_number: int32;
    mime_type: string;
    created_at: int64;
    duration_seconds: float64;
}

table VariantFB {
    variant_id: string;
    storage_backend_id: string;
    storage_key: string;
    mime_type: string;
    size_bytes: int64;
    status: string;
    content_hash: string;
    created_at: int64;
    metadata_tags: [KeyValueFB];
    chunks: [VariantChunkFB];
    origin: string;
    build_release: string;
    build_hash: string;
    input_fingerprint: string;
    sri_hash: string;
    producer: VariantProducerFB;
    kind: VariantKindFB;
    transform: VariantTransformFB;
}

table DesiredProfileFB {
    name: string;
    priority: string;
    capability_name: string;
    params: [KeyValueFB];
    resulting_tags: [KeyValueFB];
    depends_on: [string];
}

table ArtefactMetaFB {
    id: string;
    source_path: string;
    created_at: int64;
    updated_at: int64;
    variants: [VariantFB];
    profiles: [DesiredProfileFB];
}

root_type ArtefactMetaFB;
