<template>
  <div>
    <h1>Page script without functions</h1>
    <p>
      The page script counts clicks on the counter button from the moment the page
      connects until the page is left.
    </p>
    <button p-ref="counter" type="button">Count</button>
  </div>
</template>

<script type="application/x-go">
  package main

  import "piko.sh/piko"

  func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{}, nil
  }
</script>

<script lang="ts">
const host = window as unknown as { __pageScriptLog?: string[] };
host.__pageScriptLog ??= [];
const pageLog = host.__pageScriptLog;
let clicks = 0;

pk.onConnected(() => {
  pageLog.push('connected');
  const counter = pk.refs.counter;
  const countClick = (): void => {
    clicks++;
    pageLog.push('click ' + clicks);
  };
  counter?.addEventListener('click', countClick);
  pk.onCleanup(() => counter?.removeEventListener('click', countClick));
});

pk.onDisconnected(() => {
  pageLog.push('disconnected');
});
</script>
