<template>
  <div>
    <h1>Independent Guards</h1>
    <div p-if="state.ShowPrimary">
      <piko:partial is="badge" :label="state.Config.Title"></piko:partial>
    </div>
    <div p-if="state.ShowSecondary">
      <piko:partial is="badge" :label="state.Config.Title"></piko:partial>
    </div>
  </div>
</template>

<script type="application/x-go">
  package main

  import (
    "piko.sh/piko"
    badge "testcase_148_partial_in_independent_conditionals/partials/badge.pk"
  )

  type ConfigData struct {
    Title string
  }

  type Response struct {
    ShowPrimary   bool
    ShowSecondary bool
    Config        *ConfigData
  }

  func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    return Response{
      ShowPrimary:   false,
      ShowSecondary: false,
      Config:        nil,
    }, piko.Metadata{}, nil
  }
</script>
