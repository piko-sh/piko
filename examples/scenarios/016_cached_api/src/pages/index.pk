<!-- Action response caching demo. The weather.Forecast action implements
     CacheConfig() with a 10-second TTL, so rapid calls return the same response.
     See https://piko.sh/docs/guide/advanced-actions#caching -->
<template>
  <div id="app">
    <h1 class="title">Cached weather API</h1>
    <p class="subtitle">This action caches its response for 10 seconds. Two rapid calls should return identical timestamps.</p>

    <button id="test-btn" class="button" p-on:click="testCache()">Test cache</button>

    <div class="results">
      <div class="result-row">
        <span class="label">First call timestamp:</span>
        <span class="value" p-ref="ts1">-</span>
      </div>
      <div class="result-row">
        <span class="label">Second call timestamp:</span>
        <span class="value" p-ref="ts2">-</span>
      </div>
      <div class="result-row">
        <span class="label">Result:</span>
        <span class="value" p-ref="result">idle</span>
      </div>
    </div>
  </div>
</template>

<script type="application/x-go">
package main

import "piko.sh/piko"

type Response struct{}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    return Response{}, piko.Metadata{
        Title: "Cached weather API",
    }, nil
}
</script>

<script lang="ts">
export async function testCache(): Promise<void> {
    pk.refs.result!.textContent = 'testing';

    const data1 = await action.weather.Forecast({}).call();
    pk.refs.ts1!.textContent = String(data1.timestamp);

    await new Promise(resolve => setTimeout(resolve, 100));

    const data2 = await action.weather.Forecast({}).call();
    pk.refs.ts2!.textContent = String(data2.timestamp);

    if (data1.timestamp == data2.timestamp) {
        pk.refs.result!.textContent = 'cache_hit';
    } else {
        pk.refs.result!.textContent = 'cache_miss';
    }
}
</script>

