<!-- A minimal Piko page. Every .pk file has up to three sections:
     <template> for HTML, <script type="application/x-go"> for server-side Go,
     and <style> for scoped CSS. {{ state.X }} references the Response struct. -->
<template>
  <div id="app">
    <h1 class="greeting">{{ state.Greeting }}</h1>
    <p class="description">{{ state.Description }}</p>

    <footer class="footer">
      <small>Built with Piko v{{ state.Version }}</small>
    </footer>
  </div>
</template>

<!-- The Go script runs on the server for each request. See https://piko.sh/docs/guide/pk-templates -->
<script type="application/x-go">
package main

import "piko.sh/piko"

type Response struct {
    Greeting    string
    Description string
    Version     string
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    return Response{
        Greeting:    "Hello, world!",
        Description: "This is a minimal Piko page with server-side rendering.",
        Version:     "0.1.0",
    }, piko.Metadata{
        Title: "Hello world — Piko example",
        Description: "A minimal Piko page demonstrating server-side rendering.",
    }, nil
}
</script>

<style>
  @import "testmodule/styles/theme.css";

  #app {
    max-width: 600px;
    margin: 2rem auto;
    padding: 1rem;
    font-family: var(--g-font-family, sans-serif);
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(111, 71, 235, 0.07), transparent),
      var(--g-colour-grey-50, #F6F7F8);
    color: var(--g-colour-grey-800, #364049);
    border-radius: var(--g-radius-lg, 20px);
  }

  .greeting {
    font-family: var(--g-font-family-heading);
    font-size: 1.75rem;
    color: var(--g-colour-grey-900, #2B333B);
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  .description {
    color: var(--g-colour-grey-600, #5B6B7B);
    line-height: 1.6;
  }

  .footer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--g-colour-grey-100, #E8EBEE);
    color: var(--g-colour-grey-400, #92A1AF);
    font-size: 0.875rem;
  }
</style>
