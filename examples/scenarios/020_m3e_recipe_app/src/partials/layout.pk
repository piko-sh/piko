    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    footer "testmodule/partials/footer.pk"
)

type Props struct {
    Title       string `prop:"title"`
    CurrentPage string `prop:"current-page"`
}

type Response struct {
    NavIndex int
}

var bottomNavPages = []string{"home", "recipes", "favourites", "ask-the-mouse", "kitchen-feed"}

func Render(r *piko.RequestData, props Props) (Response, piko.Metadata, error) {
    navIndex := -1
    for i, page := range bottomNavPages {
        if page == props.CurrentPage {
            navIndex = i
            break
        }
    }

    return Response{NavIndex: navIndex}, piko.Metadata{}, nil
}
</script>

<script lang="ts">
    const DESKTOP = '(min-width: 1024px)';
    const TABLET = '(min-width: 768px)';

    function drawer() {
        return document.querySelector('m3e-navigation-drawer') as any;
    }

    function syncDrawerMode(): void {
        const el = drawer();
        if (!el) return;

        if (window.matchMedia(DESKTOP).matches) {
            el.removeAttribute('modal');
            el.setAttribute('open', '');
            return;
        }

        el.setAttribute('modal', '');
        el.removeAttribute('open');
    }

    function toggleDrawer(): void {
        const el = drawer();
        if (el) el.toggle();
    }

    syncDrawerMode();
    window.matchMedia(DESKTOP).addEventListener('change', syncDrawerMode);
    window.matchMedia(TABLET).addEventListener('change', syncDrawerMode);

    piko.hooks.on(piko.hooks.events.NAVIGATION_COMPLETE, () => {
        const el = drawer();
        if (el && el.hasAttribute('modal')) el.close();
    });
</script>

<style global>
@import url('@/lib/styles/theme.css');
</style>
