            </section>

            <!-- Snackbar -->
            <m3e-snackbar p-ref="snackbar"></m3e-snackbar>

        </piko:partial>
    </div>
</template>

<script lang="ts">
    const FIRST_PAGE = 1;
    const DEFAULT_ROWS_PER_PAGE = 5;

    let page = FIRST_PAGE;
    let rowsPerPage = DEFAULT_ROWS_PER_PAGE;

    function rows(): HTMLElement[] {
        const table = pk.refs.table as HTMLElement | undefined;
        if (!table) return [];
        return Array.from(table.querySelectorAll<HTMLElement>('m2-data-table-row'));
    }

    function render(): void {
        const all = rows();
        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        all.forEach((row, index) => {
            row.hidden = index < start || index >= end;
        });
    }

    function changePage(event: CustomEvent): void {
        page = Number(event.detail.page) || 1;
        rowsPerPage = Number(event.detail.rowsPerPage) || rowsPerPage;
        render();
    }

    let selectedIds: string[] = [];

    function changeSelection(event: CustomEvent): void {
        selectedIds = (event.detail.selected as string[]) || [];
        updateSelectionUi(selectedIds.length);
    }

    function updateSelectionUi(count: number): void {
        const label = pk.refs.selectionCount as HTMLElement | undefined;
        if (label) {
            label.textContent = count === 0
                ? 'No recipes selected'
                : (count === 1 ? '1 recipe selected' : count + ' recipes selected');
        }

        const button = pk.refs.bulkButton as HTMLElement | undefined;
        if (button) button.toggleAttribute('disabled', count === 0);
    }

    function bulkPlan(): void {
        runBulk('plan');
    }

    function bulkAction(event: CustomEvent): void {
        runBulk(String(event.detail.value || ''));
    }

    function runBulk(action: string): void {
        const snackbar = pk.refs.snackbar as any;
        if (!snackbar) return;

        const count = selectedIds.length;
        const noun = count === 1 ? '1 recipe' : count + ' recipes';
        const messages: Record<string, string> = {
            plan: noun + ' added to your meal plan.',
            favourite: noun + ' saved to favourites.',
            export: 'Shopping list for ' + noun + ' is on its way.',
            clear: 'Selection cleared.',
        };

        if (action === 'clear') clearSelection();
        snackbar.show(messages[action] || 'Done.');
    }

    function clearSelection(): void {
        const table = pk.refs.table as HTMLElement | undefined;
        if (!table) return;

        table.querySelectorAll<HTMLElement>('m2-data-table-row[selected]')
            .forEach((row) => row.removeAttribute('selected'));

        const header = table.querySelector('m2-data-table-header') as HTMLElement | null;
        if (header) {
            header.removeAttribute('all_selected');
            header.removeAttribute('some_selected');
        }

        selectedIds = [];
        updateSelectionUi(0);
    }

    function changeSort(event: CustomEvent): void {
        const table = pk.refs.table as HTMLElement | undefined;
        if (!table) return;

        const COLUMNS: Record<string, number> = {
            recipe: 0, time: 3, calories: 5, protein: 6, fat: 7, carbs: 8,
        };
        const index = COLUMNS[event.detail.column as string];
        if (index === undefined) return;

        const descending = event.detail.direction === 'desc';
        const value = (row: HTMLElement): string =>
            (row.querySelectorAll('m2-data-table-cell')[index]?.textContent || '').trim();

        const sorted = rows().sort((a, b) => {
            const av = value(a);
            const bv = value(b);
            const an = parseFloat(av);
            const bn = parseFloat(bv);
            const result = (!isNaN(an) && !isNaN(bn)) ? an - bn : av.localeCompare(bv);
            return descending ? -result : result;
        });

        sorted.forEach((row) => table.appendChild(row));

        // A new order means the first page shows different rows.
        page = 1;
        render();
    }

    render();

    piko.hooks.on(piko.hooks.events.NAVIGATION_COMPLETE, () => {
        if (!document.querySelector('[p-ref="table"]')) return;

        page = FIRST_PAGE;
        rowsPerPage = DEFAULT_ROWS_PER_PAGE;
        render();
    });
</script>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Recipe index - The Norman Kitchen",
    }, nil
}
</script>
