<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Favourites"
            server.current-page="favourites">

            <section class="page-section">
                <h1 class="page-title">My favourites</h1>
                <p class="section-subtitle">Your personal collection of cheesy treasures</p>

                <!-- m3e-button-group tracks [data-group-item] children. -->
                <m3e-button-group class="mb-lg" p-on:change="changeFilter">
                    <button type="button" data-group-item="all" data-selected>All</button>
                    <button type="button" data-group-item="quick">Under 30 mins</button>
                    <button type="button" data-group-item="easy">Easy</button>
                    <button type="button" data-group-item="medium">Medium</button>
                </m3e-button-group>

                <p class="text-muted text-sm mb-md" p-ref="resultCount" role="status"></p>

                <!-- Saved recipes -->
                <div class="recipe-grid" p-ref="grid" p-if="len(state.Favourites) > 0">
                    <piko:partial is="recipe_card"
                        p-for="(i, recipe) in state.Favourites"
                        p-key="recipe.Slug"
                        :server.title="recipe.Title"
                        :server.slug="recipe.Slug"
                        :server.pun="recipe.Pun"
                        :server.description="recipe.Description"
                        :server.image="recipe.Image"
                        :server.cook-time="recipe.CookTime"
                        :server.cheese="recipe.Cheese"
                        :server.difficulty="recipe.Difficulty"
                        :server.href="recipe.Href"
                    ></piko:partial>
                </div>

                <!-- Shown when the group filter excludes everything. -->
                <div class="empty-state" p-ref="noResults" hidden>
                    <h2 class="empty-state-title">Nothing in that group</h2>
                    <p class="empty-state-subtitle">None of your saved recipes match. Try another group.</p>
                </div>

                <!-- Shown only when nothing is saved. -->
                <div class="empty-state" p-if="len(state.Favourites) == 0">
                    <piko:img src="@/lib/images/empty-state-mouse.jpg" alt="" class="empty-state-image"></piko:img>
                    <h2 class="empty-state-title">The mice got to it first!</h2>
                    <p class="empty-state-subtitle">Brie-lieve in yourself, and save some recipes to see them here!</p>
                    <m3e-button variant="filled" href="/recipes">Browse recipes</m3e-button>
                </div>
            </section>

            <!-- Remove confirmation dialog -->
            <m3e-dialog p-ref="removeDialog" headline="Remove favourite">
                <p class="prose">Are you sure? This is un-brie-lievable...</p>
                <p class="prose">You can always add it back later. No hard feelings, just hard cheeses.</p>
                <div slot="actions">
                    <m3e-button variant="text" p-on:click="closeDialog">Cancel</m3e-button>
                    <m3e-button variant="filled" p-on:click="confirmRemove">Remove</m3e-button>
                </div>
            </m3e-dialog>

            <!-- Snackbar for remove feedback -->
            <m3e-snackbar p-ref="snackbar"></m3e-snackbar>

            <!-- Extended FAB -->
            <m3e-extended-fab class="floating-fab" p-on:click="discoverRecipes">
                <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="24" height="24" slot="icon"></piko:svg>
                Discover Recipes
            </m3e-extended-fab>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
    recipe_card "testmodule/partials/recipe-card.pk"
)

// Favourite is a recipe the visitor has saved.
type Favourite struct {
    Title       string
    Slug        string
    Pun         string
    Description string
    Image       string
    CookTime    string
    Cheese      string
    Difficulty  string
    Href        string
}

type Response struct {
    Favourites []Favourite
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    return Response{
        Favourites: []Favourite{
            {
                Title:       "The Grate Burger",
                Slug:        "the-grate-burger",
                Pun:         "The gratest burger you'll ever taste",
                Description: "A towering double cheeseburger with aged cheddar, caramelised onions, and our secret sauce.",
                Image:       "@/lib/images/recipe-the-grate-burger.jpg",
                CookTime:    "25 mins",
                Cheese:      "Cheddar",
                Difficulty:  "Easy",
                Href:        "/recipe/the-grate-burger",
            },
            {
                Title:       "Camembert Believe It",
                Slug:        "camembert-believe-it",
                Pun:         "The king of cheeses, baked to perfection",
                Description: "Whole baked Camembert with rosemary, garlic, and crusty bread soldiers.",
                Image:       "@/lib/images/recipe-camembert-believe-it.jpg",
                CookTime:    "30 mins",
                Cheese:      "Camembert",
                Difficulty:  "Easy",
                Href:        "/recipe/camembert-believe-it",
            },
            {
                Title:       "Raclette & Roll",
                Slug:        "raclette-and-roll",
                Pun:         "Ready to raclette and roll!",
                Description: "Classic Swiss raclette with baby potatoes, cornichons, pickled onions, and charcuterie.",
                Image:       "@/lib/images/recipe-raclette-and-roll.jpg",
                CookTime:    "40 mins",
                Cheese:      "Raclette",
                Difficulty:  "Medium",
                Href:        "/recipe/raclette-and-roll",
            },
        },
    }, piko.Metadata{
        Title: "Favourites - The Norman Kitchen",
    }, nil
}
</script>

<script lang="ts">
    function notify(message: string): void {
        const snackbar = pk.refs.snackbar as any;
        if (snackbar) snackbar.show(message);
    }

    function closeDialog(): void {
        const dialog = pk.refs.removeDialog as any;
        if (dialog) dialog.close();
    }

    function confirmRemove(): void {
        closeDialog();
        notify("Removed from favourites. Whey to go... wait, that's sad.");
    }

    function changeFilter(event: CustomEvent): void {
        const selected = (event.detail.selected as string[]) || [];
        apply(selected[0] || 'all');
    }

    function apply(group: string): void {
        const grid = pk.refs.grid as HTMLElement | undefined;
        const empty = pk.refs.noResults as HTMLElement | undefined;
        const count = pk.refs.resultCount as HTMLElement | undefined;
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll<HTMLElement>('.recipe-card'));
        let shown = 0;

        cards.forEach((card) => {
            const minutes = parseInt(card.dataset.time || '', 10) || 0;
            const difficulty = (card.dataset.difficulty || '').toLowerCase();

            let match = true;
            if (group === 'quick') match = minutes > 0 && minutes < 30;
            else if (group === 'easy' || group === 'medium') match = difficulty === group;

            card.hidden = !match;
            if (match) shown++;
        });

        if (empty) empty.hidden = shown > 0;
        if (count) {
            count.textContent = shown === cards.length
                ? 'Showing all ' + cards.length + ' saved recipes'
                : 'Showing ' + shown + ' of ' + cards.length + ' saved recipes';
        }
    }

    apply('all');

    piko.hooks.on(piko.hooks.events.NAVIGATION_COMPLETE, () => {
        // Global hook, so check this is its own page before touching any ref.
        if (!document.querySelector('[p-ref="removeDialog"]')) return;

        apply('all');
    });

    function discoverRecipes(): void {
        piko.nav.navigate('/recipes');
    }
</script>
