<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Ask the mouse"
            server.current-page="ask-the-mouse">

            <section class="page-section page-section--reading">
                <!-- Hero -->
                <div class="ask-hero">
                    <piko:img src="@/lib/images/mascot-ask.jpg" alt="Gouda the Gourmet, cheese oracle" class="ask-hero-image"></piko:img>
                    <div class="ask-hero-text">
                        <h1 class="page-title">Ask the mouse</h1>
                        <p class="section-subtitle">Our resident cheese oracle, Gouda the Gourmet, will dispense wisdom from beyond the cheese counter</p>
                    </div>
                </div>

                <!-- Question form -->
                <m3e-card variant="elevated" class="form-card">
                    <form action="/ask-the-mouse" method="get" class="form-stack card-pad--lg" p-ref="askForm">
                        <m3e-text-field
                            variant="outlined"
                            label="Ask the mouse a question..."
                            name="q"
                            :value="state.Question"
                            supporting-text="The mouse knows all things cheese-related (and some things that aren't)"
                            class="form-field"></m3e-text-field>

                        <div class="form-actions form-actions--centre">
                            <!-- m3e-button always renders type="button". -->
                            <m3e-button variant="filled" size="l" p-on:click="ask">Consult the oracle</m3e-button>
                        </div>
                    </form>
                </m3e-card>

                <!-- Answer -->
                <div class="ask-response" p-if="state.Question != ''">
                    <!-- Error -->
                    <m3e-card variant="outlined" class="ask-error" p-if="state.Error != ''">
                        <div class="card-pad">
                            <p>{{ state.Error }}</p>
                        </div>
                    </m3e-card>

                    <m3e-card variant="outlined" class="fortune" p-if="state.Answer != '' && state.Error == ''">
                        <div class="card-pad--lg">
                            <div class="fortune-label">
                                <m3e-icon size="sm">
                                    <piko:svg src="@/lib/icons/lightbulb.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </m3e-icon>
                                The mouse speaks
                            </div>
                            <div class="fortune-body" p-html="state.Answer"></div>
                        </div>
                    </m3e-card>
                </div>

                <!-- Suggestion chips (shown before a question is asked) -->
                <div class="ask-response" p-if="state.Question == ''">
                    <p class="text-muted text-sm mb-md">Not sure what to ask? Try one of these:</p>
                    <m3e-chip-set>
                        <piko:a href="/ask-the-mouse?q=Which+cheese+goes+best+with+red+wine%3F">
                            <m3e-chip variant="suggestion">Which cheese goes best with red wine?</m3e-chip>
                        </piko:a>
                        <piko:a href="/ask-the-mouse?q=Is+it+ever+too+early+for+cheese%3F">
                            <m3e-chip variant="suggestion">Is it ever too early for cheese?</m3e-chip>
                        </piko:a>
                        <piko:a href="/ask-the-mouse?q=What+is+the+meaning+of+brie%3F">
                            <m3e-chip variant="suggestion">What is the meaning of brie?</m3e-chip>
                        </piko:a>
                        <piko:a href="/ask-the-mouse?q=Should+I+add+more+cheese%3F">
                            <m3e-chip variant="suggestion">Should I add more cheese?</m3e-chip>
                        </piko:a>
                        <piko:a href="/ask-the-mouse?q=How+do+I+know+if+a+Camembert+is+ripe%3F">
                            <m3e-chip variant="suggestion">How do I know if a Camembert is ripe?</m3e-chip>
                        </piko:a>
                        <piko:a href="/ask-the-mouse?q=Tell+me+something+gouda">
                            <m3e-chip variant="suggestion">Tell me something gouda</m3e-chip>
                        </piko:a>
                    </m3e-chip-set>
                </div>
            </section>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    "piko.sh/piko/wdk/llm"
    markdown "piko.sh/piko/wdk/markdown/markdown_provider_goldmark"
    layout "testmodule/partials/layout.pk"
)

type Response struct {
    Question string
    Answer   string
    Error    string
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    question := ""
    if qValues, ok := r.QueryParams()["q"]; ok && len(qValues) > 0 {
        question = qValues[0]
    }

    if question == "" {
        return Response{}, piko.Metadata{
            Title:       "Ask the mouse - The Norman Kitchen",
            Description: "Consult Gouda the Gourmet, our resident cheese oracle, for wisdom from beyond the cheese counter.",
        }, nil
    }

    builder, err := llm.NewCompletionBuilderFromDefault()
    if err != nil {
        return Response{
            Question: question,
            Error:    "The mouse is napping. Please try again in a moment.",
        }, piko.Metadata{
            Title: "Ask the mouse - The Norman Kitchen",
        }, nil
    }

    resp, err := builder.User(question).Do(r.Context())
    if err != nil {
        return Response{
            Question: question,
            Error:    "The mouse got distracted by a piece of cheese. Please try again.",
        }, piko.Metadata{
            Title: "Ask the mouse - The Norman Kitchen",
        }, nil
    }

    answer, err := markdown.ToHTML(r.Context(), resp.Content())
    if err != nil {
        return Response{
            Question: question,
            Error:    "The mouse mumbled something we couldn't make out. Please try again.",
        }, piko.Metadata{
            Title: "Ask the mouse - The Norman Kitchen",
        }, nil
    }

    return Response{
        Question: question,
        Answer:   answer,
    }, piko.Metadata{
        Title:       "Ask: " + question + " - The Norman Kitchen",
        Description: "The mouse has spoken on: " + question,
    }, nil
}
</script>

<script lang="ts">
    function ask(): void {
        const form = pk.refs.askForm as HTMLFormElement | undefined;
        if (form) form.requestSubmit();
    }
</script>

<style>
.ask-hero {
    display: flex;
    align-items: center;
    gap: var(--nk-space-5);
    margin-bottom: var(--nk-space-6);
    flex-wrap: wrap;
}

.ask-hero-image {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--m3e-primary);
    flex-shrink: 0;
}

.ask-hero-text {
    flex: 1;
    min-width: 250px;
}

.ask-response {
    margin-top: var(--nk-space-5);
}

@media (max-width: 640px) {
    .ask-hero {
        flex-direction: column;
        text-align: center;
    }

    .ask-hero-image {
        width: 128px;
        height: 128px;
    }
}
</style>
