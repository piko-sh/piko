<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="About"
            server.current-page="about">

            <!-- Hero -->
            <section class="page-section">
                <m3e-card variant="elevated">
                    <piko:img src="@/lib/images/about-hero.jpg" alt="The Norman Kitchen" class="media-16x7"></piko:img>
                    <div class="about-hero-body">
                        <h1 class="page-title">About The Norman Kitchen</h1>
                        <p class="section-subtitle text-lead">Fondue of cooking? So are we!</p>
                        <p class="prose about-hero-copy">
                            Established in the heart of Normandy, home of Camembert, naturally, The Norman Kitchen
                            was founded by three mice who loved cheese so much they started a kitchen. They set out to
                            prove that every dish is better with cheese, and we think they've done a brie-lliant job.
                        </p>
                    </div>
                </m3e-card>
            </section>

            <!-- Our story -->
            <section class="page-section section--centred">
                <h2 class="section-title">Our story</h2>
                <p class="section-subtitle">How three mice turned a love of cheese into a culinary empire</p>

                <div class="measure">
                    <p class="prose">
                        It all started in a tiny kitchen in Normandy, where three mice (Cheddar, Brie, and Gouda)
                        discovered they shared an unshakeable belief: that cheese is not just an ingredient, but a way
                        of life. While other mice were content nibbling crumbs, our founders dreamt bigger. They wanted
                        to create recipes that would make the whole world say "gouda gracious!"
                    </p>
                    <p class="prose">
                        From humble beginnings, a single wheel of Camembert and a dream, The Norman Kitchen has grown
                        into a beloved collection of cheese-forward recipes. Every dish is crafted with care, tested by
                        our resident mice, and guaranteed to be the gratest thing you've ever tasted. We believe cooking
                        should be fun, flavourful, and absolutely loaded with cheese.
                    </p>
                </div>
            </section>

            <!-- Meet the team -->
            <section class="page-section section--centred">
                <h2 class="section-title">Meet the team</h2>
                <p class="section-subtitle">The mice behind the magic</p>

                <div class="team-grid">
                    <m3e-card variant="elevated">
                        <div class="card-fill">
                            <piko:img src="@/lib/images/mascot-cheddar-chef.jpg" alt="Cheddar the Chef" class="media-square"></piko:img>
                            <div class="card-body">
                                <h3 class="team-name">Cheddar the Chef</h3>
                                <p class="team-role">Head chef</p>
                                <p class="prose">Sharp as his namesake, Cheddar has been crafting cheesy masterpieces since he could reach
                                the counter. His signature move? A perfectly melted cheddar crown on everything.</p>
                            </div>
                        </div>
                    </m3e-card>

                    <m3e-card variant="elevated">
                        <div class="card-fill">
                            <piko:img src="@/lib/images/mascot-brie-baker.jpg" alt="Brie the Baker" class="media-square"></piko:img>
                            <div class="card-body">
                                <h3 class="team-name">Brie the Baker</h3>
                                <p class="team-role">Pastry chef</p>
                                <p class="prose">Soft-hearted and creamy in temperament, Brie believes every meal deserves a beautiful
                                bread accompaniment. Her cheese scones are the stuff of legend.</p>
                            </div>
                        </div>
                    </m3e-card>

                    <m3e-card variant="elevated">
                        <div class="card-fill">
                            <piko:img src="@/lib/images/mascot-gouda-gourmet.jpg" alt="Gouda the Gourmet" class="media-square"></piko:img>
                            <div class="card-body">
                                <h3 class="team-name">Gouda the Gourmet</h3>
                                <p class="team-role">Sommelier &amp; taster</p>
                                <p class="prose">With a refined palate and a monocle to match, Gouda ensures every cheese pairing is
                                perfection. He can identify over 200 varieties by smell alone.</p>
                            </div>
                        </div>
                    </m3e-card>
                </div>
            </section>

            <!-- Contact form -->
            <section class="page-section section--centred">
                <h2 class="section-title">Get in touch</h2>
                <p class="section-subtitle">We'd love to hear from you, so don't be shy: drop us a line!</p>

                <div class="measure--wide measure">
                    <form class="form-stack" p-ref="contactForm" p-on:submit.prevent="action.email.Contact($form)">
                        <m3e-text-field variant="outlined"
                                        label="Name"
                                        name="name"
                                        supporting-text="We promise the mice won't share it"
                                        class="form-field"></m3e-text-field>

                        <m3e-text-field variant="outlined"
                                        label="Email"
                                        name="email"
                                        type="email"
                                        supporting-text="For cheesy updates only"
                                        error-text="Please enter a valid email address"
                                        class="form-field"></m3e-text-field>

                        <input type="hidden" name="reason" p-ref="reasonInput" />
                        <m3e-select variant="outlined" label="Reason for contact" class="form-field" p-on:change="changeReason">
                            <m3e-menu-item value="general">General enquiry</m3e-menu-item>
                            <m3e-menu-item value="recipe">Recipe suggestion</m3e-menu-item>
                            <m3e-menu-item value="emergency">Cheese emergency</m3e-menu-item>
                            <m3e-menu-item value="bug">Bug report</m3e-menu-item>
                            <m3e-menu-item value="hello">Just saying hi</m3e-menu-item>
                        </m3e-select>

                        <m3e-text-field variant="outlined"
                                        label="Message"
                                        name="message"
                                        multiline
                                        rows="4"
                                        maxlength="1000"
                                        supporting-text="Tell us something gouda"
                                        class="form-field"></m3e-text-field>

                        <label class="switch-field">
                            <m3e-switch name="newsletter" value="yes"></m3e-switch>
                            <span>Subscribe to our 'Whey' newsletter</span>
                        </label>

                        <div class="form-actions form-actions--centre">
                            <m3e-button variant="filled" size="l" p-on:click="sendMessage">Send message</m3e-button>
                        </div>
                    </form>
                </div>
            </section>

            <!-- FAQ -->
            <section class="page-section section--centred">
                <h2 class="section-title">Frequently asked questions</h2>
                <p class="section-subtitle">Everything you wanted to know but were too gouda to ask</p>

                <div class="measure faq-list">
                    <m3e-list dividers>
                        <m3e-list-item headline="Why is everything about cheese?" supporting-text="Because cheese makes everything better. That's not an opinion, that's science. Probably." lines="2"></m3e-list-item>
                        <m3e-list-item headline="Are the mice real?" supporting-text="Cheddar, Brie, and Gouda are as real as the cheese they're named after. They prefer to stay behind the scenes, but rest assured they taste-test every recipe." lines="2"></m3e-list-item>
                        <m3e-list-item headline="Can I suggest a recipe?" supporting-text="Absolutely! Use the contact form above. The only rule: it must contain cheese." lines="2"></m3e-list-item>
                        <m3e-list-item headline="Why 'The Norman Kitchen'?" supporting-text="Named after Normandy, France, birthplace of the king of cheeses, Camembert. It felt only right." lines="2"></m3e-list-item>
                    </m3e-list>
                </div>
            </section>

            <!-- Confirmation dialog -->
            <m3e-dialog p-ref="confirmDialog" headline="Message sent!">
                <p class="prose">Whey to go! We'll get back to you faster than cheese melts.</p>
                <div slot="actions">
                    <m3e-button variant="filled" p-on:click="closeConfirmation">Brilliant!</m3e-button>
                </div>
            </m3e-dialog>

            <!-- Snackbar -->
            <m3e-snackbar p-ref="snackbar"></m3e-snackbar>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
    contact "testmodule/actions/email/contact.go"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "About - The Norman Kitchen",
    }, nil
}
</script>

<script lang="ts">

    function changeReason(event: CustomEvent): void {
        const input = pk.refs.reasonInput as HTMLInputElement | undefined;
        if (input) input.value = event.detail.value;
    }

    function sendMessage(): void {
        const form = pk.refs.contactForm as HTMLFormElement | undefined;
        if (form) form.requestSubmit();
    }

    function closeConfirmation(): void {
        const dialog = pk.refs.confirmDialog as any;
        if (dialog) dialog.close();
    }
</script>
