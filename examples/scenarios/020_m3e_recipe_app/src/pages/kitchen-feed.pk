<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Live kitchen feed"
            server.current-page="kitchen-feed">

            <section class="page-section page-section--reading">
                <!-- Hero -->
                <div class="feed-hero">
                    <piko:img src="@/lib/images/security-camera.jpg" alt="Kitchen security camera feed" class="feed-hero-image"></piko:img>
                    <div class="feed-hero-overlay">
                        <span class="feed-hero-rec">REC</span>
                        <span class="feed-hero-cam">CAM 04 · KITCHEN</span>
                    </div>
                </div>

                <div class="feed-header">
                    <div>
                        <h1 class="page-title">Live kitchen feed</h1>
                        <p class="section-subtitle">Real-time dispatches from The Norman Kitchen. Powered by cheese and questionable decisions.</p>
                    </div>

                    <div class="feed-controls">
                        <span class="status" p-ref="statusBadge" data-state="off" role="status">Disconnected</span>
                        <m3e-loading-indicator p-ref="connectingSpinner" size="small" hidden></m3e-loading-indicator>
                        <m3e-button p-ref="connectBtn" variant="filled" p-on:click="toggleFeed">
                            <span slot="icon" class="feed-toggle-icon">
                                <piko:svg p-ref="playIcon" src="@/lib/icons/play.svg" fill="currentColor" width="18" height="18"></piko:svg>
                                <piko:svg p-ref="pauseIcon" src="@/lib/icons/pause.svg" fill="currentColor" width="18" height="18" hidden></piko:svg>
                            </span>
                            <span p-ref="connectLabel">Start feed</span>
                        </m3e-button>
                    </div>
                </div>

                <!-- Feed container -->
                <div p-ref="feedContainer" class="feed-container">
                    <div class="feed-empty">
                        <p class="text-lead">Press <strong>Start feed</strong> to begin receiving live updates from the kitchen.</p>
                        <p class="text-muted text-sm mt-sm">The mice are standing by.</p>
                    </div>
                </div>
            </section>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
    feed "testmodule/actions/kitchen/feed.go"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title:       "Live kitchen feed - The Norman Kitchen",
        Description: "Real-time dispatches from The Norman Kitchen. Watch the chaos unfold.",
    }, nil
}
</script>

<script lang="ts">
let connected = false;
let abortController: AbortController | null = null;

const categoryStyles: Record<string, { label: string; colour: string }> = {
    mouse:    { label: 'Mouse',    colour: 'var(--m3e-primary)' },
    cheese:   { label: 'Cheese',   colour: 'var(--m3e-tertiary)' },
    alarm:    { label: 'Alarm',    colour: 'var(--m3e-error)' },
    chef:     { label: 'Chef',     colour: 'var(--m3e-secondary)' },
    review:   { label: 'Review',   colour: 'var(--m3e-primary)' },
    delivery: { label: 'Delivery', colour: 'var(--m3e-tertiary)' },
    mystery:  { label: 'Mystery',  colour: 'var(--m3e-on-surface-variant)' },
};

function setStatus(text: string, state: string) {
    const badge = pk.refs.statusBadge;
    if (badge) {
        badge.textContent = text;
        badge.dataset.state = state;
    }

    const spinner = pk.refs.connectingSpinner;
    if (spinner) spinner.hidden = state !== 'pending';
}

function setButton(running: boolean): void {
    const label = pk.refs.connectLabel;
    if (label) label.textContent = running ? 'Stop feed' : 'Start feed';

    const play = pk.refs.playIcon as Element | undefined;
    const pause = pk.refs.pauseIcon as Element | undefined;
    if (play) play.toggleAttribute('hidden', running);
    if (pause) pause.toggleAttribute('hidden', !running);
}

export async function toggleFeed(): Promise<void> {
    if (connected) {
        connected = false;
        if (abortController) {
            abortController.abort();
            abortController = null;
        }
        setStatus('Disconnected', 'off');
        setButton(false);
        return;
    }

    connected = true;
    setButton(true);

    // Clear the empty state.
    const container = pk.refs.feedContainer;
    if (container) {
        const empty = container.querySelector('.feed-empty');
        if (empty) empty.remove();
    }

    setStatus('Connecting...', 'pending');

    abortController = new AbortController();
    const signal = abortController.signal;

    try {
        await action.kitchen.Feed({})
            .withSignal(signal)
            .withOnProgress((data: unknown, eventType: string) => {

                if (eventType !== 'event' || signal.aborted) return;
                setStatus('Connected', 'live');

                const evt = data as { text: string; category: string; time: string };
                appendEvent(evt.text, evt.category, evt.time);
            })
            .withRetryStream({
                maxReconnects: Infinity,
                baseDelay: 3000,
                backoff: 'exponential',
                onDisconnect: () => {
                    if (!signal.aborted) setStatus('Reconnecting...', 'pending');
                },
                onReconnect: () => {
                    if (!signal.aborted) setStatus('Connected', 'live');
                },
            })
            .call();
    } catch {
        if (signal.aborted) return;

        setStatus('Disconnected', 'off');
        connected = false;
        setButton(false);
    }
}

function appendEvent(text: string, category: string, time: string): void {
    const container = pk.refs.feedContainer;
    if (!container) return;

    const style = categoryStyles[category] || categoryStyles.mystery;

    const card = document.createElement('div');
    card.className = 'feed-event';
    card.innerHTML =
        '<div class="feed-event-header">' +
            '<span class="feed-event-category" style="background: ' + style.colour + ';">' + escapeHtml(style.label) + '</span>' +
            '<span class="feed-event-time">' + escapeHtml(time) + '</span>' +
        '</div>' +
        '<p class="feed-event-text">' + escapeHtml(text) + '</p>';

    container.prepend(card);

    // Trigger animation.
    requestAnimationFrame(() => {
        card.classList.add('visible');
    });

    // Limit to 50 visible events.
    while (container.children.length > 50) {
        container.removeChild(container.lastChild!);
    }
}

function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>
