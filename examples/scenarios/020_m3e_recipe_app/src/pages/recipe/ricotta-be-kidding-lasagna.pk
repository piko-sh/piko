                </section>

                <!-- Reviews -->
                <section class="recipe-panel" p-ref="panel3" aria-label="Reviews" hidden>
                    <h2 class="subsection-title">Reviews</h2>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">TripleCheeseFanatic</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Three cheeses?! You ricotta be kidding me! But seriously, this is the best lasagna I've ever made at home. The layers are perfect and the b&eacute;chamel takes it to another level.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">SundaySupperClub</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
