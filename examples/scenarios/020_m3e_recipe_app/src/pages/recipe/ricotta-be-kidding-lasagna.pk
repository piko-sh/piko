                            <li class="nutrition-row"><span class="nutrition-label">Fat</span><span class="nutrition-value">28g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Carbohydrates</span><span class="nutrition-value">38g</span></li>
