<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Gouda Gracious Mac & Cheese"
            server.current-page="recipes">

            <article class="page-section page-section--reading">
                <piko:img class="recipe-hero" src="@/lib/images/recipe-gouda-gracious-mac.jpg" alt="Gouda Gracious Mac &amp; Cheese"></piko:img>

                <header class="mt-lg">
                    <h1 class="recipe-title">Gouda Gracious Mac &amp; Cheese</h1>
                    <p class="recipe-pun">Gouda gracious, that's creamy!</p>

                    <div class="recipe-meta-row tag-row">
                        <span class="tag">Gouda + Gruy&egrave;re</span>
                        <span class="tag">45 mins</span>
                        <span class="tag">Easy</span>
                        <span class="tag">6 servings</span>
                    </div>

                    <div class="recipe-actions">
                        <m3e-split-button variant="filled" p-on:click="saveRecipe">
                            Save recipe
                            <m3e-menu-item slot="menu" p-on:select="addToMealPlan">Add to meal plan</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="shareRecipe">Share recipe</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="printRecipe">Print</m3e-menu-item>
                        </m3e-split-button>

                        <m3e-tooltip text="Add to favourites">
                            <m3e-icon-button toggle aria-label="Add to favourites">
                                <piko:svg src="@/lib/icons/favourite.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <m3e-tooltip text="Squeak peek: cooking tips">
                            <m3e-icon-button aria-label="Show cooking tips" p-on:click="openTips">
                                <piko:svg src="@/lib/icons/info.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <label class="switch-field">
                            <m3e-switch p-on:change="toggleUnits" aria-label="Use imperial measurements"></m3e-switch>
                            <span p-ref="unitLabel">Metric</span>
                        </label>
                    </div>
                </header>

                <m3e-tabs class="recipe-tabs" p-on:change="selectPanel">
                    <m3e-tab active>Ingredients</m3e-tab>
                    <m3e-tab>Method</m3e-tab>
                    <m3e-tab>Nutrition</m3e-tab>
                    <m3e-tab>Reviews (5)</m3e-tab>
                </m3e-tabs>

                <!-- Ingredients -->
                <section class="recipe-panel" p-ref="panel0" aria-label="Ingredients">
                    <div class="panel-header">
                        <h2 class="subsection-title">Ingredients</h2>
                        <div class="servings-control">
                            <span id="servings-label">Servings</span>
                            <m3e-slider class="servings-slider"
                                        discrete
                                        min="1"
                                        max="12"
                                        value="6"
                                        step="1"
                                        aria-labelledby="servings-label"
                                        p-on:change="changeServings"></m3e-slider>
                            <strong p-ref="servingsValue">6</strong>
                        </div>
                    </div>

                    <div p-ref="ingredients">
                        <m3e-list>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="400" data-unit="g">400g</span> macaroni pasta</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="200" data-unit="g">200g</span> aged Gouda, grated</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="150" data-unit="g">150g</span> Gruy&egrave;re, grated</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="50" data-unit="g">50g</span> unsalted butter</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="50" data-unit="g">50g</span> plain flour</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="750" data-unit="ml">750ml</span> whole milk</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="1" data-unit="tsp">1 tsp</span> Dijon mustard</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Pinch of freshly grated nutmeg</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="60" data-unit="g">60g</span> breadcrumbs (panko works brilliantly)</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Salt, to taste</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Freshly ground black pepper, to taste</span></m3e-list-item>
                        </m3e-list>
                    </div>
                </section>

                <!-- Method -->
                <section class="recipe-panel" p-ref="panel1" aria-label="Method" hidden>
                    <h2 class="subsection-title">Method</h2>
                    <ol class="step-list">
                        <li>Preheat the oven to 190&deg;C. Cook the macaroni in salted boiling water for 2 minutes less than the packet says, because it finishes cooking in the oven. Use this time to grate the Gouda. You&rsquo;ll need 200g. Grate 250g because you are going to eat at least 50g while you cook and that is simply the tax one pays for making mac and cheese.</li>
                        <li>Make the roux. Melt the butter in a heavy-bottomed saucepan over medium heat. Add the flour and stir constantly for 1&ndash;2 minutes until it turns golden and smells biscuity. This is the boring bit, but it&rsquo;s the foundation of everything beautiful that follows. Think of it as the opening credits before the cheese blockbuster.</li>
                        <li>Gradually add the milk, a splash at a time, whisking continuously. If you add it all at once you&rsquo;ll get lumps and the mice will be very disappointed in you. Once the sauce thickens and coats the back of a spoon (5&ndash;7 minutes), stir in the Dijon mustard and nutmeg. Taste it. Go on. Oh, that&rsquo;s already good and we haven&rsquo;t even added the cheese yet.</li>
                        <li>Remove from the heat. Now. THIS is the moment. Stir in the grated Gouda and Gruy&egrave;re, reserving a handful for the topping. Watch it melt. Watch it become smooth and glossy and absolutely magnificent. Are you emotional? It&rsquo;s okay to be emotional. We cried the first time too. Season with salt and pepper.</li>
                        <li>Drain the pasta and fold it into the cheese sauce. Pour into a large ovenproof dish. Scatter the reserved cheese and breadcrumbs over the top, then drizzle with melted butter. It should look like a golden landscape of cheesy promise.</li>
                        <li>Bake for 20&ndash;25 minutes until the top is golden and crunchy and the sauce is bubbling round the edges. The smell at this point will be weapons-grade. Neighbours may appear uninvited. Let it rest for 5 minutes before serving, the hardest 5 minutes of your entire life.</li>
                    </ol>
                </section>

                <!-- Nutrition -->
                <section class="recipe-panel" p-ref="panel2" aria-label="Nutrition" hidden>
                    <h2 class="subsection-title">Nutrition (per serving)</h2>
                    <ul class="nutrition-list">
                            <li class="nutrition-row"><span class="nutrition-label">Calories</span><span class="nutrition-value">580 kcal</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Protein</span><span class="nutrition-value">24g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Fat</span><span class="nutrition-value">32g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Carbohydrates</span><span class="nutrition-value">52g</span></li>
                    </ul>
                </section>

                <!-- Reviews -->
                <section class="recipe-panel" p-ref="panel3" aria-label="Reviews" hidden>
                    <h2 class="subsection-title">Reviews</h2>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">MacAttack99</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Gouda gracious indeed! This is the creamiest, most flavourful mac and cheese I have ever made at home. The aged Gouda gives it such a rich, deep taste. My entire family fought over the last portion.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">CheeseNerd</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">The Gruy&egrave;re adds such depth to this dish. I was making basic cheddar mac and cheese for years and this has completely ruined me. I can never go back. The breadcrumb crust is perfection.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">FourCheesePhilosopher</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Recipe says three cheeses. I added a fourth. Then a fifth. Then I lost count. At some point it stopped being mac and cheese and became cheese with mac. My family staged an intervention. I told them they were welcome to leave. They stayed. They had seconds.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">EmotionalEater_xx</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">I cried watching the cheese melt. Real tears. Actual human tears rolling down my face as I watched three cheeses become one glorious sauce. My partner asked if I was alright. I said &ldquo;I have never been more alright.&rdquo; This recipe changed me as a person.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">WeekdayWarrior</strong>
                                <span class="stars" role="img" aria-label="4 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Made this on a Tuesday night. It is now Thursday. I have done nothing but eat mac and cheese and think about mac and cheese. I have called in sick to work. Not because I&rsquo;m ill, but because I made a second batch and someone needs to be here when it comes out of the oven.</p>

                            </div>
                        </m3e-card>

                    <m3e-card variant="filled" class="review-form">
                        <div class="card-pad--lg">
                            <h3 class="subsection-title">Leave a review</h3>
                        <form class="form-stack" p-ref="reviewForm" p-on:submit.prevent="submitReview">
                            <m3e-text-field variant="filled"
                                            label="Your name"
                                            name="name"
                                            supporting-text="How should we address you?"
                                            class="form-field"></m3e-text-field>

                            <m3e-text-field variant="filled"
                                            label="Your review"
                                            name="review"
                                            multiline
                                            rows="3"
                                            maxlength="500"
                                            supporting-text="500 characters max"
                                            class="form-field"></m3e-text-field>

                            <m3e-select variant="filled" label="Rating" name="rating" class="form-field">
                                    <m3e-menu-item value="5">5 - The mice approve!</m3e-menu-item>
                                    <m3e-menu-item value="4">4 - Gouda job!</m3e-menu-item>
                                    <m3e-menu-item value="3">3 - Not bad, not bad</m3e-menu-item>
                                    <m3e-menu-item value="2">2 - Needs more cheese</m3e-menu-item>
                                    <m3e-menu-item value="1">1 - Un-brie-lievably disappointing</m3e-menu-item>
                            </m3e-select>

                            <div class="form-actions form-actions--centre">
                                <m3e-button variant="filled" size="l" p-on:click="submitReview">Submit review</m3e-button>
                            </div>
                        </form>
                        </div>
                    </m3e-card>
                </section>
            </article>

            <!-- Squeak peek bottom sheet -->
            <m3e-bottom-sheet p-ref="tipsSheet" modal>
                <h2 class="subsection-title">Squeak peek: cooking tips</h2>
                <m3e-list>
                    <m3e-list-item>Aged Gouda has more flavour than young Gouda, so look for one that's been matured for at least 12 months for a deeper, more caramel-like taste.</m3e-list-item>
                    <m3e-list-item>Don't over-cook the pasta, because it finishes in the oven, so pull it while it's still slightly firm to avoid a mushy result.</m3e-list-item>
                    <m3e-list-item>A pinch of nutmeg is the secret weapon in any b&eacute;chamel. It rounds out the flavour beautifully without being identifiable.</m3e-list-item>
                </m3e-list>
            </m3e-bottom-sheet>

            <!-- Cheese fact dialog -->
            <m3e-dialog p-ref="cheeseFact" headline="Cheese fact!">
                <p class="prose">Gouda is named after the Dutch city where it was historically traded. It accounts for 50-60% of all cheese consumed worldwide.</p>
                <m3e-button variant="filled" slot="actions" p-on:click="closeCheeseFact">Gouda to know!</m3e-button>
            </m3e-dialog>

            <!-- Snackbar -->
            <m3e-snackbar p-ref="snackbar"></m3e-snackbar>

            <!-- Cooking timer FAB -->
            <m3e-tooltip text="Set a cooking timer" position="left">
                <m3e-fab colour="secondary" class="floating-fab" p-on:click="openTimer" aria-label="Set a cooking timer">
                    <piko:svg src="@/lib/icons/timer.svg" fill="currentColor" width="24" height="24"></piko:svg>
                </m3e-fab>
            </m3e-tooltip>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Gouda Gracious Mac & Cheese - The Norman Kitchen",
    }, nil
}
</script>

<script lang="ts">
    const BASE_SERVINGS = 6;

    let servings = BASE_SERVINGS;
    let imperial = false;

    /* -- Tab panels ------------------------------------------------------- */

    /** Shows the panel matching the tab the user activated. */
    function selectPanel(event: CustomEvent): void {
        const index = event.detail.index as number;

        for (let i = 0; i < 4; i++) {
            const panel = pk.refs['panel' + i] as HTMLElement | undefined;
            if (panel) panel.hidden = i !== index;
        }
    }

    /* -- Ingredient quantities -------------------------------------------- */

    /**
     * Metric to imperial conversions. Spoon measures are the same in both
     * systems, so they are left alone.
     */
    const CONVERSIONS: Record<string, { unit: string; factor: number }> = {
        g:  { unit: 'oz',    factor: 1 / 28.35 },
        kg: { unit: 'lb',    factor: 2.205 },
        ml: { unit: 'fl oz', factor: 1 / 28.41 },
        l:  { unit: 'pints', factor: 1.76 },
    };

    /** Rounds to a precision that reads naturally at the given magnitude. */
    function tidy(value: number): string {
        if (value >= 100) return String(Math.round(value / 5) * 5);
        if (value >= 10) return String(Math.round(value));
        return String(Math.round(value * 10) / 10);
    }

    /** Recomputes every ingredient quantity for the current servings and units. */
    function renderQuantities(): void {
        const root = pk.refs.ingredients as HTMLElement | undefined;
        if (!root) return;

        const scale = servings / BASE_SERVINGS;

        root.querySelectorAll<HTMLElement>('.qty').forEach((el) => {
            const base = parseFloat(el.dataset.base || '0');
            const unit = el.dataset.unit || '';
            let amount = base * scale;
            let label = unit;

            const conversion = imperial ? CONVERSIONS[unit] : undefined;
            if (conversion) {
                amount *= conversion.factor;
                label = conversion.unit;
            }

            el.textContent = label && label.length > 2
                ? tidy(amount) + ' ' + label
                : tidy(amount) + label;
        });
    }

    function changeServings(event: CustomEvent): void {
        servings = Number(event.detail.value);

        const readout = pk.refs.servingsValue as HTMLElement | undefined;
        if (readout) readout.textContent = String(servings);

        renderQuantities();
    }

    function toggleUnits(event: CustomEvent): void {
        imperial = Boolean(event.detail.checked);

        const label = pk.refs.unitLabel as HTMLElement | undefined;
        if (label) label.textContent = imperial ? 'Imperial' : 'Metric';

        renderQuantities();
    }

    /* -- Overlays --------------------------------------------------------- */

    function notify(message: string): void {
        const snackbar = pk.refs.snackbar as any;
        if (snackbar) snackbar.show(message);
    }

    function openTips(): void {
        const sheet = pk.refs.tipsSheet as any;
        if (sheet) sheet.show();
    }

    function closeCheeseFact(): void {
        const dialog = pk.refs.cheeseFact as any;
        if (dialog) dialog.close();
    }

    function openTimer(): void {
        notify('Timer feature coming soon! Melting in progress...');
    }

    /* -- Actions ---------------------------------------------------------- */

    function saveRecipe(): void {
        notify('Saved! This one is a keeper.');
    }

    function addToMealPlan(): void {
        notify('Added to your meal plan. Gouda choice!');
    }

    function shareRecipe(): void {
        notify('Link copied. Go on, spread the cheese.');
    }

    function printRecipe(): void {
        window.print();
    }

    function submitReview(): void {
        notify('Thanks! Your review is with the mice for approval.');
    }
</script>
