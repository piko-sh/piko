<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Brie-lliant Caesar Salad"
            server.current-page="recipes">

            <article class="page-section page-section--reading">
                <piko:img class="recipe-hero" src="@/lib/images/recipe-brie-lliant-caesar.jpg" alt="Brie-lliant Caesar Salad"></piko:img>

                <header class="mt-lg">
                    <h1 class="recipe-title">Brie-lliant Caesar Salad</h1>
                    <p class="recipe-pun">Brie-lieve us, this Caesar is different</p>

                    <div class="recipe-meta-row tag-row">
                        <span class="tag">Brie</span>
                        <span class="tag">15 mins</span>
                        <span class="tag">Easy</span>
                        <span class="tag">2 servings</span>
                    </div>

                    <div class="recipe-actions">
                        <m3e-split-button variant="filled" p-on:click="saveRecipe">
                            Save recipe
                            <m3e-menu-item slot="menu" p-on:select="addToMealPlan">Add to meal plan</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="shareRecipe">Share recipe</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="printRecipe">Print</m3e-menu-item>
                        </m3e-split-button>

                        <m3e-tooltip text="Add to favourites">
                            <m3e-icon-button toggle aria-label="Add to favourites">
                                <piko:svg src="@/lib/icons/favourite.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <m3e-tooltip text="Squeak peek: cooking tips">
                            <m3e-icon-button aria-label="Show cooking tips" p-on:click="openTips">
                                <piko:svg src="@/lib/icons/info.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <label class="switch-field">
                            <m3e-switch p-on:change="toggleUnits" aria-label="Use imperial measurements"></m3e-switch>
                            <span p-ref="unitLabel">Metric</span>
                        </label>
                    </div>
                </header>

                <m3e-tabs class="recipe-tabs" p-on:change="selectPanel">
                    <m3e-tab active>Ingredients</m3e-tab>
                    <m3e-tab>Method</m3e-tab>
                    <m3e-tab>Nutrition</m3e-tab>
                    <m3e-tab>Reviews (5)</m3e-tab>
                </m3e-tabs>

                <!-- Ingredients -->
                <section class="recipe-panel" p-ref="panel0" aria-label="Ingredients">
                    <div class="panel-header">
                        <h2 class="subsection-title">Ingredients</h2>
                        <div class="servings-control">
                            <span id="servings-label">Servings</span>
                            <m3e-slider class="servings-slider"
                                        discrete
                                        min="1"
                                        max="12"
                                        value="2"
                                        step="1"
                                        aria-labelledby="servings-label"
                                        p-on:change="changeServings"></m3e-slider>
                            <strong p-ref="servingsValue">2</strong>
                        </div>
                    </div>

                    <div p-ref="ingredients">
                        <m3e-list>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="2">2</span> heads romaine lettuce</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="150" data-unit="g">150g</span> brie cheese, cut into cubes</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="2">2</span> thick slices sourdough bread, cubed</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="30" data-unit="g">30g</span> parmesan, shaved</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="4">4</span> anchovy fillets</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="2">2</span> cloves garlic, minced</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Juice of 1 lemon</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="4" data-unit="tbsp">4 tbsp</span> extra virgin olive oil</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="1">1</span> egg yolk</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="1" data-unit="tsp">1 tsp</span> Dijon mustard</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="1" data-unit="tsp">1 tsp</span> Worcestershire sauce</span></m3e-list-item>
                        </m3e-list>
                    </div>
                </section>

                <!-- Method -->
                <section class="recipe-panel" p-ref="panel1" aria-label="Method" hidden>
                    <h2 class="subsection-title">Method</h2>
                    <ol class="step-list">
                        <li>Preheat the oven to 200&deg;C. Toss the bread cubes with a drizzle of olive oil and place on a baking tray. Top each cube with a small piece of brie. Now, before you put these in the oven, taste one piece of the brie to make sure it&rsquo;s good. Taste another one to confirm your findings. The scientific method demands a third sample. Right, into the oven for 8&ndash;10 minutes.</li>
                        <li>Prepare the dressing while the croutons bake: whisk together the egg yolk, minced garlic, anchovy fillets (mashed), lemon juice, Dijon mustard, and Worcestershire sauce. Slowly drizzle in the olive oil while whisking until emulsified. If it splits, don&rsquo;t panic. Panic makes it worse. Stay calm. Think of brie. Everything is going to be okay.</li>
                        <li>Wash the romaine lettuce thoroughly and pat dry. Tear into bite-sized pieces and put them in a big bowl. This is the one step where cheese isn&rsquo;t involved and honestly we find it rather boring. Let&rsquo;s move on.</li>
                        <li>Pour the dressing over the lettuce and toss. Add the warm brie croutons and... hold on. Is one of them missing? Did you eat one? We don&rsquo;t blame you. They came out of the oven all golden and melty and smelling like a French daydream. Make more croutons next time. You&rsquo;ll always eat one. Or four.</li>
                        <li>Serve immediately, topped with generous shavings of parmesan and a crack of black pepper. The brie croutons should still be warm and gooey inside, crispy outside, essentially everything you want to be when you grow up. Et voil&agrave;, a Caesar worthy of the mice&rsquo;s seal of approval.</li>
                    </ol>
                </section>

                <!-- Nutrition -->
                <section class="recipe-panel" p-ref="panel2" aria-label="Nutrition" hidden>
                    <h2 class="subsection-title">Nutrition (per serving)</h2>
                    <ul class="nutrition-list">
                            <li class="nutrition-row"><span class="nutrition-label">Calories</span><span class="nutrition-value">380 kcal</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Protein</span><span class="nutrition-value">18g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Fat</span><span class="nutrition-value">28g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Carbohydrates</span><span class="nutrition-value">16g</span></li>
                    </ul>
                </section>

                <!-- Reviews -->
                <section class="recipe-panel" p-ref="panel3" aria-label="Reviews" hidden>
                    <h2 class="subsection-title">Reviews</h2>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">SaladSorcerer</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Brie-lliant indeed! I was sceptical about brie in a Caesar, but the warm melted croutons completely won me over. This is my new go-to salad recipe.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">CroutonConnoisseur</strong>
                                <span class="stars" role="img" aria-label="4 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">The brie croutons are a game-changer. Crispy on the outside, oozy on the inside. I added some crispy bacon for extra indulgence, and I highly recommend it.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">SaladDenier</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">I don&rsquo;t eat salad. I have never eaten salad. I am morally opposed to salad. But I made this because of the brie and accidentally ate an entire lettuce. I feel betrayed by my own taste buds. Incredible recipe.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">BrieEmergency</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Recipe says &ldquo;200g brie.&rdquo; I used the whole wheel. Then I used another wheel. The salad was more brie than leaf. My guests said it was &ldquo;concerning.&rdquo; My guests are wrong.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">HealthyEatingGary</strong>
                                <span class="stars" role="img" aria-label="4 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">My nutritionist said I should eat more salad. I showed her a photo of this. She said &ldquo;that&rsquo;s not what I meant.&rdquo; She also asked for the recipe. Deducting one star because I now have to find a new nutritionist.</p>

                            </div>
                        </m3e-card>

                    <m3e-card variant="filled" class="review-form">
                        <div class="card-pad--lg">
                            <h3 class="subsection-title">Leave a review</h3>
                        <form class="form-stack" p-ref="reviewForm" p-on:submit.prevent="submitReview">
                            <m3e-text-field variant="filled"
                                            label="Your name"
                                            name="name"
                                            supporting-text="How should we address you?"
                                            class="form-field"></m3e-text-field>

                            <m3e-text-field variant="filled"
                                            label="Your review"
                                            name="review"
                                            multiline
                                            rows="3"
                                            maxlength="500"
                                            supporting-text="500 characters max"
                                            class="form-field"></m3e-text-field>

                            <m3e-select variant="filled" label="Rating" name="rating" class="form-field">
                                    <m3e-menu-item value="5">5 - The mice approve!</m3e-menu-item>
                                    <m3e-menu-item value="4">4 - Gouda job!</m3e-menu-item>
                                    <m3e-menu-item value="3">3 - Not bad, not bad</m3e-menu-item>
                                    <m3e-menu-item value="2">2 - Needs more cheese</m3e-menu-item>
                                    <m3e-menu-item value="1">1 - Un-brie-lievably disappointing</m3e-menu-item>
                            </m3e-select>

                            <div class="form-actions form-actions--centre">
                                <m3e-button variant="filled" size="l" p-on:click="submitReview">Submit review</m3e-button>
                            </div>
                        </form>
                        </div>
                    </m3e-card>
                </section>
            </article>

            <!-- Squeak peek bottom sheet -->
            <m3e-bottom-sheet p-ref="tipsSheet" modal>
                <h2 class="subsection-title">Squeak peek: cooking tips</h2>
                <m3e-list>
                    <m3e-list-item>Use ripe brie for maximum meltiness. If it's still firm in the centre, it needs a few more days at room temperature.</m3e-list-item>
                    <m3e-list-item>Make the dressing ahead of time for a deeper flavour. It keeps in the fridge for up to two days and only gets better.</m3e-list-item>
                </m3e-list>
            </m3e-bottom-sheet>

            <!-- Cheese fact dialog -->
            <m3e-dialog p-ref="cheeseFact" headline="Cheese fact!">
                <p class="prose">Brie de Meaux was crowned 'King of Cheeses' at a cheese competition in 1815 - but we reckon Camembert gives it a run for its money.</p>
                <m3e-button variant="filled" slot="actions" p-on:click="closeCheeseFact">Gouda to know!</m3e-button>
            </m3e-dialog>

            <!-- Snackbar -->
            <m3e-snackbar p-ref="snackbar"></m3e-snackbar>

            <!-- Cooking timer FAB -->
            <m3e-tooltip text="Set a cooking timer" position="left">
                <m3e-fab colour="secondary" class="floating-fab" p-on:click="openTimer" aria-label="Set a cooking timer">
                    <piko:svg src="@/lib/icons/timer.svg" fill="currentColor" width="24" height="24"></piko:svg>
                </m3e-fab>
            </m3e-tooltip>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Brie-lliant Caesar Salad - The Norman Kitchen",
    }, nil
}
</script>

<script lang="ts">
    const BASE_SERVINGS = 2;

    let servings = BASE_SERVINGS;
    let imperial = false;

    /* -- Tab panels ------------------------------------------------------- */

    /** Shows the panel matching the tab the user activated. */
    function selectPanel(event: CustomEvent): void {
        const index = event.detail.index as number;

        for (let i = 0; i < 4; i++) {
            const panel = pk.refs['panel' + i] as HTMLElement | undefined;
            if (panel) panel.hidden = i !== index;
        }
    }

    /* -- Ingredient quantities -------------------------------------------- */

    /**
     * Metric to imperial conversions. Spoon measures are the same in both
     * systems, so they are left alone.
     */
    const CONVERSIONS: Record<string, { unit: string; factor: number }> = {
        g:  { unit: 'oz',    factor: 1 / 28.35 },
        kg: { unit: 'lb',    factor: 2.205 },
        ml: { unit: 'fl oz', factor: 1 / 28.41 },
        l:  { unit: 'pints', factor: 1.76 },
    };

    /** Rounds to a precision that reads naturally at the given magnitude. */
    function tidy(value: number): string {
        if (value >= 100) return String(Math.round(value / 5) * 5);
        if (value >= 10) return String(Math.round(value));
        return String(Math.round(value * 10) / 10);
    }

    /** Recomputes every ingredient quantity for the current servings and units. */
    function renderQuantities(): void {
        const root = pk.refs.ingredients as HTMLElement | undefined;
        if (!root) return;

        const scale = servings / BASE_SERVINGS;

        root.querySelectorAll<HTMLElement>('.qty').forEach((el) => {
            const base = parseFloat(el.dataset.base || '0');
            const unit = el.dataset.unit || '';
            let amount = base * scale;
            let label = unit;

            const conversion = imperial ? CONVERSIONS[unit] : undefined;
            if (conversion) {
                amount *= conversion.factor;
                label = conversion.unit;
            }

            el.textContent = label && label.length > 2
                ? tidy(amount) + ' ' + label
                : tidy(amount) + label;
        });
    }

    function changeServings(event: CustomEvent): void {
        servings = Number(event.detail.value);

        const readout = pk.refs.servingsValue as HTMLElement | undefined;
        if (readout) readout.textContent = String(servings);

        renderQuantities();
    }

    function toggleUnits(event: CustomEvent): void {
        imperial = Boolean(event.detail.checked);

        const label = pk.refs.unitLabel as HTMLElement | undefined;
        if (label) label.textContent = imperial ? 'Imperial' : 'Metric';

        renderQuantities();
    }

    /* -- Overlays --------------------------------------------------------- */

    function notify(message: string): void {
        const snackbar = pk.refs.snackbar as any;
        if (snackbar) snackbar.show(message);
    }

    function openTips(): void {
        const sheet = pk.refs.tipsSheet as any;
        if (sheet) sheet.show();
    }

    function closeCheeseFact(): void {
        const dialog = pk.refs.cheeseFact as any;
        if (dialog) dialog.close();
    }

    function openTimer(): void {
        notify('Timer feature coming soon! Melting in progress...');
    }

    /* -- Actions ---------------------------------------------------------- */

    function saveRecipe(): void {
        notify('Saved! This one is a keeper.');
    }

    function addToMealPlan(): void {
        notify('Added to your meal plan. Gouda choice!');
    }

    function shareRecipe(): void {
        notify('Link copied. Go on, spread the cheese.');
    }

    function printRecipe(): void {
        window.print();
    }

    function submitReview(): void {
        notify('Thanks! Your review is with the mice for approval.');
    }
</script>
