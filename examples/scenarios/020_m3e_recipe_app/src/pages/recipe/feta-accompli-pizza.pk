<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Feta Accompli Pizza"
            server.current-page="recipes">

            <article class="page-section page-section--reading">
                <piko:img class="recipe-hero" src="@/lib/images/recipe-feta-accompli-pizza.jpg" alt="Feta Accompli Pizza"></piko:img>

                <header class="mt-lg">
                    <h1 class="recipe-title">Feta Accompli Pizza</h1>
                    <p class="recipe-pun">Consider it a feta accompli</p>

                    <div class="recipe-meta-row tag-row">
                        <span class="tag">Feta + Mozzarella</span>
                        <span class="tag">30 mins (plus dough resting)</span>
                        <span class="tag">Medium</span>
                        <span class="tag">4 servings</span>
                    </div>

                    <div class="recipe-actions">
                        <m3e-split-button variant="filled" p-on:click="saveRecipe">
                            Save recipe
                            <m3e-menu-item slot="menu" p-on:select="addToMealPlan">Add to meal plan</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="shareRecipe">Share recipe</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="printRecipe">Print</m3e-menu-item>
                        </m3e-split-button>

                        <m3e-tooltip text="Add to favourites">
                            <m3e-icon-button toggle aria-label="Add to favourites">
                                <piko:svg src="@/lib/icons/favourite.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <m3e-tooltip text="Squeak peek: cooking tips">
                            <m3e-icon-button aria-label="Show cooking tips" p-on:click="openTips">
                                <piko:svg src="@/lib/icons/info.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <label class="switch-field">
                            <m3e-switch p-on:change="toggleUnits" aria-label="Use imperial measurements"></m3e-switch>
                            <span p-ref="unitLabel">Metric</span>
                        </label>
                    </div>
                </header>

                <m3e-tabs class="recipe-tabs" p-on:change="selectPanel">
                    <m3e-tab active>Ingredients</m3e-tab>
                    <m3e-tab>Method</m3e-tab>
                    <m3e-tab>Nutrition</m3e-tab>
                    <m3e-tab>Reviews (6)</m3e-tab>
                </m3e-tabs>

                <!-- Ingredients -->
                <section class="recipe-panel" p-ref="panel0" aria-label="Ingredients">
                    <div class="panel-header">
                        <h2 class="subsection-title">Ingredients</h2>
                        <div class="servings-control">
                            <span id="servings-label">Servings</span>
                            <m3e-slider class="servings-slider"
                                        discrete
                                        min="1"
                                        max="12"
                                        value="4"
                                        step="1"
                                        aria-labelledby="servings-label"
                                        p-on:change="changeServings"></m3e-slider>
                            <strong p-ref="servingsValue">4</strong>
                        </div>
                    </div>

                    <div p-ref="ingredients">
                        <m3e-list>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="500" data-unit="g">500g</span> pizza dough (or make your own)</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="400" data-unit="g">400g</span> tin San Marzano tomatoes</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="250" data-unit="g">250g</span> fresh mozzarella, torn into pieces</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="150" data-unit="g">150g</span> feta cheese, crumbled</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Handful of fresh basil leaves</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="2" data-unit="tbsp">2 tbsp</span> extra virgin olive oil</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="2">2</span> cloves garlic, minced</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="1" data-unit="tsp">1 tsp</span> dried oregano</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Salt, to taste</span></m3e-list-item>
                        </m3e-list>
                    </div>
                </section>

                <!-- Method -->
                <section class="recipe-panel" p-ref="panel1" aria-label="Method" hidden>
                    <h2 class="subsection-title">Method</h2>
                    <ol class="step-list">
                        <li>If using shop-bought dough, bring it to room temperature for at least 30 minutes. If making your own, allow the dough to prove until doubled in size. While you wait, open the feta. Just to check it&rsquo;s still there. It is? Good. Have a small piece. For quality control purposes.</li>
                        <li>For the sauce, crush the San Marzano tomatoes by hand into a bowl. Yes, by hand. You&rsquo;re a pizza artisan now, act like one. Stir in the minced garlic, oregano, a glug of olive oil, and a pinch of salt. No cooking required. The Italians would respect your restraint. The mice certainly do.</li>
                        <li>Preheat your oven to the highest setting (ideally 250&deg;C or higher, because we&rsquo;re making pizza, not gently warming a dormouse). If you have a pizza stone, put it in now. On a floured surface, stretch the dough into rounds using your hands. No rolling pins! Rolling pins are for pastry. This is pizza. Have some respect.</li>
                        <li>Spread a thin layer of sauce over each base, leaving a 2cm border. Scatter torn mozzarella across the surface, then crumble feta over the top in uneven chunks. The unevenness is important, because you want little surprise pockets of tangy feta. It&rsquo;s like a treasure hunt, but the treasure is always cheese, which is the best kind of treasure hunt.</li>
                        <li>Slide the pizza onto the hot stone (or a baking tray, we won&rsquo;t tell the Italians) and bake for 8&ndash;12 minutes. You&rsquo;ll know it&rsquo;s done when the crust is puffed and charred in spots, the mozzarella is doing that gorgeous bubbling thing, and the feta has gone golden. Your kitchen should smell unreasonably good at this point.</li>
                        <li>Remove from the oven, scatter with fresh basil and a drizzle of olive oil. Now, and this is critical, you must eat it immediately. Not in five minutes. Not after you&rsquo;ve instagrammed it. NOW. Pizza waits for no mouse, and neither does melted feta.</li>
                    </ol>
                </section>

                <!-- Nutrition -->
                <section class="recipe-panel" p-ref="panel2" aria-label="Nutrition" hidden>
                    <h2 class="subsection-title">Nutrition (per serving)</h2>
                    <ul class="nutrition-list">
                            <li class="nutrition-row"><span class="nutrition-label">Calories</span><span class="nutrition-value">420 kcal</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Protein</span><span class="nutrition-value">22g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Fat</span><span class="nutrition-value">18g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Carbohydrates</span><span class="nutrition-value">48g</span></li>
                    </ul>
                </section>

                <!-- Reviews -->
                <section class="recipe-panel" p-ref="panel3" aria-label="Reviews" hidden>
                    <h2 class="subsection-title">Reviews</h2>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">PizzaPilgrim</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">This pizza is to die for! The combination of creamy mozzarella and tangy feta is absolutely divine. I've been making this every Friday night and the family demands it now.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">DoughDreamer</strong>
                                <span class="stars" role="img" aria-label="4 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Feta-stic combo! The tip about crumbling the feta unevenly was spot on, and you get these amazing pockets of salty, tangy cheese throughout. Will definitely make again.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">BasilBandit</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Best homemade pizza ever. The San Marzano sauce is so simple but so flavourful. I added a drizzle of honey at the end for a sweet-salty contrast and it was phenomenal.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">FetaAddiction2024</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Ate all the feta while making the pizza. Went to the shop. Bought more feta. Ate that too. Third trip to the shop the cashier asked if I was okay. I was not okay. I was magnificent. Fourth batch of feta made it onto the pizza. Best Friday ever.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">ItalianNonna</strong>
                                <span class="stars" role="img" aria-label="3 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Feta on pizza? My grandmother is rolling in her grave. I made it anyway. My grandmother would have loved it. I am now also rolling: rolling out more dough for round two. Nonna forgive me.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">WhitePizzaGhost</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">I added so much feta the pizza was entirely white. You couldn&rsquo;t see the sauce. You couldn&rsquo;t see the dough. It was just a flat disc of feta. My flatmate asked me why I was eating &ldquo;a cheese frisbee.&rdquo; I regret nothing.</p>

                            </div>
                        </m3e-card>

                    <m3e-card variant="filled" class="review-form">
                        <div class="card-pad--lg">
                            <h3 class="subsection-title">Leave a review</h3>
                        <form class="form-stack" p-ref="reviewForm" p-on:submit.prevent="submitReview">
                            <m3e-text-field variant="filled"
                                            label="Your name"
                                            name="name"
                                            supporting-text="How should we address you?"
                                            class="form-field"></m3e-text-field>

                            <m3e-text-field variant="filled"
                                            label="Your review"
                                            name="review"
                                            multiline
                                            rows="3"
                                            maxlength="500"
                                            supporting-text="500 characters max"
                                            class="form-field"></m3e-text-field>

                            <m3e-select variant="filled" label="Rating" name="rating" class="form-field">
                                    <m3e-menu-item value="5">5 - The mice approve!</m3e-menu-item>
                                    <m3e-menu-item value="4">4 - Gouda job!</m3e-menu-item>
                                    <m3e-menu-item value="3">3 - Not bad, not bad</m3e-menu-item>
                                    <m3e-menu-item value="2">2 - Needs more cheese</m3e-menu-item>
                                    <m3e-menu-item value="1">1 - Un-brie-lievably disappointing</m3e-menu-item>
                            </m3e-select>

                            <div class="form-actions form-actions--centre">
                                <m3e-button variant="filled" size="l" p-on:click="submitReview">Submit review</m3e-button>
                            </div>
                        </form>
                        </div>
                    </m3e-card>
                </section>
            </article>

            <!-- Squeak peek bottom sheet -->
            <m3e-bottom-sheet p-ref="tipsSheet" modal>
                <h2 class="subsection-title">Squeak peek: cooking tips</h2>
                <m3e-list>
                    <m3e-list-item>Preheat your oven as hot as it'll go. A screaming hot oven is the secret to a crispy, blistered crust.</m3e-list-item>
                    <m3e-list-item>Use a pizza stone if you have one. It absorbs moisture from the dough and gives you that authentic pizzeria base.</m3e-list-item>
                    <m3e-list-item>Crumble the feta unevenly for pockets of flavour. Uniform distribution is the enemy of interesting pizza.</m3e-list-item>
                </m3e-list>
            </m3e-bottom-sheet>

            <!-- Cheese fact dialog -->
            <m3e-dialog p-ref="cheeseFact" headline="Cheese fact!">
                <p class="prose">Feta must by law be made in Greece and contain at least 70% sheep's milk to be called 'feta'. Everything else is just 'white cheese'.</p>
                <m3e-button variant="filled" slot="actions" p-on:click="closeCheeseFact">Gouda to know!</m3e-button>
            </m3e-dialog>

            <!-- Snackbar -->
            <m3e-snackbar p-ref="snackbar"></m3e-snackbar>

            <!-- Cooking timer FAB -->
            <m3e-tooltip text="Set a cooking timer" position="left">
                <m3e-fab colour="secondary" class="floating-fab" p-on:click="openTimer" aria-label="Set a cooking timer">
                    <piko:svg src="@/lib/icons/timer.svg" fill="currentColor" width="24" height="24"></piko:svg>
                </m3e-fab>
            </m3e-tooltip>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Feta Accompli Pizza - The Norman Kitchen",
    }, nil
}
</script>

<script lang="ts">
    const BASE_SERVINGS = 4;

    let servings = BASE_SERVINGS;
    let imperial = false;

    /* -- Tab panels ------------------------------------------------------- */

    /** Shows the panel matching the tab the user activated. */
    function selectPanel(event: CustomEvent): void {
        const index = event.detail.index as number;

        for (let i = 0; i < 4; i++) {
            const panel = pk.refs['panel' + i] as HTMLElement | undefined;
            if (panel) panel.hidden = i !== index;
        }
    }

    /* -- Ingredient quantities -------------------------------------------- */

    /**
     * Metric to imperial conversions. Spoon measures are the same in both
     * systems, so they are left alone.
     */
    const CONVERSIONS: Record<string, { unit: string; factor: number }> = {
        g:  { unit: 'oz',    factor: 1 / 28.35 },
        kg: { unit: 'lb',    factor: 2.205 },
        ml: { unit: 'fl oz', factor: 1 / 28.41 },
        l:  { unit: 'pints', factor: 1.76 },
    };

    /** Rounds to a precision that reads naturally at the given magnitude. */
    function tidy(value: number): string {
        if (value >= 100) return String(Math.round(value / 5) * 5);
        if (value >= 10) return String(Math.round(value));
        return String(Math.round(value * 10) / 10);
    }

    /** Recomputes every ingredient quantity for the current servings and units. */
    function renderQuantities(): void {
        const root = pk.refs.ingredients as HTMLElement | undefined;
        if (!root) return;

        const scale = servings / BASE_SERVINGS;

        root.querySelectorAll<HTMLElement>('.qty').forEach((el) => {
            const base = parseFloat(el.dataset.base || '0');
            const unit = el.dataset.unit || '';
            let amount = base * scale;
            let label = unit;

            const conversion = imperial ? CONVERSIONS[unit] : undefined;
            if (conversion) {
                amount *= conversion.factor;
                label = conversion.unit;
            }

            el.textContent = label && label.length > 2
                ? tidy(amount) + ' ' + label
                : tidy(amount) + label;
        });
    }

    function changeServings(event: CustomEvent): void {
        servings = Number(event.detail.value);

        const readout = pk.refs.servingsValue as HTMLElement | undefined;
        if (readout) readout.textContent = String(servings);

        renderQuantities();
    }

    function toggleUnits(event: CustomEvent): void {
        imperial = Boolean(event.detail.checked);

        const label = pk.refs.unitLabel as HTMLElement | undefined;
        if (label) label.textContent = imperial ? 'Imperial' : 'Metric';

        renderQuantities();
    }

    /* -- Overlays --------------------------------------------------------- */

    function notify(message: string): void {
        const snackbar = pk.refs.snackbar as any;
        if (snackbar) snackbar.show(message);
    }

    function openTips(): void {
        const sheet = pk.refs.tipsSheet as any;
        if (sheet) sheet.show();
    }

    function closeCheeseFact(): void {
        const dialog = pk.refs.cheeseFact as any;
        if (dialog) dialog.close();
    }

    function openTimer(): void {
        notify('Timer feature coming soon! Melting in progress...');
    }

    /* -- Actions ---------------------------------------------------------- */

    function saveRecipe(): void {
        notify('Saved! This one is a keeper.');
    }

    function addToMealPlan(): void {
        notify('Added to your meal plan. Gouda choice!');
    }

    function shareRecipe(): void {
        notify('Link copied. Go on, spread the cheese.');
    }

    function printRecipe(): void {
        window.print();
    }

    function submitReview(): void {
        notify('Thanks! Your review is with the mice for approval.');
    }
</script>
