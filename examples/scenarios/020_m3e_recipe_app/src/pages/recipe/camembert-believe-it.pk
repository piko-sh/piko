                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Camembert believe how easy this is! Five ingredients, twenty minutes, and you've got the most impressive starter going. My guests thought I'd spent hours in the kitchen.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">NormandyNomad</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
