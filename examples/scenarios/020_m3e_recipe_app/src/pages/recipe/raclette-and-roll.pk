<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Raclette & Roll"
            server.current-page="recipes">

            <article class="page-section page-section--reading">
                <piko:img class="recipe-hero" src="@/lib/images/recipe-raclette-and-roll.jpg" alt="Raclette &amp; Roll"></piko:img>

                <header class="mt-lg">
                    <h1 class="recipe-title">Raclette &amp; Roll</h1>
                    <p class="recipe-pun">Ready to raclette and roll!</p>

                    <div class="recipe-meta-row tag-row">
                        <span class="tag">Raclette</span>
                        <span class="tag">40 mins</span>
                        <span class="tag">Medium</span>
                        <span class="tag">4 servings</span>
                    </div>

                    <div class="recipe-actions">
                        <m3e-split-button variant="filled" p-on:click="saveRecipe">
                            Save recipe
                            <m3e-menu-item slot="menu" p-on:select="addToMealPlan">Add to meal plan</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="shareRecipe">Share recipe</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="printRecipe">Print</m3e-menu-item>
                        </m3e-split-button>

                        <m3e-tooltip text="Add to favourites">
                            <m3e-icon-button toggle aria-label="Add to favourites">
                                <piko:svg src="@/lib/icons/favourite.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <m3e-tooltip text="Squeak peek: cooking tips">
                            <m3e-icon-button aria-label="Show cooking tips" p-on:click="openTips">
                                <piko:svg src="@/lib/icons/info.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <label class="switch-field">
                            <m3e-switch p-on:change="toggleUnits" aria-label="Use imperial measurements"></m3e-switch>
                            <span p-ref="unitLabel">Metric</span>
                        </label>
                    </div>
                </header>

                <m3e-tabs class="recipe-tabs" p-on:change="selectPanel">
                    <m3e-tab active>Ingredients</m3e-tab>
                    <m3e-tab>Method</m3e-tab>
                    <m3e-tab>Nutrition</m3e-tab>
                    <m3e-tab>Reviews (5)</m3e-tab>
                </m3e-tabs>

                <!-- Ingredients -->
                <section class="recipe-panel" p-ref="panel0" aria-label="Ingredients">
                    <div class="panel-header">
                        <h2 class="subsection-title">Ingredients</h2>
                        <div class="servings-control">
                            <span id="servings-label">Servings</span>
                            <m3e-slider class="servings-slider"
                                        discrete
                                        min="1"
                                        max="12"
                                        value="4"
                                        step="1"
                                        aria-labelledby="servings-label"
                                        p-on:change="changeServings"></m3e-slider>
                            <strong p-ref="servingsValue">4</strong>
                        </div>
                    </div>

                    <div p-ref="ingredients">
                        <m3e-list>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="400" data-unit="g">400g</span> raclette cheese (half wheel or sliced)</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="800" data-unit="g">800g</span> baby potatoes</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">A handful of cornichons</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="12">12</span> pickled onions</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="100" data-unit="g">100g</span> bresaola, thinly sliced</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="100" data-unit="g">100g</span> coppa, thinly sliced</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="200" data-unit="g">200g</span> cherry tomatoes</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">A large handful of mixed salad leaves</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Freshly ground black pepper</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">A pinch of freshly grated nutmeg</span></m3e-list-item>
                        </m3e-list>
                    </div>
                </section>

                <!-- Method -->
                <section class="recipe-panel" p-ref="panel1" aria-label="Method" hidden>
                    <h2 class="subsection-title">Method</h2>
                    <ol class="step-list">
                        <li>Place the baby potatoes in a large pan of salted water. Bring to the boil and cook for 15&ndash;20 minutes until tender. While you wait, unwrap the raclette. Breathe it in. Yes, it&rsquo;s pungent. Yes, your housemates may complain. This is the smell of Alpine greatness. They&rsquo;ll thank you in 20 minutes.</li>
                        <li>Slice the raclette into pieces about 5mm thick. Now here is where things go wrong for most people. You slice a piece. You look at it. It&rsquo;s just sitting there. You eat it. You slice another. You eat that too. Suddenly you&rsquo;ve eaten half the cheese and your guests are arriving in ten minutes. DO NOT PANIC. Slice faster. Hide the evidence. If the worst happens, you can shave some parmesan or IKEA furniture and claim it&rsquo;s &ldquo;a modern interpretation.&rdquo; Or just own it and order more cheese. We won&rsquo;t tell.</li>
                        <li>If using a raclette grill, heat it up per the manufacturer&rsquo;s instructions. If you don&rsquo;t have one (and honestly, it should be a legal requirement), preheat the oven grill to high with a cast iron pan on the middle shelf. Cast iron is the next best thing to a proper Swiss mountain setup.</li>
                        <li>Place the raclette slices in the pans (or cast iron). Melt for 3&ndash;4 minutes until bubbling and golden at the edges. The moment the cheese starts to bubble, you will understand why the Swiss have been doing this for centuries. This is not cooking. This is a religious experience.</li>
                        <li>Scrape (SCRAPE!) the molten cheese over the warm potatoes. The scraping is half the fun. Season with black pepper and a pinch of nutmeg. If cheese falls on the table during scraping, that is the chef&rsquo;s portion and you are honour-bound to eat it immediately.</li>
                        <li>Arrange the accompaniments on a big board: cornichons, pickled onions, bresaola, coppa, tomatoes, and salad leaves. Put it in the middle of the table. Keep melting more cheese. Raclette isn&rsquo;t a meal, it&rsquo;s a lifestyle. The evening ends when the cheese runs out, and the cheese should never run out. Buy more cheese than you think you need. Then buy more. You&rsquo;re welcome.</li>
                    </ol>
                </section>

                <!-- Nutrition -->
                <section class="recipe-panel" p-ref="panel2" aria-label="Nutrition" hidden>
                    <h2 class="subsection-title">Nutrition (per serving)</h2>
                    <ul class="nutrition-list">
                            <li class="nutrition-row"><span class="nutrition-label">Calories</span><span class="nutrition-value">480 kcal</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Protein</span><span class="nutrition-value">28g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Fat</span><span class="nutrition-value">30g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Carbohydrates</span><span class="nutrition-value">26g</span></li>
                    </ul>
                </section>

                <!-- Reviews -->
                <section class="recipe-panel" p-ref="panel3" aria-label="Reviews" hidden>
                    <h2 class="subsection-title">Reviews</h2>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">AlpineAppetite</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Raclette night is the best night! We've started doing this every Friday, and it's become a proper tradition. The smell fills the whole house and everyone crowds round the table.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">SwissMissCheeseKiss</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">So communal and fun, and the whole table was involved. Even the kids got in on the action, scraping their own cheese. It's less of a recipe and more of an experience.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">RacletteRegret</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Ate half the raclette while slicing it for the grill. Panicked. Guests arriving in 10 minutes. Considered shaving the IKEA bookshelf. Sent my partner on an emergency cheese run. They came back with Edam. EDAM. We are now in couples therapy. The raclette (what was left of it) was incredible.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">ThreeGrillsDeep</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Bought a raclette grill after making this. Then a second one because the first one was too small. Then a third because &ldquo;what if we have people over.&rdquo; We have not had people over. It is just me. With three raclette grills. I am living my best life.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">SmellComplaint</strong>
                                <span class="stars" role="img" aria-label="4 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">The smell. Oh god the smell. My neighbours knocked on the door and asked if everything was alright. Then they smelled it properly. Then they sat down. Then they stayed for dinner. Then they bought their own raclette grill. Minus one star because I can still smell it three days later and I&rsquo;ve opened every window in the house.</p>

                            </div>
                        </m3e-card>

                    <m3e-card variant="filled" class="review-form">
                        <div class="card-pad--lg">
                            <h3 class="subsection-title">Leave a review</h3>
                        <form class="form-stack" p-ref="reviewForm" p-on:submit.prevent="submitReview">
                            <m3e-text-field variant="filled"
                                            label="Your name"
                                            name="name"
                                            supporting-text="How should we address you?"
                                            class="form-field"></m3e-text-field>

                            <m3e-text-field variant="filled"
                                            label="Your review"
                                            name="review"
                                            multiline
                                            rows="3"
                                            maxlength="500"
                                            supporting-text="500 characters max"
                                            class="form-field"></m3e-text-field>

                            <m3e-select variant="filled" label="Rating" name="rating" class="form-field">
                                    <m3e-menu-item value="5">5 - The mice approve!</m3e-menu-item>
                                    <m3e-menu-item value="4">4 - Gouda job!</m3e-menu-item>
                                    <m3e-menu-item value="3">3 - Not bad, not bad</m3e-menu-item>
                                    <m3e-menu-item value="2">2 - Needs more cheese</m3e-menu-item>
                                    <m3e-menu-item value="1">1 - Un-brie-lievably disappointing</m3e-menu-item>
                            </m3e-select>

                            <div class="form-actions form-actions--centre">
                                <m3e-button variant="filled" size="l" p-on:click="submitReview">Submit review</m3e-button>
                            </div>
                        </form>
                        </div>
                    </m3e-card>
                </section>
            </article>

            <!-- Squeak peek bottom sheet -->
            <m3e-bottom-sheet p-ref="tipsSheet" modal>
                <h2 class="subsection-title">Squeak peek: cooking tips</h2>
                <m3e-list>
                    <m3e-list-item>If you don't have a raclette grill, use your oven's grill setting with a cast iron pan. Place the cheese slices in the pan and grill for 3&ndash;4 minutes until bubbling.</m3e-list-item>
                    <m3e-list-item>Pre-boil the potatoes and keep them warm in foil. Cold potatoes and hot cheese is a disappointing combination, so you want everything warm.</m3e-list-item>
                    <m3e-list-item>The smell is strong but the taste is heavenly. Open a window if you must, but don't let it put you off, because this is one of the greatest cheese experiences on earth.</m3e-list-item>
                </m3e-list>
            </m3e-bottom-sheet>

            <!-- Cheese fact dialog -->
            <m3e-dialog p-ref="cheeseFact" headline="Cheese fact!">
                <p class="prose">Raclette comes from the French word 'racler' meaning 'to scrape'. Swiss shepherds would melt cheese by the fire and scrape it onto bread: the original cheese pull.</p>
                <m3e-button variant="filled" slot="actions" p-on:click="closeCheeseFact">Gouda to know!</m3e-button>
            </m3e-dialog>

            <!-- Snackbar -->
            <m3e-snackbar p-ref="snackbar"></m3e-snackbar>

            <!-- Cooking timer FAB -->
            <m3e-tooltip text="Set a cooking timer" position="left">
                <m3e-fab colour="secondary" class="floating-fab" p-on:click="openTimer" aria-label="Set a cooking timer">
                    <piko:svg src="@/lib/icons/timer.svg" fill="currentColor" width="24" height="24"></piko:svg>
                </m3e-fab>
            </m3e-tooltip>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Raclette & Roll - The Norman Kitchen",
    }, nil
}
</script>

<script lang="ts">
    const BASE_SERVINGS = 4;

    let servings = BASE_SERVINGS;
    let imperial = false;

    /* -- Tab panels ------------------------------------------------------- */

    /** Shows the panel matching the tab the user activated. */
    function selectPanel(event: CustomEvent): void {
        const index = event.detail.index as number;

        for (let i = 0; i < 4; i++) {
            const panel = pk.refs['panel' + i] as HTMLElement | undefined;
            if (panel) panel.hidden = i !== index;
        }
    }

    /* -- Ingredient quantities -------------------------------------------- */

    /**
     * Metric to imperial conversions. Spoon measures are the same in both
     * systems, so they are left alone.
     */
    const CONVERSIONS: Record<string, { unit: string; factor: number }> = {
        g:  { unit: 'oz',    factor: 1 / 28.35 },
        kg: { unit: 'lb',    factor: 2.205 },
        ml: { unit: 'fl oz', factor: 1 / 28.41 },
        l:  { unit: 'pints', factor: 1.76 },
    };

    /** Rounds to a precision that reads naturally at the given magnitude. */
    function tidy(value: number): string {
        if (value >= 100) return String(Math.round(value / 5) * 5);
        if (value >= 10) return String(Math.round(value));
        return String(Math.round(value * 10) / 10);
    }

    /** Recomputes every ingredient quantity for the current servings and units. */
    function renderQuantities(): void {
        const root = pk.refs.ingredients as HTMLElement | undefined;
        if (!root) return;

        const scale = servings / BASE_SERVINGS;

        root.querySelectorAll<HTMLElement>('.qty').forEach((el) => {
            const base = parseFloat(el.dataset.base || '0');
            const unit = el.dataset.unit || '';
            let amount = base * scale;
            let label = unit;

            const conversion = imperial ? CONVERSIONS[unit] : undefined;
            if (conversion) {
                amount *= conversion.factor;
                label = conversion.unit;
            }

            el.textContent = label && label.length > 2
                ? tidy(amount) + ' ' + label
                : tidy(amount) + label;
        });
    }

    function changeServings(event: CustomEvent): void {
        servings = Number(event.detail.value);

        const readout = pk.refs.servingsValue as HTMLElement | undefined;
        if (readout) readout.textContent = String(servings);

        renderQuantities();
    }

    function toggleUnits(event: CustomEvent): void {
        imperial = Boolean(event.detail.checked);

        const label = pk.refs.unitLabel as HTMLElement | undefined;
        if (label) label.textContent = imperial ? 'Imperial' : 'Metric';

        renderQuantities();
    }

    /* -- Overlays --------------------------------------------------------- */

    function notify(message: string): void {
        const snackbar = pk.refs.snackbar as any;
        if (snackbar) snackbar.show(message);
    }

    function openTips(): void {
        const sheet = pk.refs.tipsSheet as any;
        if (sheet) sheet.show();
    }

    function closeCheeseFact(): void {
        const dialog = pk.refs.cheeseFact as any;
        if (dialog) dialog.close();
    }

    function openTimer(): void {
        notify('Timer feature coming soon! Melting in progress...');
    }

    /* -- Actions ---------------------------------------------------------- */

    function saveRecipe(): void {
        notify('Saved! This one is a keeper.');
    }

    function addToMealPlan(): void {
        notify('Added to your meal plan. Gouda choice!');
    }

    function shareRecipe(): void {
        notify('Link copied. Go on, spread the cheese.');
    }

    function printRecipe(): void {
        window.print();
    }

    function submitReview(): void {
        notify('Thanks! Your review is with the mice for approval.');
    }
</script>
