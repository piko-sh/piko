<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Parm-ageddon Chicken"
            server.current-page="recipes">

            <article class="page-section page-section--reading">
                <piko:img class="recipe-hero" src="@/lib/images/recipe-parm-ageddon-chicken.jpg" alt="Parm-ageddon Chicken"></piko:img>

                <header class="mt-lg">
                    <h1 class="recipe-title">Parm-ageddon Chicken</h1>
                    <p class="recipe-pun">Parm-ageddon is here, and it's delicious</p>

                    <div class="recipe-meta-row tag-row">
                        <span class="tag">Parmesan + Mozzarella</span>
                        <span class="tag">45 mins</span>
                        <span class="tag">Medium</span>
                        <span class="tag">4 servings</span>
                    </div>

                    <div class="recipe-actions">
                        <m3e-split-button variant="filled" p-on:click="saveRecipe">
                            Save recipe
                            <m3e-menu-item slot="menu" p-on:select="addToMealPlan">Add to meal plan</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="shareRecipe">Share recipe</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="printRecipe">Print</m3e-menu-item>
                        </m3e-split-button>

                        <m3e-tooltip text="Add to favourites">
                            <m3e-icon-button toggle aria-label="Add to favourites">
                                <piko:svg src="@/lib/icons/favourite.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <m3e-tooltip text="Squeak peek: cooking tips">
                            <m3e-icon-button aria-label="Show cooking tips" p-on:click="openTips">
                                <piko:svg src="@/lib/icons/info.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <label class="switch-field">
                            <m3e-switch p-on:change="toggleUnits" aria-label="Use imperial measurements"></m3e-switch>
                            <span p-ref="unitLabel">Metric</span>
                        </label>
                    </div>
                </header>

                <m3e-tabs class="recipe-tabs" p-on:change="selectPanel">
                    <m3e-tab active>Ingredients</m3e-tab>
                    <m3e-tab>Method</m3e-tab>
                    <m3e-tab>Nutrition</m3e-tab>
                    <m3e-tab>Reviews (5)</m3e-tab>
                </m3e-tabs>

                <!-- Ingredients -->
                <section class="recipe-panel" p-ref="panel0" aria-label="Ingredients">
                    <div class="panel-header">
                        <h2 class="subsection-title">Ingredients</h2>
                        <div class="servings-control">
                            <span id="servings-label">Servings</span>
                            <m3e-slider class="servings-slider"
                                        discrete
                                        min="1"
                                        max="12"
                                        value="4"
                                        step="1"
                                        aria-labelledby="servings-label"
                                        p-on:change="changeServings"></m3e-slider>
                            <strong p-ref="servingsValue">4</strong>
                        </div>
                    </div>

                    <div p-ref="ingredients">
                        <m3e-list>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="4">4</span> chicken breasts, skinless and boneless</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="80" data-unit="g">80g</span> parmesan, finely grated</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="200" data-unit="g">200g</span> mozzarella, sliced</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="100" data-unit="g">100g</span> breadcrumbs</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="2">2</span> large eggs, beaten</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="60" data-unit="g">60g</span> plain flour, seasoned</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="1">1</span> tin (400g) chopped tomatoes</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="3">3</span> cloves garlic, minced</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="1">1</span> onion, finely diced</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">A handful of fresh basil leaves</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="1" data-unit="tsp">1 tsp</span> dried oregano</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="3" data-unit="tbsp">3 tbsp</span> olive oil</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient"><span class="qty" data-base="400" data-unit="g">400g</span> spaghetti</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Salt, to taste</span></m3e-list-item>
                            <m3e-list-item><span class="ingredient">Freshly ground black pepper, to taste</span></m3e-list-item>
                        </m3e-list>
                    </div>
                </section>

                <!-- Method -->
                <section class="recipe-panel" p-ref="panel1" aria-label="Method" hidden>
                    <h2 class="subsection-title">Method</h2>
                    <ol class="step-list">
                        <li>Make the tomato sauce: heat 1 tbsp olive oil in a saucepan, cook the onion for 5 minutes, add the garlic for 1 minute, then in with the tinned tomatoes, oregano, and a pinch of salt. Simmer for 15&ndash;20 minutes. While you wait, grate the parmesan. You&rsquo;ll need a good pile. Grate it directly into the bowl. NOT into your mouth. We can see you. Into the bowl.</li>
                        <li>Set up the breading station: flour in dish one, beaten eggs in dish two, breadcrumbs mixed with half the parmesan in dish three. This is an assembly line of joy. You are the foreman. The parmesan is your co-pilot. Together, you are unstoppable.</li>
                        <li>Place each chicken breast between two sheets of cling film and pound with a rolling pin until about 1cm thick. This is strangely therapeutic. Think of it as a workout, but one that ends with cheese. All the best workouts end with cheese.</li>
                        <li>Coat each chicken breast: flour first (shake off excess), then egg, then into the parmesan-breadcrumb mix. Press it in firmly. Every bare spot is a missed opportunity for crunch. We don&rsquo;t do missed opportunities at The Norman Kitchen.</li>
                        <li>Pan-fry in olive oil for 3&ndash;4 minutes per side until golden and crispy. The sizzle. The smell. The golden parmesan crust forming before your eyes. This is it. This is parm-ageddon. There is no going back.</li>
                        <li>Preheat the grill. Spoon tomato sauce over each chicken breast, then pile on the mozzarella and remaining parmesan. Grill for 3&ndash;4 minutes until the cheese is melted, bubbling, and starting to turn golden. At this point the smoke alarm may go off. This is not a fault. It is the smoke alarm celebrating.</li>
                        <li>Cook the spaghetti, drain it, and plate up alongside the chicken. Garnish with basil. Step back. You have just created something magnificent. The parmesan crust. The molten mozzarella. The sauce. It&rsquo;s a symphony. The mice are giving you a standing ovation.</li>
                    </ol>
                </section>

                <!-- Nutrition -->
                <section class="recipe-panel" p-ref="panel2" aria-label="Nutrition" hidden>
                    <h2 class="subsection-title">Nutrition (per serving)</h2>
                    <ul class="nutrition-list">
                            <li class="nutrition-row"><span class="nutrition-label">Calories</span><span class="nutrition-value">620 kcal</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Protein</span><span class="nutrition-value">44g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Fat</span><span class="nutrition-value">26g</span></li>
                            <li class="nutrition-row"><span class="nutrition-label">Carbohydrates</span><span class="nutrition-value">52g</span></li>
                    </ul>
                </section>

                <!-- Reviews -->
                <section class="recipe-panel" p-ref="panel3" aria-label="Reviews" hidden>
                    <h2 class="subsection-title">Reviews</h2>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">ApocalypseChef</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Parm-ageddon is the best kind of apocalypse! The parmesan in the breadcrumb coating gives such a gorgeous golden crust. I'll never go back to plain breadcrumbs again.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">FamilyFeastFan</strong>
                                <span class="stars" role="img" aria-label="4 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Kids loved it and asked for seconds before I'd even sat down. The tomato sauce is fresh and vibrant. Only wish there was a bit more of it, so next time I'll double the batch.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">ParmBankrupt</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">I have spent &pound;347 on parmesan this month. My bank sent me a letter. Not a fraud alert. A wellness check. I regret nothing. This recipe is the reason I cannot retire. The chicken is transcendent. My pension is gone.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">GraterArms</strong>
                                <span class="stars" role="img" aria-label="4 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16" class="star-off"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">Grated so much parmesan my right arm is now noticeably larger than my left. People at the gym think I have a very targeted workout routine. I do. It&rsquo;s called &ldquo;grating an entire block of Parmigiano-Reggiano every Tuesday.&rdquo; Taking off a star for the physio bills.</p>

                            </div>
                        </m3e-card>

                        <m3e-card variant="outlined" class="review">
                            <div class="card-pad">
                                <div class="review-header">
                                <strong class="review-author">SmokeDetectorSusan</strong>
                                <span class="stars" role="img" aria-label="5 out of 5 stars">
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                    <piko:svg src="@/lib/icons/star.svg" fill="currentColor" width="16" height="16"></piko:svg>
                                </span>
                            </div>
                                <p class="review-body">My smoke alarm has gone off every single time I&rsquo;ve made this. I&rsquo;ve made it fourteen times. The alarm now goes off when I open the parmesan packet, like a Pavlovian smoke detector. My neighbours have started timing their evening plans around my cooking schedule.</p>

                            </div>
                        </m3e-card>

                    <m3e-card variant="filled" class="review-form">
                        <div class="card-pad--lg">
                            <h3 class="subsection-title">Leave a review</h3>
                        <form class="form-stack" p-ref="reviewForm" p-on:submit.prevent="submitReview">
                            <m3e-text-field variant="filled"
                                            label="Your name"
                                            name="name"
                                            supporting-text="How should we address you?"
                                            class="form-field"></m3e-text-field>

                            <m3e-text-field variant="filled"
                                            label="Your review"
                                            name="review"
                                            multiline
                                            rows="3"
                                            maxlength="500"
                                            supporting-text="500 characters max"
                                            class="form-field"></m3e-text-field>

                            <m3e-select variant="filled" label="Rating" name="rating" class="form-field">
                                    <m3e-menu-item value="5">5 - The mice approve!</m3e-menu-item>
                                    <m3e-menu-item value="4">4 - Gouda job!</m3e-menu-item>
                                    <m3e-menu-item value="3">3 - Not bad, not bad</m3e-menu-item>
                                    <m3e-menu-item value="2">2 - Needs more cheese</m3e-menu-item>
                                    <m3e-menu-item value="1">1 - Un-brie-lievably disappointing</m3e-menu-item>
                            </m3e-select>

                            <div class="form-actions form-actions--centre">
                                <m3e-button variant="filled" size="l" p-on:click="submitReview">Submit review</m3e-button>
                            </div>
                        </form>
                        </div>
                    </m3e-card>
                </section>
            </article>

            <!-- Squeak peek bottom sheet -->
            <m3e-bottom-sheet p-ref="tipsSheet" modal>
                <h2 class="subsection-title">Squeak peek: cooking tips</h2>
                <m3e-list>
                    <m3e-list-item>Pound the chicken thin for even cooking, aiming for about 1cm thickness throughout. This also maximises the crispy surface area.</m3e-list-item>
                    <m3e-list-item>Use freshly grated parmesan, not the pre-grated stuff. It melts better, tastes sharper, and doesn't contain the anti-caking agents that can affect texture.</m3e-list-item>
                    <m3e-list-item>Broil for the last 2 minutes for extra golden mozzarella. Keep a close eye on it, because the line between perfectly golden and burnt is thin!</m3e-list-item>
                </m3e-list>
            </m3e-bottom-sheet>

            <!-- Cheese fact dialog -->
            <m3e-dialog p-ref="cheeseFact" headline="Cheese fact!">
                <p class="prose">Real Parmigiano-Reggiano must be aged for at least 12 months, and the best wheels are aged for 24&ndash;36 months. Each wheel takes around 600 litres of milk to produce.</p>
                <m3e-button variant="filled" slot="actions" p-on:click="closeCheeseFact">Gouda to know!</m3e-button>
            </m3e-dialog>

            <!-- Snackbar -->
            <m3e-snackbar p-ref="snackbar"></m3e-snackbar>

            <!-- Cooking timer FAB -->
            <m3e-tooltip text="Set a cooking timer" position="left">
                <m3e-fab colour="secondary" class="floating-fab" p-on:click="openTimer" aria-label="Set a cooking timer">
                    <piko:svg src="@/lib/icons/timer.svg" fill="currentColor" width="24" height="24"></piko:svg>
                </m3e-fab>
            </m3e-tooltip>

        </piko:partial>
