<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Hallou-mi, It's Me"
            server.current-page="recipes">

            <article class="page-section page-section--reading">
                <piko:img class="recipe-hero" src="@/lib/images/cheese-halloumi.jpg" alt="Hallou-mi, It's Me"></piko:img>

                <header class="mt-lg">
                    <h1 class="recipe-title">Hallou-mi, It's Me</h1>
                    <p class="recipe-pun">Grilled halloumi that always picks up</p>

                    <div class="recipe-meta-row tag-row">
                        <span class="tag">Halloumi</span>
                        <span class="tag">20 mins</span>
                        <span class="tag">Easy</span>
                        <span class="tag">4 servings</span>
                    </div>

                    <div class="recipe-actions">
                        <m3e-split-button variant="filled" p-on:click="saveRecipe">
                            Save recipe
                            <m3e-menu-item slot="menu" p-on:select="addToMealPlan">Add to meal plan</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="shareRecipe">Share recipe</m3e-menu-item>
                            <m3e-menu-item slot="menu" p-on:select="printRecipe">Print</m3e-menu-item>
                        </m3e-split-button>

                        <m3e-tooltip text="Add to favourites">
                            <m3e-icon-button toggle aria-label="Add to favourites">
                                <piko:svg src="@/lib/icons/favourite.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <m3e-tooltip text="Squeak peek: cooking tips">
                            <m3e-icon-button aria-label="Show cooking tips" p-on:click="openTips">
                                <piko:svg src="@/lib/icons/info.svg" fill="currentColor" width="24" height="24"></piko:svg>
                            </m3e-icon-button>
                        </m3e-tooltip>

                        <label class="switch-field">
                            <m3e-switch p-on:change="toggleUnits" aria-label="Use imperial measurements"></m3e-switch>
                            <span p-ref="unitLabel">Metric</span>
                        </label>
                    </div>
