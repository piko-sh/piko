                                <m3e-select variant="filled" label="Rating" name="rating" class="form-field">
                                    <m3e-menu-item value="5">5 - The mice approve!</m3e-menu-item>
                                    <m3e-menu-item value="4">4 - Gouda job!</m3e-menu-item>
                                    <m3e-menu-item value="3">3 - Not bad, not bad</m3e-menu-item>
