<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Hallou-mi, It's Me - The Norman Kitchen",
    }, nil
}
</script>

<script lang="ts">
    const BASE_SERVINGS = 4;

    let servings = BASE_SERVINGS;
    let imperial = false;

    /* -- Tab panels ------------------------------------------------------- */

    /** Shows the panel matching the tab the user activated. */
    function selectPanel(event: CustomEvent): void {
        const index = event.detail.index as number;

        for (let i = 0; i < 4; i++) {
            const panel = pk.refs['panel' + i] as HTMLElement | undefined;
            if (panel) panel.hidden = i !== index;
        }
    }

    /* -- Ingredient quantities -------------------------------------------- */

    /**
     * Metric to imperial conversions. Spoon measures are the same in both
     * systems, so they are left alone.
     */
    const CONVERSIONS: Record<string, { unit: string; factor: number }> = {
        g:  { unit: 'oz',    factor: 1 / 28.35 },
        kg: { unit: 'lb',    factor: 2.205 },
        ml: { unit: 'fl oz', factor: 1 / 28.41 },
        l:  { unit: 'pints', factor: 1.76 },
    };

    /** Rounds to a precision that reads naturally at the given magnitude. */
    function tidy(value: number): string {
        if (value >= 100) return String(Math.round(value / 5) * 5);
        if (value >= 10) return String(Math.round(value));
        return String(Math.round(value * 10) / 10);
    }

    /** Recomputes every ingredient quantity for the current servings and units. */
    function renderQuantities(): void {
        const root = pk.refs.ingredients as HTMLElement | undefined;
        if (!root) return;

        const scale = servings / BASE_SERVINGS;

        root.querySelectorAll<HTMLElement>('.qty').forEach((el) => {
            const base = parseFloat(el.dataset.base || '0');
            const unit = el.dataset.unit || '';
            let amount = base * scale;
            let label = unit;

            const conversion = imperial ? CONVERSIONS[unit] : undefined;
            if (conversion) {
                amount *= conversion.factor;
                label = conversion.unit;
            }

            el.textContent = label && label.length > 2
                ? tidy(amount) + ' ' + label
                : tidy(amount) + label;
        });
    }

    function changeServings(event: CustomEvent): void {
        servings = Number(event.detail.value);

        const readout = pk.refs.servingsValue as HTMLElement | undefined;
        if (readout) readout.textContent = String(servings);

        renderQuantities();
    }

    function toggleUnits(event: CustomEvent): void {
        imperial = Boolean(event.detail.checked);

        const label = pk.refs.unitLabel as HTMLElement | undefined;
        if (label) label.textContent = imperial ? 'Imperial' : 'Metric';

        renderQuantities();
    }

    /* -- Overlays --------------------------------------------------------- */

    function notify(message: string): void {
        const snackbar = pk.refs.snackbar as any;
        if (snackbar) snackbar.show(message);
    }

    function openTips(): void {
        const sheet = pk.refs.tipsSheet as any;
        if (sheet) sheet.show();
    }

    function closeCheeseFact(): void {
        const dialog = pk.refs.cheeseFact as any;
        if (dialog) dialog.close();
    }

    function openTimer(): void {
        notify('Timer feature coming soon! Melting in progress...');
    }

    /* -- Actions ---------------------------------------------------------- */

    function saveRecipe(): void {
        notify('Saved! This one is a keeper.');
    }

    function addToMealPlan(): void {
        notify('Added to your meal plan. Gouda choice!');
    }

    function shareRecipe(): void {
        notify('Link copied. Go on, spread the cheese.');
    }

    function printRecipe(): void {
        window.print();
    }

    function submitReview(): void {
        notify('Thanks! Your review is with the mice for approval.');
    }
</script>
