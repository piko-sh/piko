<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "Cheese guide - The Norman Kitchen",
    }, nil
}
</script>

<script lang="ts">
    const CATEGORIES = ['all', 'soft', 'semi-soft', 'hard', 'blue', 'fresh'];

    let category = 'all';
    let query = '';

    function apply(): void {
        const grid = pk.refs.cheeseGrid as HTMLElement | undefined;
        const empty = pk.refs.noResults as HTMLElement | undefined;
        if (!grid) return;

        let shown = 0;

        grid.querySelectorAll<HTMLElement>('m3e-card').forEach((card) => {
            const inCategory = category === 'all' || card.dataset.category === category;
            // Name, origin and tasting notes are all worth searching.
            const haystack = (card.textContent || '').toLowerCase();
            const match = inCategory && (query === '' || haystack.includes(query));

            card.hidden = !match;
            if (match) shown++;
        });

        if (empty) empty.hidden = shown > 0;
    }

    function selectCategory(event: CustomEvent): void {
        category = CATEGORIES[event.detail.index as number] || 'all';
        apply();
    }

    function changeSearch(event: CustomEvent): void {
        query = String(event.detail.value || '').trim().toLowerCase();
        apply();
    }

    piko.hooks.on(piko.hooks.events.NAVIGATION_COMPLETE, () => {
        if (!document.querySelector('[p-ref="cheeseGrid"]')) return;

        category = 'all';
        query = '';
        apply();
    });
</script>
