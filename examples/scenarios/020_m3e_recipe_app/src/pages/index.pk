<template>
    <div id="app">
        <piko:partial is="layout"
            server.title="Home"
            server.current-page="home">

            <!-- Hero carousel -->
            <section class="page-section">
                <m3e-carousel auto_advance interval="5000">
                    <div class="hero">
                        <piko:img src="@/lib/images/hero-burger.jpg" alt="The Grate Burger" class="hero-image"></piko:img>
                        <div class="hero-content">
                            <p class="hero-title">The Grate Burger</p>
                            <p class="hero-subtitle">The gratest burger you'll ever taste</p>
                            <m3e-button variant="filled" size="l" href="/recipe/the-grate-burger">Don't be mousey, try it!</m3e-button>
                        </div>
                    </div>

                    <div class="hero">
                        <piko:img src="@/lib/images/hero-pizza.jpg" alt="Feta Accompli Pizza" class="hero-image"></piko:img>
                        <div class="hero-content">
                            <p class="hero-title">Feta Accompli Pizza</p>
                            <p class="hero-subtitle">Consider it a feta accompli</p>
                            <m3e-button variant="filled" size="l" href="/recipe/feta-accompli-pizza">View recipe</m3e-button>
                        </div>
                    </div>

                    <div class="hero">
                        <piko:img src="@/lib/images/hero-mac-and-cheese.jpg" alt="Gouda Gracious Mac &amp; Cheese" class="hero-image"></piko:img>
                        <div class="hero-content">
                            <p class="hero-title">Gouda Gracious Mac &amp; Cheese</p>
                            <p class="hero-subtitle">Gouda gracious, that's creamy!</p>
                            <m3e-button variant="filled" size="l" href="/recipe/gouda-gracious-mac">View recipe</m3e-button>
                        </div>
                    </div>

                    <div class="hero">
                        <piko:img src="@/lib/images/hero-cheese-board.jpg" alt="Artisan Cheese Board" class="hero-image"></piko:img>
                        <div class="hero-content">
                            <p class="hero-title">Say cheese!</p>
                            <p class="hero-subtitle">Explore our cheese encyclopaedia</p>
                            <m3e-button variant="filled" size="l" href="/cheese-guide">Cheese guide</m3e-button>
                        </div>
                    </div>
                </m3e-carousel>
            </section>

            <!-- Cheese the day, the daily featured recipe -->
            <section class="page-section">
                <h1 class="page-title">Cheese the day!</h1>
                <p class="section-subtitle">Today's featured recipe, freshly picked by our resident mouse</p>

                <m3e-card variant="elevated">
                    <div class="featured">
                        <piko:img src="@/lib/images/recipe-camembert-believe-it.jpg" alt="Camembert Believe It" class="featured-image"></piko:img>
                        <div class="featured-body">
                            <span class="tag tag--primary mb-sm">Today's pick</span>
                            <h2 class="subsection-title">Camembert Believe It</h2>
                            <p class="recipe-card-pun">The king of cheeses, baked to molten perfection</p>
                            <p class="prose">Whole baked Camembert with rosemary, garlic, and crusty bread soldiers. A dish so good, you camembert to share it.</p>

                            <div class="tag-row mt-md">
                                <span class="tag">Camembert</span>
                                <span class="tag">30 mins</span>
                                <span class="tag">Easy</span>
                            </div>

                            <div class="flex-row flex-wrap gap-sm mt-md">
                                <m3e-button variant="filled" href="/recipe/camembert-believe-it">View recipe</m3e-button>
                                <m3e-button variant="outlined" href="/recipes">All recipes</m3e-button>
                            </div>
                        </div>
                    </div>
                </m3e-card>
            </section>

            <!-- Mouse-watering meals, the featured grid -->
            <section class="page-section">
                <h2 class="section-title">Mouse-watering meals</h2>
                <p class="section-subtitle">Our most popular recipes. The mice approve!</p>

                <div class="recipe-grid">
                    <piko:partial is="recipe_card"
                        server.title="The Grate Burger"
                        server.slug="the-grate-burger"
                        server.pun="The gratest burger you'll ever taste"
                        server.description="A towering double cheeseburger with aged cheddar, caramelised onions, and our secret sauce."
                        server.image="@/lib/images/recipe-the-grate-burger.jpg"
                        server.cook-time="25 mins"
                        server.cheese="Cheddar"
                        server.difficulty="Easy"
                        server.href="/recipe/the-grate-burger"
                    ></piko:partial>

                    <piko:partial is="recipe_card"
                        server.title="Raclette & Roll"
                        server.slug="raclette-and-roll"
                        server.pun="Ready to raclette and roll!"
