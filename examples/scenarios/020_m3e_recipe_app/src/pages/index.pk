                        server.description="Crispy parmesan-crusted chicken with melted mozzarella and rich tomato sauce."
                        server.image="@/lib/images/recipe-parm-ageddon-chicken.jpg"
                        server.cook-time="45 mins"
                        server.cheese="Parmesan"
                        server.difficulty="Medium"
                        server.href="/recipe/parm-ageddon-chicken"
                    ></piko:partial>
                </div>
            </section>

            <!-- Browse by category -->
            <section class="page-section last-section">
                <h2 class="section-title">Browse by category</h2>
                <p class="section-subtitle">This is nacho average recipe collection</p>

                <m3e-chip-set>
                    <piko:a href="/recipes?cheese=brie"><m3e-chip variant="assist">Brie-lliant breakfasts</m3e-chip></piko:a>
                    <piko:a href="/recipes?cheese=gouda"><m3e-chip variant="assist">Gouda lunches</m3e-chip></piko:a>
                    <piko:a href="/recipes?cheese=cheddar"><m3e-chip variant="assist">Ched-dar dinners</m3e-chip></piko:a>
                    <piko:a href="/recipes?cheese=raclette"><m3e-chip variant="assist">Fondue fun</m3e-chip></piko:a>
                    <piko:a href="/recipes?cheese=camembert"><m3e-chip variant="assist">Aged to perfection</m3e-chip></piko:a>
                    <piko:a href="/recipes"><m3e-chip variant="assist">Hole-some recipes</m3e-chip></piko:a>
                </m3e-chip-set>
            </section>

            <m3e-extended-fab class="floating-fab" p-on:click="surpriseMe">
                <piko:svg src="@/lib/icons/shuffle.svg" fill="currentColor" width="24" height="24" slot="icon"></piko:svg>
                Surprise me
            </m3e-extended-fab>

        </piko:partial>
    </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
    recipe_card "testmodule/partials/recipe-card.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "The Norman Kitchen - Where every dish is grate!",
    }, nil
}
</script>

<script lang="ts">
    const RECIPES = [
        '/recipe/the-grate-burger',
        '/recipe/brie-lliant-caesar',
        '/recipe/feta-accompli-pizza',
        '/recipe/gouda-gracious-mac',
        '/recipe/ricotta-be-kidding-lasagna',
        '/recipe/hallou-mi-its-me',
        '/recipe/parm-ageddon-chicken',
        '/recipe/camembert-believe-it',
        '/recipe/raclette-and-roll',
    ];

    /** Sends the visitor to a recipe at random, through the router. */
    function surpriseMe(): void {
        const index = Math.floor(Math.random() * RECIPES.length);
        piko.nav.navigate(RECIPES[index]);
    }
</script>
