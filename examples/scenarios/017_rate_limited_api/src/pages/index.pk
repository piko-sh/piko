<template>
  <div id="app">
    <h1 class="title">Rate-limited API</h1>
    <p class="subtitle">This action allows 3 requests per minute per IP. Exceeding the limit triggers a 429 response.</p>

    <button id="test-btn" class="button" p-on:click="runTest()">Test rate limit</button>

    <div class="results">
      <div class="result-row">
        <span class="label">Calls made:</span>
        <span class="value" p-ref="call_count">0</span>
      </div>
      <div class="result-row">
        <span class="label">Last status:</span>
        <span class="value" p-ref="last_status">-</span>
      </div>
      <div class="result-row">
        <span class="label">Result:</span>
        <span class="value" p-ref="result">idle</span>
      </div>
    </div>
  </div>
</template>

<script type="application/x-go">
package main

import "piko.sh/piko"

type Response struct{}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    return Response{}, piko.Metadata{
        Title: "Rate-limited API | Piko example",
    }, nil
}
</script>

<script lang="ts">
export async function runTest(): Promise<void> {
    pk.refs.result!.textContent = 'testing';
    let callCount = 0;

    for (let i = 0; i < 5; i++) {
        callCount++;
        pk.refs.call_count!.textContent = String(callCount);
        try {
            await action.api.Echo({ message: 'hello' }).call();
            pk.refs.last_status!.textContent = '200';
        } catch (err: any) {
            pk.refs.last_status!.textContent = String(err.status || 'unknown');
            if (err.status === 429) {
                pk.refs.result!.textContent = 'rate_limited';
                return;
            }
            pk.refs.result!.textContent = 'error';
            return;
        }
    }
    pk.refs.result!.textContent = 'not_limited';
}
</script>

<style>
