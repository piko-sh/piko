<!-- A PKC (client-side Web Component). The name="pp-counter" attribute sets
     the custom element tag. Reactive state triggers re-renders automatically.
     See https://piko.sh/docs/guide/client-components -->
<template name="pp-counter">
    <div class="counter">
        <p id="count" p-class="{ negative: state.count < 0 }" p-text="state.count"></p>
        <div class="buttons">
            <button id="decrement-btn" class="button button-secondary" p-on:click="decrement">-</button>
            <button id="increment-btn" class="button" p-on:click="increment">+</button>
        </div>
    </div>
</template>

<script lang="ts">
    // Reactive state: mutating any property re-renders dependent template expressions.
    const state = {
        count: 0 as number,
    };

    function increment() {
        state.count++;
    }

    function decrement() {
        state.count--;
    }
</script>

<style>
    @import "testmodule/styles/theme.css";

    .counter {
        max-width: 280px;
        margin: 0 auto;
