<!-- Multi-step signup wizard. Uses p-if / p-else-if / p-else to show one
     step at a time, p-model for input binding, and onConnected() for lifecycle.
     See https://piko.sh/docs/guide/client-components and https://piko.sh/docs/guide/template-syntax -->
<template name="pp-signup-wizard">
    <div class="wizard">
        <h2>Create account</h2>

        <div class="step-indicator">
            <span class="step-dot" p-class="{ active: state.step == 1, done: state.step > 1 }">1</span>
            <span class="step-dot" p-class="{ active: state.step == 2, done: state.step > 2 }">2</span>
            <span class="step-dot" p-class="{ active: state.step == 3 }">3</span>
        </div>

        <div p-if="state.step == 1" class="step step-1">
            <h3>Personal information</h3>

            <div class="form-group">
                <label for="name-input">Full name</label>
                <input id="name-input" type="text" p-model="state.name" placeholder="Reginald Penguin">
            </div>

            <div class="form-group">
                <label for="email-input">Email address</label>
                <input id="email-input" type="email" p-model="state.email" placeholder="reginald@southpole.com">
            </div>

            <p p-if="state.error != ''" class="error">{{ state.error }}</p>

            <div class="nav-buttons">
                <button id="next-button" class="button button-primary" p-on:click="nextStep">Next</button>
            </div>
        </div>

        <div p-else-if="state.step == 2" class="step step-2">
            <h3>Preferences</h3>

            <div class="form-group">
                <label for="role-select">Role</label>
                <select id="role-select" p-model="state.role">
                    <option value="developer">Developer</option>
                    <option value="designer">Designer</option>
                    <option value="manager">Manager</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <div class="form-group checkbox-group">
                <label>
                    <input id="newsletter-checkbox" type="checkbox" p-model="state.newsletter">
                    Subscribe to newsletter
                </label>
            </div>

            <p p-if="state.error != ''" class="error">{{ state.error }}</p>

            <div class="nav-buttons">
                <button id="next-button" class="button button-primary" p-on:click="nextStep">Next</button>
                <button id="back-button" class="button button-secondary" p-on:click="prevStep">Back</button>
            </div>
        </div>

        <div p-else class="step step-3">
            <h3>Confirmation</h3>

            <div p-if="!state.completed" class="summary">
                <p>Please review your details before submitting:</p>

                <dl class="summary-list">
                    <dt>Name</dt>
                    <dd id="summary-name">{{ state.name }}</dd>

                    <dt>Email</dt>
                    <dd id="summary-email">{{ state.email }}</dd>

                    <dt>Role</dt>
                    <dd id="summary-role">{{ state.role }}</dd>

                    <dt>Newsletter</dt>
                    <dd id="summary-newsletter">{{ state.newsletter ? 'Yes' : 'No' }}</dd>
                </dl>

                <div class="nav-buttons">
                    <button id="submit-button" class="button button-primary" p-on:click="submitForm">Submit</button>
                    <button id="back-button" class="button button-secondary" p-on:click="prevStep">Back</button>
                </div>
            </div>

            <div p-else class="success">
                <div class="success-icon">&#10003;</div>
                <p class="success-message">Registration complete!</p>
                <p class="success-detail">Welcome aboard, {{ state.name }}.</p>
            </div>
        </div>
    </div>
</template>

<script lang="ts">
    const state = {
        step: 1 as number,
        name: '' as string,
        email: '' as string,
        role: 'developer' as string,
        newsletter: false as boolean,
        error: '' as string,
        completed: false as boolean,
    };

    function onConnected() {
        console.log('Wizard initialised');
    }

    function nextStep() {
        if (state.step === 1) {
            if (state.name.trim() === '') {
                state.error = 'Please enter your name';
                return;
            }
            if (state.email.trim() === '') {
                state.error = 'Please enter your email address';
                return;
            }
            if (!state.email.includes('@')) {
                state.error = 'Please enter a valid email address';
                return;
            }
        }

        state.error = '';
        state.step++;
    }

    function prevStep() {
        state.error = '';
        state.step--;
    }

    function submitForm() {
        state.completed = true;
    }
</script>

<style>
    @import "testmodule/styles/theme.css";

    .wizard {
        max-width: 480px;
        margin: 0 auto;
        padding: 2rem;
        font-family: var(--g-font-family, sans-serif);
        border: 1px solid var(--g-colour-grey-100, #E8EBEE);
        border-radius: var(--g-radius-xl, 30px);
        background: #ffffff;
        color: var(--g-colour-grey-800, #364049);
    }

    h2, h3 {
        font-weight: 600;
    }

    h2 {
        margin: 0 0 1.5rem;
        font-size: 1.5rem;
        color: var(--g-colour-grey-900, #2B333B);
        text-align: center;
    }

    h3 {
        margin: 0 0 1rem;
        font-size: 1.125rem;
        color: var(--g-colour-grey-900, #2B333B);
    }

    .step-indicator {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .step-dot {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: var(--g-radius-max, 9999px);
        border: 1px solid var(--g-colour-grey-100);
        font-size: 0.875rem;
        font-weight: 600;
        background-color: var(--g-colour-grey-25);
        color: var(--g-colour-grey-400);
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .step-dot.active {
        background-color: var(--g-colour-primary-50);
        color: var(--g-colour-primary-500);
        border: 1px solid var(--g-colour-primary-300);
    }

    .step-dot.done {
        background-color: var(--g-colour-primary-25);
        color: var(--g-colour-primary-400);
        border: 1px solid var(--g-colour-primary-100);
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        text-align: left;
        color: var(--g-colour-grey-700, #485461);
    }

    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group select {
        width: 100%;
        padding: 0.625rem 0.75rem;
        font-size: 0.9375rem;
        font-family: var(--g-font-family, sans-serif);
        border: 1px solid var(--g-colour-grey-200, #CAD1D8);
        border-radius: var(--g-radius-max, 9999px);
        background: #ffffff;
        color: var(--g-colour-grey-900, #2B333B);
        box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .form-group select {
        appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23333333' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
        background-repeat: no-repeat;
        background-position: right 12px center;
        background-size: 16px;
        cursor: pointer;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: var(--g-colour-primary-500, #6F47EB);
        box-shadow: 0 0 0 3px rgba(111, 71, 235, 0.15);
    }

    .checkbox-group label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        font-size: 0.9375rem;
        color: var(--g-colour-grey-700, #485461);
    }

    .checkbox-group input[type="checkbox"] {
          appearance: none;
          -webkit-appearance: none;
          width: 20px;
          height: 20px;
          border: 1px solid var(--g-colour-grey-500);
          border-radius: 6px;
          outline: none;
          cursor: pointer;
          position: relative;
          background-color: #fff;
          transition: background 0.2s, border-color 0.2s;
          &:checked {
            background-color: var(--g-colour-primary-500);
            border-color: var(--g-colour-primary-500);
          }
          &:checked::after {
            content: '';
            position: absolute;
            left: 7px;
            top: 3px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
          }
    }

    .error {
        margin: 0.75rem 0 0;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        color: #dc2626;
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: var(--g-radius-md, 15px);
    }

    .nav-buttons {
        display: flex;
        justify-content: space-between;
        flex-direction: row-reverse;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .button {
        --colour-background: var(--g-colour-primary-50);
        --colour-background-hover: var(--g-colour-primary-100);
        --colour-text: var(--g-colour-primary-600);
        --colour-text-hover: var(--g-colour-primary-700);
        --colour-border: var(--g-colour-primary-600);
        --colour-border-hover: var(--g-colour-primary-700);
        --button-shadow-depth: 4px;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.625rem 1.5rem;
        border-radius: var(--g-radius-max, 9999px);
        border: 1px solid var(--colour-border);
        box-shadow: 0 var(--button-shadow-depth) 0 var(--colour-border);
        margin-bottom: var(--button-shadow-depth);
        background-color: var(--colour-background);
        color: var(--colour-text);
        font-size: 1rem;
        font-weight: 500;
        font-family: var(--g-font-family, sans-serif);
        text-decoration: none;
        cursor: pointer;
        transition: box-shadow 0.2s, transform 0.2s, color 0.2s, background-color 0.2s, border-color 0.2s;
    }

    .button:hover {
        transform: translateY(calc(var(--button-shadow-depth) / 2));
        box-shadow: 0 calc(var(--button-shadow-depth) / 2) 0 var(--colour-border-hover);
        background-color: var(--colour-background-hover);
        border-color: var(--colour-border-hover);
        color: var(--colour-text-hover);
    }

    .button-secondary {
        --colour-background: var(--g-colour-secondary-100);
        --colour-background-hover: var(--g-colour-secondary-200);
        --colour-text: var(--g-colour-secondary-800);
        --colour-text-hover: var(--g-colour-secondary-900);
        --colour-border: var(--g-colour-secondary-700);
        --colour-border-hover: var(--g-colour-secondary-800);
    }

    .summary p {
        margin: 0 0 1rem;
        color: var(--g-colour-grey-500, #788A9B);
        font-size: 0.9375rem;
    }

    .summary-list {
        text-align: left;
        margin: 2rem 0 1rem;
        padding: 0;
        display: grid;
        grid-template-columns: 8rem 1fr;
        gap: 0.5rem 1rem;
    }

    .summary-list dt {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--g-colour-grey-500, #788A9B);
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .summary-list dd {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--g-colour-grey-900, #2B333B);
    }

    .success {
        text-align: center;
        padding: 2rem 1rem;
        background-color: var(--g-colour-secondary-50);
        border: 1px solid var(--g-colour-secondary-500);
        border-radius: var(--g-radius-lg, 20px);
    }

    .success-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        margin-bottom: 1rem;
        font-size: 2rem;
        color: #ffffff;
        background-color: var(--g-colour-secondary-700, #39ABA1);
        border-radius: var(--g-radius-max, 9999px);
    }

    .success-message {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--g-colour-secondary-900, #236962);
    }

    .success-detail {
        color: var(--g-colour-secondary-800, #5B6B7B);
        margin: 0;
        font-size: 0.9375rem;
    }
</style>
