<template>
  <div id="app" class="tls-page">
    <h1 class="tls-heading">{{ state.Heading }}</h1>
    <p class="tls-description">{{ state.Description }}</p>

    <footer class="tls-footer">
      <small class="tls-footer-note">Served with TLS enabled</small>
    </footer>
  </div>
</template>

<script type="application/x-go">
package main

import "piko.sh/piko"

type Response struct {
    Heading     string
    Description string
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    return Response{
        Heading:     "Secure connection",
        Description: "This page was served over HTTPS using a self-signed TLS certificate.",
    }, piko.Metadata{
        Title:       "TLS/HTTPS | Piko example",
        Description: "A Piko page served over HTTPS with a self-signed TLS certificate.",
    }, nil
}
</script>

