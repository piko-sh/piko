<template>
  <nav class="nav">
    <a href="/" class="nav-item" p-class="state.Active == 'direct' ? 'active' : ''">Direct upload</a>
    <a href="/presigned" class="nav-item" p-class="state.Active == 'presigned' ? 'active' : ''">Presigned URL upload</a>
  </nav>
</template>

<script type="application/x-go">
package main

import "piko.sh/piko"

type Props struct {
    Active string `prop:"active" validate:"required"`
}

type Response struct {
    Active string
}

func Render(r *piko.RequestData, props Props) (Response, piko.Metadata, error) {
    return Response{Active: props.Active}, piko.Metadata{}, nil
}
</script>

