<!-- Direct multipart file upload to S3 via the files.Upload action.
     See /presigned for the presigned URL upload variant. -->
<template>
  <div id="app">
    <h1>S3 file upload</h1>
    <piko:partial is="upload_nav" server.active="direct"></piko:partial>

    <p class="intro">Select a file and upload it directly to S3 via multipart form data.</p>

    <piko:partial is="upload_form" server.mode="direct" server.button-label="Upload to S3"></piko:partial>

    <piko:partial is="file_list"></piko:partial>
  </div>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"

    upload_form "testmodule/partials/upload-form.pk"
    upload_nav "testmodule/partials/upload-nav.pk"
    file_list "testmodule/partials/file-list.pk"
)

func Render(r *piko.RequestData, props piko.NoProps) (piko.NoResponse, piko.Metadata, error) {
    return piko.NoResponse{}, piko.Metadata{
        Title: "S3 file upload | direct",
    }, nil
}
</script>

