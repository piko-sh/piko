<!-- Blog listing page. Fetches all posts from the "blog" markdown collection
     and renders them as a list of cards with title, description, and date. -->
<template>
  <piko:partial is="layout">
    <h1 class="page-title">Posts</h1>

    <div class="post-list">
      <piko:a p-for="post in state.Posts" p-key="post.Slug" :href="post.URL" class="post-card">
        <h2 class="post-title" p-text="post.Title"></h2>
        <p class="post-description" p-text="post.Description"></p>
        <time class="post-date" p-text="post.Date"></time>
      </piko:a>
    </div>
  </piko:partial>
</template>

<script type="application/x-go">
package main

import (
    "piko.sh/piko"
    layout "testmodule/partials/layout.pk"
)

type Post struct {
    Title       string
    Description string
    Date        string
    Slug        string
    URL         string
}

type Response struct {
    Posts []Post
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    items, err := piko.GetAllCollectionItems("blog")
    if err != nil {
        return Response{}, piko.Metadata{}, err
    }

    posts := make([]Post, 0, len(items))
    for _, item := range items {
        posts = append(posts, Post{
            Title:       stringField(item, "Title"),
            Description: stringField(item, "Description"),
            Date:        stringField(item, "date"),
            Slug:        stringField(item, "Slug"),
            URL:         stringField(item, "URL"),
        })
    }

    return Response{Posts: posts}, piko.Metadata{
        Title:       "Piko blog",
        Description: "A simple blog built with Piko and markdown collections.",
    }, nil
}

func stringField(item map[string]any, key string) string {
    if value, ok := item[key]; ok {
        if str, ok := value.(string); ok {
            return str
        }
    }
    return ""
}
</script>

<style>
  @import "testmodule/styles/theme.css";

  .page-title {
    font-family: var(--g-font-family-heading);
    color: var(--g-colour-grey-900, #2B333B);
    font-size: 2.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-card {
    display: block;
    text-decoration: none;
    padding: 1.5rem;
    border: 1px solid var(--g-colour-grey-200, #CAD1D8);
    border-radius: var(--g-radius-lg, 20px);
    background: #ffffff;
    box-shadow: 0 4px 0 var(--g-colour-grey-200, #CAD1D8);
    margin-bottom: 4px;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
  }

  .post-card:hover {
    transform: translateY(2px);
    border-color: var(--g-colour-primary-200, #D1C4F9);
    box-shadow: 0 2px 0 var(--g-colour-primary-200, #D1C4F9);
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--g-colour-grey-900, #2B333B);
    margin: 0 0 0.5rem;
    transition: color 0.2s;
  }

  .post-card:hover .post-title {
    color: var(--g-colour-primary-600, #5A39C7);
  }

  .post-description {
    font-size: 0.9375rem;
    color: var(--g-colour-grey-600, #5B6B7B);
    margin: 0 0 0.75rem;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--g-colour-grey-400, #92A1AF);
  }
</style>
