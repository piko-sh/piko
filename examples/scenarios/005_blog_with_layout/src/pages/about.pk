<!-- About page using the shared layout. piko:img renders optimised images;
     for local paths it transforms them to served asset URLs.
     See https://piko.sh/docs/guide/pk-templates -->
<template>
  <div id="app">
    <piko:partial is="blog_layout"
      :server.title="state.Title"
      :server.description="state.Description"
      server.current-page="about"
    >

      <section class="about-intro">
        <p>We are a small team of developers passionate about building tools that make web development simpler and more enjoyable. Piko is our answer to the complexity of modern frontend toolchains.</p>
      </section>

      <section class="team" id="team-section">
        <h2>Our team</h2>
        <div class="team-grid">
          <div class="team-member" p-for="(i, member) in state.Members" p-key="member.Name">
            <piko:img
              :src="member.AvatarURL"
              :alt="member.Name"
              class="member-avatar"
            ></piko:img>
            <h3 class="member-name" p-text="member.Name"></h3>
            <p class="member-role" p-text="member.Role"></p>
          </div>
        </div>
      </section>

      <section class="values">
        <h2>What we believe</h2>
        <div class="value-list">
          <div class="value-item" p-for="(i, value) in state.Values" p-key="value.Title">
            <piko:svg src="@/lib/icons/arrow-right.svg" class="value-icon"></piko:svg>
            <div>
              <h3 p-text="value.Title"></h3>
              <p p-text="value.Body"></p>
            </div>
          </div>
        </div>
      </section>

      <div p-slot="sidebar" class="sidebar-content">
        <div class="sidebar-card">
          <h3>Get involved</h3>
          <p>Piko is open source. Contributions, feedback, and bug reports are always welcome.</p>
          <piko:a href="/contact" class="button">Contact us</piko:a>
        </div>
      </div>

    </piko:partial>
  </div>
</template>

<script type="application/x-go">
package main

import (
  "piko.sh/piko"
  blog_layout "testmodule/partials/layout.pk"
)

type Member struct {
  Name      string
  Role      string
  AvatarURL string
}

type Value struct {
  Title string
  Body  string
}

type Response struct {
  Title       string
  Description string
  Members     []Member
  Values      []Value
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
  return Response{
    Title:       "About us",
    Description: "Meet the team behind Piko and learn what drives us.",
    Members: []Member{
      {
        Name:      "Alice Williams",
        Role:      "Lead developer",
        AvatarURL: "https://placehold.co/120x120/dbeafe/1d4ed8?text=AJ",
      },
      {
        Name:      "Bob Chen",
        Role:      "Core contributor",
        AvatarURL: "https://placehold.co/120x120/d1fae5/065f46?text=BC",
      },
      {
        Name:      "Carol Davies",
        Role:      "Documentation lead",
        AvatarURL: "https://placehold.co/120x120/fef3c7/92400e?text=CD",
      },
    },
    Values: []Value{
      {Title: "Simplicity first", Body: "Every feature should reduce complexity, not add to it."},
      {Title: "Server and client, together", Body: "Server-side rendering by default, client-side interactivity when you need it."},
      {Title: "Go-native", Body: "Built for Go developers who want a productive web framework without leaving the ecosystem."},
    },
  }, piko.Metadata{
    Title:       "About | Piko blog",
    Description: "Meet the team behind the Piko web framework.",
  }, nil
}
</script>

<style>
  @import "testmodule/styles/theme.css";

  #app {
    margin: 0;
    padding: 0;
  }

  .about-intro {
    margin-bottom: 2rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--g-colour-grey-700, #485461);
  }

  .team h2,
  .values h2 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--g-colour-grey-900, #2B333B);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr 1fr;
    }

    .value-list {
      margin: 1.5rem 0;
    }
  }

  @media (max-width: 480px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .team-member {
    text-align: center;
    padding: 1.5rem 1rem;
    border: 1px solid var(--g-colour-grey-100, #E8EBEE);
    border-radius: var(--g-radius-xl, 30px);
    background: #ffffff;
  }

  .member-avatar {
    width: 80px;
    height: 80px;
    border-radius: var(--g-radius-max, 9999px);
    margin-bottom: 0.75rem;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }

  .member-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--g-colour-grey-900, #2B333B);
    margin-bottom: 0.25rem;
  }

  .member-role {
    font-size: 0.8125rem;
    color: var(--g-colour-grey-500, #788A9B);
  }

  .value-list {
    margin: 30px 20px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .value-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .value-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--g-colour-primary-500, #6F47EB);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .value-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--g-colour-grey-900, #2B333B);
    margin-bottom: 0.25rem;
  }

  .value-item p {
    font-size: 0.875rem;
    color: var(--g-colour-grey-500, #788A9B);
    line-height: 1.5;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-card {
    background-color: white;
    padding: 1.5rem;
    border-radius: var(--g-radius-xl, 30px);
    border: 1px solid var(--g-colour-grey-100, #E8EBEE);
  }

  .sidebar-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--g-colour-grey-900, #2B333B);
  }

  .sidebar-card p {
    font-size: 0.875rem;
    color: var(--g-colour-grey-500, #788A9B);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .button {
    --colour-background: var(--g-colour-primary-50);
    --colour-background-hover: var(--g-colour-primary-100);
    --colour-text: var(--g-colour-primary-600);
    --colour-text-hover: var(--g-colour-primary-700);
    --colour-border: var(--g-colour-primary-600);
    --colour-border-hover: var(--g-colour-primary-700);
    --button-shadow-depth: 4px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: var(--g-radius-max, 9999px);
    border: 1px solid var(--colour-border);
    box-shadow: 0 var(--button-shadow-depth) 0 var(--colour-border);
    margin-bottom: var(--button-shadow-depth);
    background-color: var(--colour-background);
    color: var(--colour-text);
    font-size: 1rem;
    font-weight: 500;
    font-family: var(--g-font-family, sans-serif);
    text-decoration: none;
    cursor: pointer;
    transition: box-shadow 0.2s, transform 0.2s, color 0.2s, background-color 0.2s, border-color 0.2s;
  }

  .button:hover {
    transform: translateY(calc(var(--button-shadow-depth) / 2));
    box-shadow: 0 calc(var(--button-shadow-depth) / 2) 0 var(--colour-border-hover);
    background-color: var(--colour-background-hover);
    border-color: var(--colour-border-hover);
    color: var(--colour-text-hover);
  }
</style>
