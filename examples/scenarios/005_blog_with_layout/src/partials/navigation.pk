<!-- Navigation partial. Receives current-page as a prop and uses p-class
     to highlight the active link. piko:a provides SPA-style navigation.
     See https://piko.sh/docs/guide/pk-templates -->
<template>
  <nav class="site-nav">
    <span class="site-name">Piko blog</span>
    <div class="nav-items">
      <piko:a href="/" class="nav-item" p-class="{ 'nav-item--active': props.CurrentPage == 'home' }">Home</piko:a>
      <piko:a href="/blog" class="nav-item" p-class="{ 'nav-item--active': props.CurrentPage == 'blog' }">Blog</piko:a>
      <piko:a href="/about" class="nav-item" p-class="{ 'nav-item--active': props.CurrentPage == 'about' }">About</piko:a>
      <piko:a href="/contact" class="nav-item" p-class="{ 'nav-item--active': props.CurrentPage == 'contact' }">Contact</piko:a>
    </div>
  </nav>
</template>

<script type="application/x-go">
package main

import "piko.sh/piko"

type Props struct {
  CurrentPage string `prop:"current-page"`
}

func Render(r *piko.RequestData, props Props) (piko.NoResponse, piko.Metadata, error) {
  return piko.NoResponse{}, piko.Metadata{}, nil
}
</script>

