    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .task-input {
    flex: 1;
    padding: 0.5rem 1rem;
    border: 1px solid var(--g-colour-grey-200, #CAD1D8);
    border-radius: var(--g-radius-max, 9999px);
    font-family: var(--g-font-family, sans-serif);
    font-size: 0.95rem;
    color: var(--g-colour-grey-800, #364049);
  }

  .button {
