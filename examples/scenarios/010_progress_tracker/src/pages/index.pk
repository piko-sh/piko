    padding: 2rem 1.5rem;
    border-radius: var(--g-radius-xl, 30px);
    font-family: var(--g-font-family, sans-serif);
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(111, 71, 235, 0.07), transparent),
      var(--g-colour-grey-50, #F6F7F8);
    color: var(--g-colour-grey-800, #364049);
  }

  .heading {
    color: var(--g-colour-grey-900, #2B333B);
    font-family: var(--g-font-family-heading, sans-serif);
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .description {
    color: var(--g-colour-grey-500, #788A9B);
    margin-bottom: 1.5rem;
  }

