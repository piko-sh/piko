<!-- Interactive todo list. Demonstrates p-for with p-key for list rendering,
     p-model for two-way input binding, and p-on:click with arguments.
     Piko tracks array mutations (push, filter) and updates only affected DOM nodes.
     See https://piko.sh/docs/guide/client-components -->
<template name="pp-todo-list">
    <div class="todo-app">
        <h2>Todo list</h2>

        <div class="input-row">
            <input
                type="text"
                id="new-item-input"
                p-model="state.newItem"
                p-on:keydown="handleKeydown($event)"
                placeholder="What needs to be done?"
            >
            <button id="add-button" p-on:click="addItem">Add</button>
        </div>

        <p p-if="state.items.length == 0" class="empty-message">No items yet</p>

        <ul class="todo-list">
            <li p-for="(index, item) in state.items" p-key="item.id" class="todo-item">
                <button
                    class="toggle-button"
                    p-class="{ done: item.done }"
                    p-on:click="toggleItem(item.id)"
                >
                    <span p-if="item.done">&#10004;</span>
                    <span p-if="!item.done">&nbsp;</span>
                </button>

                <span class="item-text" p-class="{ completed: item.done }">
                    {{ item.text }}
                </span>

                <button class="delete-button" p-on:click="deleteItem(item.id)">
                    &#10005;
                </button>
            </li>
        </ul>

        <div p-if="state.items.length > 0" class="footer">
            {{ countCompleted() }} of {{ state.items.length }} completed
        </div>

        <p p-if="state.items.length > 0 && countCompleted() == state.items.length" class="all-done">
            All done!
        </p>
    </div>
</template>

<script lang="ts">
    // Reactive state: items is an array of objects tracked by p-key="item.id".
    const state = {
        items: [
            { id: 1 as number, text: "Learn Piko" as string, done: true as boolean },
            { id: 2 as number, text: "Build something" as string, done: false as boolean }
        ],
        newItem: "" as string,
        nextId: 3 as number,
    };

    function addItem() {
        if (state.newItem.trim() === "") {
            return;
        }

        state.items.push({
            id: state.nextId,
            text: state.newItem.trim(),
            done: false,
        });

        state.nextId++;
        state.newItem = "";
    }

    function toggleItem(id) {
        state.items = state.items.map(
            item => item.id === id ? { ...item, done: !item.done } : item
        );
    }

    function deleteItem(id) {
        state.items = state.items.filter(item => item.id !== id);
    }

    function handleKeydown(evt) {
        if (evt.key === "Enter") {
            addItem();
        }
    }

    function countCompleted() {
        return state.items.filter(item => item.done).length;
    }
</script>

<style>
    @import "testmodule/styles/theme.css";

    .todo-app {
        max-width: 480px;
        margin: 0 auto;
        padding: 1.5rem;
        font-family: var(--g-font-family, sans-serif);
        border: 1px solid var(--g-colour-grey-100, #E8EBEE);
        border-radius: var(--g-radius-lg, 20px);
        background: #ffffff;
        color: var(--g-colour-grey-800, #364049);
    }

    h2 {
        margin: 0 0 1rem;
        font-size: 1.25rem;
        font-weight: 500;
        color: var(--g-colour-grey-900, #2B333B);
    }

    .input-row {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .input-row input {
        flex: 1;
        padding: 0.5rem 0.75rem;
        font-size: 0.9375rem;
        font-family: var(--g-font-family, sans-serif);
        color: var(--g-colour-grey-800, #364049);
        border: 1px solid var(--g-colour-grey-200, #CAD1D8);
        border-radius: var(--g-radius-lg, 20px);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .input-row input:focus {
        border-color: var(--g-colour-primary-500, #6F47EB);
        box-shadow: 0 0 0 2px var(--g-colour-primary-100, #E1D9FB);
    }

    .input-row input::placeholder {
        color: var(--g-colour-grey-400, #92A1AF);
    }

    #add-button {
        --colour-background: var(--g-colour-primary-50);
        --colour-background-hover: var(--g-colour-primary-100);
        --colour-text: var(--g-colour-primary-600);
        --colour-text-hover: var(--g-colour-primary-700);
        --colour-border: var(--g-colour-primary-600);
        --colour-border-hover: var(--g-colour-primary-700);
        --button-shadow-depth: 4px;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.5rem 1.25rem;
        border-radius: var(--g-radius-max, 9999px);
        border: 1px solid var(--colour-border);
        box-shadow: 0 var(--button-shadow-depth) 0 var(--colour-border);
        margin-bottom: var(--button-shadow-depth);
        background-color: var(--colour-background);
        color: var(--colour-text);
        font-size: 0.9375rem;
        font-weight: 500;
        font-family: var(--g-font-family, sans-serif);
        white-space: nowrap;
        cursor: pointer;
        transition: box-shadow 0.2s, transform 0.2s, color 0.2s, background-color 0.2s, border-color 0.2s;
    }

    #add-button:hover {
        transform: translateY(calc(var(--button-shadow-depth) / 2));
        box-shadow: 0 calc(var(--button-shadow-depth) / 2) 0 var(--colour-border-hover);
        background-color: var(--colour-background-hover);
        border-color: var(--colour-border-hover);
        color: var(--colour-text-hover);
    }

    #add-button:active {
        transform: translateY(var(--button-shadow-depth));
        box-shadow: 0 0 0 var(--colour-border-hover);
    }

    .empty-message {
        text-align: center;
        color: var(--g-colour-grey-400, #92A1AF);
        font-style: italic;
        padding: 2rem 0;
        margin: 0;
    }

    .todo-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .todo-item {
        display: flex;
        align-items: center;
        text-align: left;
        gap: 0.75rem;
        padding: 0.625rem 0;
        border-bottom: 1px solid var(--g-colour-grey-100, #E8EBEE);
    }

    .todo-item:last-child {
        border-bottom: none;
    }

    .toggle-button {
        width: 1.75rem;
        height: 1.75rem;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        border: 2px solid var(--g-colour-grey-200, #CAD1D8);
        border-radius: 8px;
        background: transparent;
        color: var(--g-colour-grey-200, #CAD1D8);
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .toggle-button.done {
        border-color: var(--g-colour-secondary-700, #39ABA1);
        background-color: var(--g-colour-secondary-700, #39ABA1);
        color: #ffffff;
    }

    .toggle-button:hover {
        border-color: var(--g-colour-secondary-700, #39ABA1);
    }

    .item-text {
        flex: 1;
        font-size: 0.9375rem;
        color: var(--g-colour-grey-800, #364049);
        transition: all 0.15s ease;
    }

    .item-text.completed {
        text-decoration: line-through;
        color: var(--g-colour-grey-400, #92A1AF);
    }

    .delete-button {
        width: 1.75rem;
        height: 1.75rem;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        border: none;
        border-radius: var(--g-radius-sm, 10px);
        background: transparent;
        color: var(--g-colour-grey-300, #ADB8C2);
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .delete-button:hover {
        background-color: var(--g-colour-primary-50, #F1EDFD);
        color: var(--g-colour-primary-600, #5A39C7);
    }

    .footer {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--g-colour-grey-100, #E8EBEE);
        font-size: 0.875rem;
        color: var(--g-colour-grey-500, #788A9B);
    }

    .all-done {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--g-colour-secondary-700, #39ABA1);
    }
</style>
