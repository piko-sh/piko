<!-- Server-rendered partial with client-side interactivity. The Go script
     provides initial state; the TypeScript script listens for 'chat-message'
     events via piko.bus.on() and updates the DOM dynamically. -->
<template>
  <div class="message-log">
    <h3>Messages</h3>
    <div class="message-list" p-ref="message_list">
      <p class="empty-state" p-text="state.EmptyMessage"></p>
    </div>
    <p class="message-count">Total messages sent: <span p-ref="total_count">0</span></p>
  </div>
</template>

<style>
  @import "testmodule/styles/theme.css";

  .message-log {
    max-width: 100%;
    font-family: var(--g-font-family, sans-serif);
    color: var(--g-colour-grey-800, #364049);
  }

  h3 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--g-colour-grey-900, #2B333B);
  }

  .message-list {
    min-height: 100px;
    max-height: 300px;
    overflow-y: auto;
    margin-bottom: 0.75rem;
    padding: 0.5rem;
    background: white;
    border: 1px solid var(--g-colour-grey-100, #E8EBEE);
    border-radius: var(--g-radius-md, 15px);
  }

  .empty-state {
    color: var(--g-colour-grey-400, #92A1AF);
    font-style: italic;
    text-align: center;
    margin: 2rem 0;
  }

  .message {
    padding: 0.375rem 0.5rem;
    margin-bottom: 0.25rem;
    background: var(--g-colour-primary-50, #F1EDFD);
    border-radius: var(--g-radius-xs, 6px);
    font-size: 0.875rem;
    color: var(--g-colour-primary-700, #482CA6);
  }

  .message-count {
    font-size: 0.8125rem;
    color: var(--g-colour-grey-500, #788A9B);
    margin: 0;
  }
</style>

<script type="application/x-go">
package main

import "piko.sh/piko"

type Response struct {
    EmptyMessage string
}

func Render(r *piko.RequestData, props piko.NoProps) (Response, piko.Metadata, error) {
    return Response{
        EmptyMessage: "No messages yet. Try sending one!",
    }, piko.Metadata{}, nil
}
</script>

<!-- Client-side script: listens for events from the chat-input component -->
<script lang="ts">
piko.bus.on('chat-message', (data: { text: string; sender: string; timestamp: number }) => {
    const emptyState = pk.refs.message_list?.querySelector('.empty-state');
    if (emptyState) {
        emptyState.remove();
    }

    const msgEl = document.createElement('div');
    msgEl.className = 'message';
    msgEl.textContent = data.sender + ': ' + data.text;
    pk.refs.message_list?.appendChild(msgEl);

    if (pk.refs.total_count) {
        const current = parseInt(pk.refs.total_count.textContent || '0', 10);
        pk.refs.total_count.textContent = String(current + 1);
    }
});
</script>
