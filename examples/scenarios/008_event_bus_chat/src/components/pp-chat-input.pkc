<!-- Chat input component. Emits 'chat-message' events via piko.bus.emit()
     so any other component or partial on the page can listen and react.
     See https://piko.sh/docs/guide/client-components -->
<template name="pp-chat-input">
    <div class="chat-input-bar">
        <input
            id="message-input"
            type="text"
            p-model="state.message"
            p-on:keydown="handleKeydown"
            placeholder="Type a message..."
        >
        <button id="send-button" p-on:click="sendMessage">Send</button>
    </div>
</template>

<script lang="ts">
    const state = {
        message: '' as string,
    };

    function sendMessage() {
        if (state.message.trim() === '') {
            return;
        }

        piko.bus.emit('chat-message', {
            text: state.message,
            sender: 'User',
            timestamp: Date.now()
        });

        state.message = '';
    }

    function handleKeydown(evt: KeyboardEvent) {
        if (evt.key === 'Enter') {
            sendMessage();
        }
    }
</script>

<style>
    @import "testmodule/styles/theme.css";

    .chat-input-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding-top: 0.75rem;
