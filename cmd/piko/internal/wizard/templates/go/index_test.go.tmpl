package pages

import (
	"testing"

	"piko.sh/piko"

	index "{{ .ModuleName }}/dist/pages/pages_index_032f49b1"
)

func TestIndex_DefaultTitle(t *testing.T) {
	tester := piko.NewComponentTester(t, index.BuildAST)
	req := piko.NewTestRequest("GET", "/").Build(t.Context())
	view := tester.Render(req, piko.NoProps{})

	view.QueryAST(".hero-title").Exists().HasText("Welcome to Piko")
}

func TestIndex_PersonalizedTitle(t *testing.T) {
	tester := piko.NewComponentTester(t, index.BuildAST)
	req := piko.NewTestRequest("GET", "/").
		WithQueryParam("name", "Alice").Build(t.Context())
	view := tester.Render(req, piko.NoProps{})

	view.QueryAST(".hero-title").Exists().HasText("Welcome, Alice")
}

func TestIndex_HeroStructure(t *testing.T) {
	tester := piko.NewComponentTester(t, index.BuildAST)
	req := piko.NewTestRequest("GET", "/").Build(t.Context())
	view := tester.Render(req, piko.NoProps{})

	view.QueryAST(".hero-badge").Exists()
	view.QueryAST(".hero-subtitle").Exists().ContainsText("Go web framework")
	view.QueryAST(".button-primary").Exists().ContainsText("Get started")
	view.QueryAST(".button-secondary").Exists().ContainsText("Documentation")
}
