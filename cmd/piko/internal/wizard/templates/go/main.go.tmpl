package main

import (
	"fmt"
	"os"

	"{{ .ModuleName }}/internal"
	"piko.sh/piko"
	"piko.sh/piko/wdk/logger"

{{- if .EnableInterpreted }}
	"{{ .ModuleName }}/internal/piko_symbols"
	"piko.sh/piko/wdk/interp/interp_provider_pipit"
{{- end }}
	_ "{{ .ModuleName }}/dist"
)

// Version is the release identity stamped into the binary at build time via
// -ldflags "-X main.Version=...".
var Version string

func main() {
	logger.AddPrettyOutput() // Uses LOG_LEVEL env var, defaults to INFO

	command := internal.RunModeDev
	if len(os.Args) > 1 {
		command = os.Args[1]
	}

	var extras []internal.Option
	if Version != "" {
		extras = append(extras, piko.WithReleaseID(Version))
	}

	ssr := internal.NewServer(command, extras...)

{{- if .EnableInterpreted }}

	// You can optionally define your symbols for interpreted mode.
	// This is required for interpreted mode.
	ssr.WithInterpreterProvider(interp_provider_pipit.NewProvider())
	ssr.WithSymbols(piko_symbols.Symbols)
{{- end }}

	// You can add your own chi middleware and routes here.
	// ssr.AppRouter.Use(...)
	// ssr.AppRouter.Get(...)

	if err := ssr.Run(command); err != nil {
		fmt.Fprintf(os.Stderr, "piko: %v\n", err)
		os.Exit(1)
	}
}
