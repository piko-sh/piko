  <piko:partial is="layout" :server.page_title="state.Title">

    <!-- Hero -->
    <section class="hero">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Your app is running
      </div>
      <h1 class="hero-title">{{ "{{ state.Title }}" }}</h1>
      <p class="hero-subtitle">{{ "{{ state.Subtitle }}" }}</p>
      <div class="hero-actions">
        <a href="https://piko.sh/docs/get-started/introduction" target="_blank" rel="noopener" class="button button-primary">
          Get started
        </a>
        <a href="https://piko.sh/docs" target="_blank" rel="noopener" class="button button-secondary">
          Documentation
        </a>
      </div>
    </section>

    <section class="code-preview">
      <h2 class="section-title">What you'll be writing</h2>
      <p class="section-subtitle">A single <code>.pk</code> file contains your template, styles, and type-safe Go logic.</p>
      <piko:partial is="codeWindow" server.filename="pages/hello.pk"></piko:partial>
