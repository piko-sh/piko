        <piko:svg src="@/lib/icons/piko-logo-inline.svg" class="brand-logo" aria-hidden="true"></piko:svg>
      </a>
      <nav class="main-nav">
        <a href="https://piko.sh/docs" target="_blank" rel="noopener" class="nav-item">Documents</a>
        <a href="https://github.com/piko-sh/piko" target="_blank" rel="noopener" class="nav-item">GitHub</a>
      </nav>
    </div>
  </header>

  <main>
    <piko:slot></piko:slot>
  </main>

  <footer class="site-footer">
    <div class="footer-container">
      <p>Built with <a href="https://piko.sh">Piko</a> | {{ "{{ state.CurrentYear }}" }}</p>
    </div>
  </footer>
</template>

<script type="application/x-go">
package main

import (
    "time"
    "piko.sh/piko"
)

// Props received from the page that uses this layout.
type Props struct {
    PageTitle string `prop:"page_title"`
}

// Response is available as "state" in the template above.
type Response struct {
    PageTitle   string
    CurrentYear int
}

func Render(r *piko.RequestData, props Props) (Response, piko.Metadata, error) {
    title := "{{ .ProjectName }}"
    if props.PageTitle != "" {
        title = props.PageTitle + " | {{ .ProjectName }}"
    }

    metadata := piko.Metadata{
        Title: title,
    }

    return Response{
        PageTitle:   title,
        CurrentYear: time.Now().Year(),
    }, metadata, nil
}
</script>

