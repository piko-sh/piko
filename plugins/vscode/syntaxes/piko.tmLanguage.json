{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Piko",
  "scopeName": "source.piko",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#script-block"
    },
    {
      "include": "#template-block"
    },
    {
      "include": "#timeline-block"
    },
    {
      "include": "#style-block"
    },
    {
      "include": "#i18n-block"
    }
  ],
  "repository": {
    "script-block": {
      "patterns": [
        {
          "comment": "Go script block: type is application/x-go or application/go, or lang is go, golang, application/x-go or application/go (any attribute order).",
          "name": "meta.block.script.piko",
          "begin": "(<)(script)\\b(?=[^>]*\\b(?:type\\s*=\\s*[\"']?(?:application/x-go|application/go)|lang\\s*=\\s*[\"']?(?:go|golang|application/x-go|application/go))[\"'\\s/>])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.script.piko"
            }
          },
          "end": "(</)(script)\\s*(>)|(/>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.script.piko"
            },
            "3": {
              "name": "punctuation.definition.tag.end.piko"
            },
            "4": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "patterns": [
            {
              "begin": "(>)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.end.piko"
                }
              },
              "end": "(?=</script\\s*>)",
              "contentName": "meta.embedded.block.go source.go",
              "patterns": [
                {
                  "include": "source.go"
                }
              ]
            },
            {
              "include": "#tag-attributes"
            }
          ]
        },
        {
          "comment": "TypeScript script block: lang is ts or typescript, or type is application/typescript.",
          "name": "meta.block.script.piko",
          "begin": "(<)(script)\\b(?=[^>]*\\b(?:lang\\s*=\\s*[\"']?(?:ts|typescript)|type\\s*=\\s*[\"']?(?i:application/typescript))[\"'\\s/>])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.script.piko"
            }
          },
          "end": "(</)(script)\\s*(>)|(/>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.script.piko"
            },
            "3": {
              "name": "punctuation.definition.tag.end.piko"
            },
            "4": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "patterns": [
            {
              "begin": "(>)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.end.piko"
                }
              },
              "end": "(?=</script\\s*>)",
              "contentName": "meta.embedded.block.typescript source.ts",
              "patterns": [
                {
                  "include": "source.ts"
                }
              ]
            },
            {
              "include": "#tag-attributes"
            }
          ]
        },
        {
          "comment": "Any other script block is JavaScript.",
          "name": "meta.block.script.piko",
          "begin": "(<)(script)\\b",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.script.piko"
            }
          },
          "end": "(</)(script)\\s*(>)|(/>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.script.piko"
            },
            "3": {
              "name": "punctuation.definition.tag.end.piko"
            },
            "4": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "patterns": [
            {
              "begin": "(>)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.end.piko"
                }
              },
              "end": "(?=</script\\s*>)",
              "contentName": "meta.embedded.block.javascript source.js",
              "patterns": [
                {
                  "include": "source.js"
                }
              ]
            },
            {
              "include": "#tag-attributes"
            }
          ]
        }
      ]
    },
    "style-block": {
      "comment": "Style block with any attributes.",
      "name": "meta.block.style.piko",
      "begin": "(<)(style)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.piko"
        },
        "2": {
          "name": "entity.name.tag.style.piko"
        }
      },
      "end": "(</)(style)\\s*(>)|(/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.piko"
        },
        "2": {
          "name": "entity.name.tag.style.piko"
        },
        "3": {
          "name": "punctuation.definition.tag.end.piko"
        },
        "4": {
          "name": "punctuation.definition.tag.end.piko"
        }
      },
      "patterns": [
        {
          "begin": "(>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "end": "(?=</style\\s*>)",
          "contentName": "meta.embedded.block.css source.css",
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        },
        {
          "include": "#tag-attributes"
        }
      ]
    },
    "i18n-block": {
      "patterns": [
        {
          "comment": "YAML i18n block: lang is yaml or yml.",
          "name": "meta.block.i18n.piko",
          "begin": "(<)(i18n)\\b(?=[^>]*\\blang\\s*=\\s*[\"']?(?:yaml|yml)[\"'\\s/>])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.i18n.piko"
            }
          },
          "end": "(</)(i18n)\\s*(>)|(/>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.i18n.piko"
            },
            "3": {
              "name": "punctuation.definition.tag.end.piko"
            },
            "4": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "patterns": [
            {
              "begin": "(>)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.end.piko"
                }
              },
              "end": "(?=</i18n\\s*>)",
              "contentName": "meta.embedded.block.yaml source.yaml",
              "patterns": [
                {
                  "include": "source.yaml"
                }
              ]
            },
            {
              "include": "#tag-attributes"
            }
          ]
        },
        {
          "comment": "JSON i18n block (the default).",
          "name": "meta.block.i18n.piko",
          "begin": "(<)(i18n)\\b",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.i18n.piko"
            }
          },
          "end": "(</)(i18n)\\s*(>)|(/>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "entity.name.tag.i18n.piko"
            },
            "3": {
              "name": "punctuation.definition.tag.end.piko"
            },
            "4": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "patterns": [
            {
              "begin": "(>)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.end.piko"
                }
              },
              "end": "(?=</i18n\\s*>)",
              "contentName": "meta.embedded.block.json source.json",
              "patterns": [
                {
                  "include": "source.json"
                }
              ]
            },
            {
              "include": "#tag-attributes"
            }
          ]
        }
      ]
    },
    "template-block": {
      "comment": "Top-level template block with any attributes (name, public, p-collection, ...). Nested templates are tracked by #template-nested so the block ends at its own closing tag.",
      "name": "meta.block.template.piko",
      "begin": "(<)(template)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.piko"
        },
        "2": {
          "name": "entity.name.tag.template.piko"
        }
      },
      "end": "(</)(template)\\s*(>)|(/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.piko"
        },
        "2": {
          "name": "entity.name.tag.template.piko"
        },
        "3": {
          "name": "punctuation.definition.tag.end.piko"
        },
        "4": {
          "name": "punctuation.definition.tag.end.piko"
        }
      },
      "patterns": [
        {
          "begin": "(>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "end": "(?=</template\\s*>)",
          "contentName": "text.html.piko",
          "patterns": [
            {
              "include": "#template-content"
            }
          ]
        },
        {
          "include": "#tag-attributes"
        }
      ]
    },
    "timeline-block": {
      "comment": "Top-level piko:timeline block.",
      "name": "meta.block.timeline.piko",
      "begin": "(<)(piko:timeline)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.piko"
        },
        "2": {
          "name": "entity.name.tag.piko-timeline.piko"
        }
      },
      "end": "(</)(piko:timeline)\\s*(>)|(/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.piko"
        },
        "2": {
          "name": "entity.name.tag.piko-timeline.piko"
        },
        "3": {
          "name": "punctuation.definition.tag.end.piko"
        },
        "4": {
          "name": "punctuation.definition.tag.end.piko"
        }
      },
      "patterns": [
        {
          "begin": "(>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "end": "(?=</piko:timeline\\s*>)",
          "contentName": "text.html.piko",
          "patterns": [
            {
              "include": "#template-content"
            }
          ]
        },
        {
          "include": "#tag-attributes"
        }
      ]
    },
    "template-nested": {
      "comment": "A <template> nested inside template content (for example <template p-for>). Matching it as its own region keeps the depth, so its closing tag does not end the outer block.",
      "name": "meta.tag.template.nested.piko",
      "begin": "(<)(template)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.template.html"
        }
      },
      "end": "(</)(template)\\s*(>)|(/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.template.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "begin": "(>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.html"
            }
          },
          "end": "(?=</template\\s*>)",
          "patterns": [
            {
              "include": "#template-content"
            }
          ]
        },
        {
          "include": "#tag-attributes"
        }
      ]
    },
    "template-content": {
      "patterns": [
        {
          "include": "#template-nested"
        },
        {
          "include": "#piko-special-tags"
        },
        {
          "include": "#piko-interpolation"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "tag-attributes": {
      "patterns": [
        {
          "include": "#piko-bound-attributes"
        },
        {
          "include": "#piko-directives"
        },
        {
          "comment": "Any other attribute, quoted or unquoted.",
          "match": "([^\\s\"'<>/=]+)(?:\\s*(=)\\s*(?:(\")([^\"]*)(\")|(')([^']*)(')|([^\\s\"'=<>`]+)))?",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            },
            "4": {
              "name": "string.quoted.double.piko"
            },
            "5": {
              "name": "punctuation.definition.string.end.piko"
            },
            "6": {
              "name": "punctuation.definition.string.begin.piko"
            },
            "7": {
              "name": "string.quoted.single.piko"
            },
            "8": {
              "name": "punctuation.definition.string.end.piko"
            },
            "9": {
              "name": "string.unquoted.piko"
            }
          }
        }
      ]
    },
    "piko-directives": {
      "patterns": [
        {
          "comment": "Directives with arguments and modifiers: p-bind:attr, p-on:click.prevent",
          "name": "keyword.control.directive.piko",
          "match": "\\bp-(bind|on|event):[a-zA-Z][a-zA-Z0-9-]*(?:\\.[a-zA-Z]+)*\\b"
        },
        {
          "comment": "Control flow directives: p-if, p-else-if, p-else, p-for, p-show",
          "name": "keyword.control.directive.piko",
          "match": "\\bp-(if|else-if|else|for|show)\\b"
        },
        {
          "comment": "Data binding directives: p-text, p-html, p-model",
          "name": "keyword.control.directive.piko",
          "match": "\\bp-(text|html|model)\\b"
        },
        {
          "comment": "Styling directives: p-class, p-style",
          "name": "keyword.control.directive.piko",
          "match": "\\bp-(class|style)\\b"
        },
        {
          "comment": "Identity and reference directives: p-ref, p-slot, p-key, p-context",
          "name": "keyword.control.directive.piko",
          "match": "\\bp-(ref|slot|key|context)\\b"
        },
        {
          "comment": "Special directives: p-scaffold, p-memo, p-timeline, p-collection, p-provider, p-fragment",
          "name": "keyword.control.directive.piko",
          "match": "\\bp-(scaffold|memo|timeline|collection|provider|fragment)\\b"
        },
        {
          "comment": "Shorthand bind: :attr",
          "name": "keyword.control.directive.piko",
          "match": ":[a-zA-Z_][a-zA-Z0-9._-]*"
        },
        {
          "comment": "Shorthand event: @click, @click.prevent",
          "name": "keyword.control.directive.piko",
          "match": "@[a-zA-Z][a-zA-Z0-9-]*(?:\\.[a-zA-Z]+)*"
        }
      ]
    },
    "piko-bound-attributes": {
      "patterns": [
        {
          "comment": "Static string directives with double quotes: p-ref=\"name\", p-slot=\"name\"",
          "match": "(p-(?:ref|slot))(=)(\")((?:[^\"])*)(\")",
          "captures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            },
            "4": {
              "name": "string.quoted.double.piko"
            },
            "5": {
              "name": "punctuation.definition.string.end.piko"
            }
          }
        },
        {
          "comment": "Static string directives with single quotes: p-ref='name', p-slot='name'",
          "match": "(p-(?:ref|slot))(=)(')((?:[^'])*)(')",
          "captures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            },
            "4": {
              "name": "string.quoted.single.piko"
            },
            "5": {
              "name": "punctuation.definition.string.end.piko"
            }
          }
        },
        {
          "comment": "Directive with argument and double quotes: p-bind:href=\"expr\", p-on:click.prevent=\"expr\"",
          "begin": "(p-(?:bind|on|event):[a-zA-Z][a-zA-Z0-9-]*(?:\\.[a-zA-Z]+)*)(=)(\")",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            }
          },
          "end": "(\")",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.piko"
            }
          },
          "contentName": "meta.embedded.expression.piko",
          "patterns": [
            {
              "include": "#go-expression"
            }
          ]
        },
        {
          "comment": "Simple directive with double quotes: p-if=\"expr\", p-for=\"expr\"",
          "begin": "(p-(?:if|else-if|else|for|show|text|html|model|class|style|key|context|scaffold|memo|timeline|collection|provider|fragment))(=)(\")",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            }
          },
          "end": "(\")",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.piko"
            }
          },
          "contentName": "meta.embedded.expression.piko",
          "patterns": [
            {
              "include": "#go-expression"
            }
          ]
        },
        {
          "comment": "Bound attribute shorthand with double quotes: :attr=\"expression\"",
          "begin": "(:[a-zA-Z_][a-zA-Z0-9._-]*)(=)(\")",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            }
          },
          "end": "(\")",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.piko"
            }
          },
          "contentName": "meta.embedded.expression.piko",
          "patterns": [
            {
              "include": "#go-expression"
            }
          ]
        },
        {
          "comment": "Event shorthand with double quotes: @click=\"handler\"",
          "begin": "(@[a-zA-Z][a-zA-Z0-9-]*(?:\\.[a-zA-Z]+)*)(=)(\")",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            }
          },
          "end": "(\")",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.piko"
            }
          },
          "contentName": "meta.embedded.expression.piko",
          "patterns": [
            {
              "include": "#go-expression"
            }
          ]
        },
        {
          "comment": "Directive with argument and single quotes: p-bind:href='expr'",
          "begin": "(p-(?:bind|on|event):[a-zA-Z][a-zA-Z0-9-]*(?:\\.[a-zA-Z]+)*)(=)(')",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            }
          },
          "end": "(')",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.piko"
            }
          },
          "contentName": "meta.embedded.expression.piko",
          "patterns": [
            {
              "include": "#go-expression"
            }
          ]
        },
        {
          "comment": "Simple directive with single quotes: p-if='expr'",
          "begin": "(p-(?:if|else-if|else|for|show|text|html|model|class|style|key|context|scaffold|memo|timeline|collection|provider|fragment))(=)(')",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            }
          },
          "end": "(')",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.piko"
            }
          },
          "contentName": "meta.embedded.expression.piko",
          "patterns": [
            {
              "include": "#go-expression"
            }
          ]
        },
        {
          "comment": "Bound attribute shorthand with single quotes: :attr='expression'",
          "begin": "(:[a-zA-Z_][a-zA-Z0-9._-]*)(=)(')",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            }
          },
          "end": "(')",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.piko"
            }
          },
          "contentName": "meta.embedded.expression.piko",
          "patterns": [
            {
              "include": "#go-expression"
            }
          ]
        },
        {
          "comment": "Event shorthand with single quotes: @click='handler'",
          "begin": "(@[a-zA-Z][a-zA-Z0-9-]*(?:\\.[a-zA-Z]+)*)(=)(')",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.piko"
            },
            "2": {
              "name": "punctuation.separator.key-value.piko"
            },
            "3": {
              "name": "punctuation.definition.string.begin.piko"
            }
          },
          "end": "(')",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.piko"
            }
          },
          "contentName": "meta.embedded.expression.piko",
          "patterns": [
            {
              "include": "#go-expression"
            }
          ]
        }
      ]
    },
    "piko-special-tags": {
      "patterns": [
        {
          "comment": "Opening tag for piko:* namespaced components",
          "name": "meta.tag.piko-component.piko",
          "begin": "(<)(piko:[a-zA-Z][a-zA-Z0-9-]*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "support.class.component.piko"
            }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.piko"
            }
          },
          "patterns": [
            {
              "include": "#tag-attributes"
            }
          ]
        },
        {
          "comment": "Closing tag for piko:* namespaced components",
          "match": "(</)(piko:[a-zA-Z][a-zA-Z0-9-]*)\\s*(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.piko"
            },
            "2": {
              "name": "support.class.component.piko"
            },
            "3": {
              "name": "punctuation.definition.tag.end.piko"
            }
          }
        }
      ]
    },
    "piko-interpolation": {
      "name": "meta.embedded.expression.piko",
      "begin": "(\\{\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.piko"
        }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.end.piko"
        }
      },
      "patterns": [
        {
          "include": "#go-expression"
        }
      ]
    },
    "go-expression": {
      "patterns": [
        {
          "name": "constant.language.boolean.piko",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "constant.numeric.piko",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "string.quoted.double.piko",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.piko",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.piko",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.piko",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.piko",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "include": "#template-literal-interpolation"
            }
          ]
        },
        {
          "name": "keyword.operator.comparison.piko",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.piko",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.piko",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.accessor.piko",
          "match": "\\."
        },
        {
          "name": "punctuation.paren.open.piko",
          "match": "\\("
        },
        {
          "name": "punctuation.paren.close.piko",
          "match": "\\)"
        },
        {
          "name": "punctuation.bracket.open.piko",
          "match": "\\["
        },
        {
          "name": "punctuation.bracket.close.piko",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.piko",
          "match": ","
        },
        {
          "comment": "Template context variables",
          "name": "variable.language.piko",
          "match": "\\b(props|state|partial)\\b"
        },
        {
          "comment": "Built-in Go functions",
          "name": "support.function.builtin.piko",
          "match": "\\b(len|cap|make|new|append|copy|delete|panic|recover|print|println)\\b"
        },
        {
          "comment": "Function/method call",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.piko"
            }
          }
        },
        {
          "name": "variable.other.piko",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "template-literal-interpolation": {
      "comment": "Interpolation inside backtick strings: ${expression}",
      "begin": "(\\$\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.piko"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.template-expression.end.piko"
        }
      },
      "patterns": [
        {
          "include": "#go-expression"
        }
      ]
    },
    "comment": {
      "name": "comment.block.html.piko",
      "begin": "<!--",
      "end": "-->",
      "captures": {
        "0": {
          "name": "punctuation.definition.comment.piko"
        }
      }
    }
  }
}
