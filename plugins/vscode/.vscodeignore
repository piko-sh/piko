# Source files (we only need compiled output)
src/**
tsconfig.json
esbuild.js
eslint.config.mjs
vitest.config.ts
.jscpd.json

# Development files
.vscode-test/**
.vscode/**
launch.json
.gitignore
test/**
test-workspace/**
coverage/**

# Build artefacts
**/*.map
**/*.ts
*.vsix

# Stray files at the root of bin/ (only bin/<os>-<arch>/ directories ship)
bin/*
!bin/*-*/

# Node modules (bundled by esbuild, no need to include)
node_modules/**

# Documentation for development (README.md and CHANGELOG.md ship)
*.md
!README.md
!CHANGELOG.md

# Git files
.git/**
.github/**

# Editor files
.DS_Store
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/**
temp/**
